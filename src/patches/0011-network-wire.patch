+                                 network::afeye::NowNs(), "req-body",
+                                 reinterpret_cast<const uint8_t*>(chunk.data()),
+                                 static_cast<uint32_t>(chunk.size()));
+      }
+      char body_sum[64];
+      std::snprintf(body_sum, sizeof(body_sum), "req-body-total=%llu",
+                    static_cast<unsigned long long>(total_body));
+      network::afeye::EmitStr(network::afeye::kNetReq,
+                              network::afeye::NowNs(), body_sum);
+    }
+  }
+#endif
   DCHECK(!has_backend_request_timer_);
