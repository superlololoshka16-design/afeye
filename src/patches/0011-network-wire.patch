@@ -2479,6 +2482,43 @@ void URLLoader::StartRequest() {
 
   backend_request_timer_ = nullptr;
   has_backend_request_timer_ = false;
+#ifdef NET_AFEYE
+  if (network::afeye::Enabled() && request_.url.is_valid()) {
+    network::afeye::EmitTwoStr(network::afeye::kNetReq,
