+#ifdef V8_AFEYE
+void WasmMemoryObject::AfeyeDumpMemory(const char* tag) {
+  if (!v8::afeye::Enabled()) return;
+  uint32_t pages = static_cast<uint32_t>(array_buffer()->byte_length() /
+                                         wasm::kWasmPageSize);
+  size_t lt = std::strlen(tag);
+  if (lt > 24) lt = 24;
+  uint8_t rec[32];
+  std::memcpy(rec, tag, lt);
+  rec[lt] = 0;
+  std::memcpy(rec + lt + 1, &pages, sizeof(pages));
+  v8::afeye::Emit(v8::afeye::kWasmMemory, v8::afeye::NowNs(), rec,
+                  static_cast<uint32_t>(lt + 1 + sizeof(pages)));
+}
+#endif
