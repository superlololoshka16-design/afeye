 namespace {
 
+#ifdef V8_AFEYE
+// afeye 0002: raw source text of every embedder-initiated compile - page
+// scripts, workers, modules, streaming - dumped BEFORE parse, exactly as
+// handed to the engine. Dynamic compilation (eval / Function constructor)
+// is covered by 0013 in compiler.cc: GetFunctionFromEval.
+void AfeyeDumpSource(const char* origin_kind, Local<String> source_text,
+                     Local<Value> resource_name) {
+  if (!v8::afeye::Enabled() || !v8_flags.afeye_source) return;
+  if (source_text.IsEmpty()) return;
+  Isolate* isolate = Isolate::GetCurrent();
+  String::Utf8Value utf8(isolate, source_text);
+  if (*utf8 == nullptr) return;
+  String::Utf8Value name(isolate, resource_name);
+  v8::afeye::EmitTwoStr(v8::afeye::kScriptSource, v8::afeye::NowNs(),
+                        *name != nullptr ? *name : origin_kind, *utf8);
+}
+#endif
