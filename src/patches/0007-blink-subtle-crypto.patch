   // afeye hook goes immediately before the return, so the view is already
   // filled with the random bytes the page will consume.
+#ifdef BLINK_AFEYE
+  // afeye: emit the generated random material AFTER the fill: anti-fraud
+  // schemes derive nonces and keystream seeds from getRandomValues; having
