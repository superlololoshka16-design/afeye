+#ifdef BLINK_AFEYE
+namespace {
+
+constexpr uint64_t kAfeyeAnalyserCap = 2000000;
+std::atomic<uint64_t> g_afeye_analyser{0};
+
+void AfeyeEmitAnalyserSpan(const char* tag, DOMUint8Array* array) {
+  if (!array) return;
+  size_t len = array->length();
+  if (len == 0) return;
+  blink::afeye::EmitSpan(blink::afeye::kFingerprint, blink::afeye::NowNs(),
+                         tag,
+                         static_cast<const uint8_t*>(
+                             array->BaseAddressMaybeShared()),
+                         static_cast<uint32_t>(len));
+}
+
+void AfeyeEmitAnalyserSpanF32(const char* tag, DOMFloat32Array* array) {
+  if (!array) return;
+  size_t len = array->length();
+  if (len == 0) return;
+  blink::afeye::EmitSpan(
+      blink::afeye::kFingerprint, blink::afeye::NowNs(), tag,
+      reinterpret_cast<const uint8_t*>(array->BaseAddressMaybeShared()),
+      static_cast<uint32_t>(len * sizeof(float)));
+}
+
+}
+#endif
+
 void AnalyserNode::getFloatFrequencyData(NotShared<DOMFloat32Array> array) {
   GetAnalyserHandler().GetFloatFrequencyData(array.Get(),
                                              context()->currentTime());
+#ifdef BLINK_AFEYE
+  if (blink::afeye::Enabled() &&
+      blink::afeye::AfeyeCapConsume(&g_afeye_analyser, kAfeyeAnalyserCap,
+                                    "analyser")) {
+    AfeyeEmitAnalyserSpanF32("audio/float-frequency", array.Get());
+  }
+#endif
 }
 
