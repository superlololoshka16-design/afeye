--- a/v8/src/objects/js-objects.cc
+++ b/v8/src/objects/js-objects.cc
@@ -1991,6 +1991,43 @@ Maybe<bool> JSReceiver::GetOwnPropertyDescriptor(LookupIterator* it,
   Isolate* isolate = it->isolate();
   // "Virtual" dispatch.
   if (it->IsFound() && IsJSProxy(*it->GetHolder<JSReceiver>())) {
+#ifdef V8_AFEYE
+    if (v8::afeye::Enabled()) {
+      static std::atomic<uint64_t> g_afeye_gopd_proxy{0};
+      static bool g_afeye_gopd_off = []() {
+        const char* v = ::getenv("AFEYE_TRACE_GOPD");
+        return v != nullptr && *v != 0 && v[0] == '0';
+      }();
+      if (!g_afeye_gopd_off &&
+          v8::afeye::AfeyeCapConsume(&g_afeye_gopd_proxy, 2000000,
+                                     "gopd-proxy")) {
+        char afeye_key[65] = {0};
+        {
+          DisallowGarbageCollection afeye_no_gc;
+          DirectHandle<Name> afeye_name = it->GetName();
+          if (IsString(*afeye_name)) {
+            String::FlatContent afeye_flat =
+                Cast<String>(*afeye_name)->GetFlatContent(afeye_no_gc);
+            if (afeye_flat.IsFlat() && afeye_flat.IsOneByte()) {
+              uint32_t afeye_l = afeye_flat.length();
+              if (afeye_l > 64) afeye_l = 64;
+              const uint8_t* afeye_p = afeye_flat.ToOneByteVector().begin();
+              for (uint32_t i = 0; i < afeye_l; ++i) {
+                uint8_t c = afeye_p[i];
+                afeye_key[i] =
+                    (c >= 0x20 && c < 0x7f) ? static_cast<char>(c) : '?';
+              }
+            }
+          }
+        }
+        char afeye_buf[128];
+        std::snprintf(afeye_buf, sizeof(afeye_buf),
+                      "gopd holder=proxy key=%s", afeye_key);
+        v8::afeye::EmitStr(v8::afeye::kFingerprint, v8::afeye::NowNs(),
+                           afeye_buf);
+      }
+    }
+#endif
     return JSProxy::GetOwnPropertyDescriptor(isolate, it->GetHolder<JSProxy>(),
                                              it->GetName(), desc);
   }
