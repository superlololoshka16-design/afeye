 #include "src/wasm/wasm-objects.h"
 
+#ifdef V8_AFEYE
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include "src/afeye/sink.h"
+#endif
+
+#ifdef V8_AFEYE
+// v12.2: the wasm linear-memory boundary - every grow event. PoW-style
+// wasm antifraud (Kasada) allocates/grows in deterministic bursts; the
+// pattern is now a record (kind 31). Memory CONTENTS stay a black box:
+// per-access capture needs CSA hooks that do not exist (honest limit).
+// All three Grow exits share this helper.
+namespace v8 {
+namespace afeye {
+void EmitWasmMemGrow(size_t old_pages, size_t new_pages) {
+  static std::atomic<uint64_t> g_afeye_wmem{0};
+  static bool g_afeye_wmem_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMMEM");
+    return v != nullptr && *v != 0 && v[0] == '0';
+  }();
+  if (g_afeye_wmem_off) return;
+  if (g_afeye_wmem.fetch_add(1, std::memory_order_relaxed) >= 100000)
+    return;
+  char afeye_buf[128];
+  std::snprintf(afeye_buf, sizeof(afeye_buf),
+                "wasm-mem grow old=%u new=%u",
+                static_cast<unsigned>(old_pages),
+                static_cast<unsigned>(new_pages));
+  v8::afeye::EmitStr(v8::afeye::kWasmInstance, v8::afeye::NowNs(),
+                     afeye_buf);
+}
+}  // namespace afeye
+}  // namespace v8
+#endif
