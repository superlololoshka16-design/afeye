+          String::FlatContent afeye_fc =
+              Cast<String>(afeye_raw_name)->GetFlatContent(no_gc);
+          if (afeye_fc.IsFlat() && afeye_fc.IsOneByte()) {
+            uint32_t afeye_sl = afeye_fc.length();
+            if (afeye_sl > 96) afeye_sl = 96;
+            const uint8_t* afeye_sp = afeye_fc.ToOneByteVector().begin();
+            for (uint32_t i = 0; i < afeye_sl; ++i) {
+              uint8_t c = afeye_sp[i];
+              afeye_script[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '?';
+            }
+            afeye_script[afeye_sl] = 0;
+          }
+        }
+        afeye_line = afeye_s->GetLineNumber(shared->StartPosition());
+      }
+      char afeye_buf[256];
+      std::snprintf(afeye_buf, sizeof(afeye_buf),
+                    "exec %s %s script=%s:%d len=%u", afeye_t, afeye_fn,
+                    afeye_script, afeye_line,
+                    static_cast<unsigned>(event.code_len));
+      v8::afeye::EmitStr(v8::afeye::kIsolateBirth,
+                         v8::afeye::NowNs(), afeye_buf);
+    }
+  }
+#endif
   code_event_handler_(&event);
 }
 
diff --git a/v8/src/objects/js-objects.cc b/v8/src/objects/js-objects.cc
