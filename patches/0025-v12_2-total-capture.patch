@@ -878,6 +886,73 @@ void JitLogger::LogRecordedBuffer(
   event.name.str = name;
   event.name.len = length;
   event.isolate = reinterpret_cast<v8::Isolate*>(isolate_);
+#ifdef V8_AFEYE
+  // v12.3: the REAL execution-coverage funnel. The 0025 api.cc handler
+  // only carried the function NAME - no script, no chain join. This is
+  // where the Tagged<> objects live: the same no-alloc read as 0003
+  // (GetFlatContent under the DisallowGC this function already holds,
+  // stack scratch, EmitStr). Every compile - bytecode, baseline,
+  // turbofan - crosses here with its SFI: 'exec <type> <fn>
+  // script=<name>:<line> len=N'. 4M cap, AFEYE_TRACE_EXEC=0 off.
+  if (v8::afeye::Enabled()) {
+    static bool g_afeye_exec_off = []() {
+      const char* v = ::getenv("AFEYE_TRACE_EXEC");
+      return v != nullptr && *v != 0 && v[0] == '0';
+    }();
+    static std::atomic<uint64_t> g_afeye_exec{0};
+    if (!g_afeye_exec_off &&
+        g_afeye_exec.fetch_add(1, std::memory_order_relaxed) < 4000000) {
+      const char* afeye_t = IsCode(code) ? "jit" : "byte";
+      char afeye_fn[96];
+      size_t afeye_fnl = length > 80 ? 80 : length;
+      for (size_t i = 0; i < afeye_fnl; ++i) {
+        char c = name[i];
+        afeye_fn[i] = (c >= 0x20 && c < 0x7f) ? c : '?';
+      }
+      afeye_fn[afeye_fnl] = 0;
+      char afeye_script[112];
+      int afeye_line = 0;
+      afeye_script[0] = 0;
+      // v12.4 (N1): JitLogger can be invoked from BACKGROUND compile
+      // threads (wasm tier-up). Raw Tagged<> heap reads without a
+      // safepoint chase a moving GC into stale pointers - silently
+      // corrupt names, worst case a crash inside the cage. The extern
+      // name/length above are plain C data (safe anywhere); the
+      // script/line enrichment below reads the HEAP and is only valid
+      // when this thread is the isolate's main thread. Everyone else
+      // gets the name-only record - honest, not garbage.
+      bool afeye_main = v8::internal::IsMainThread(0) &&
+                        reinterpret_cast<uintptr_t>(isolate_) != 0;
+      if (afeye_main && maybe_shared.ToHandle(&shared) &&
+          IsScript(shared->script())) {
+        Tagged<Script> afeye_s = Cast<Script>(shared->script());
+        Tagged<Object> afeye_raw_name = afeye_s->name();
+        if (IsString(afeye_raw_name)) {
+          String::FlatContent afeye_fc =
+              Cast<String>(afeye_raw_name)->GetFlatContent(no_gc);
+          if (afeye_fc.IsFlat() && afeye_fc.IsOneByte()) {
+            uint32_t afeye_sl = afeye_fc.length();
+            if (afeye_sl > 96) afeye_sl = 96;
+            const uint8_t* afeye_sp = afeye_fc.ToOneByteVector().begin();
+            for (uint32_t i = 0; i < afeye_sl; ++i) {
+              uint8_t c = afeye_sp[i];
+              afeye_script[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '?';
+            }
+            afeye_script[afeye_sl] = 0;
+          }
+        }
+        afeye_line = afeye_s->GetLineNumber(shared->StartPosition());
+      }
+      char afeye_buf[256];
+      std::snprintf(afeye_buf, sizeof(afeye_buf),
+                    "exec %s %s script=%s:%d len=%u", afeye_t, afeye_fn,
+                    afeye_script, afeye_line,
+                    static_cast<unsigned>(event.code_len));
+      v8::afeye::EmitStr(v8::afeye::kIsolateBirth,
+                         v8::afeye::NowNs(), afeye_buf);
+    }
+  }
+#endif
   code_event_handler_(&event);
 }
 
