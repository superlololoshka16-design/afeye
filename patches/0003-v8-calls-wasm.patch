+#ifdef V8_AFEYE
+// afeye (v7): THE C++ -> JS funnel. Every entry passes through Invoke:
+// v8::Function::Call, Script::Run / RunModule, Execution::New, microtask
+// callbacks (TryRunMicrotasks), JSON revivers, sort comparators, v8's own
+// internal callers. This replaces the v6 api.cc Function::Call hook that
+// only saw the public API surface - nothing C++-initiated slips past this
+// point. The callee's script:line is the "who got invoked" linkage the Rust
+// filter joins with input events and network sends on the timeline.
+static void AfeyeLogInvoke(Isolate* isolate, const InvokeParams& params) {
+  static std::atomic<uint64_t> g_afeye_calls{0};
+  static bool g_afeye_calls_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_CALLS");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_calls_off) return;
+  // hard cap: the call stream must never starve the script-source stream
+  if (g_afeye_calls.fetch_add(1, std::memory_order_relaxed) >= 4000000) {
+    return;
+  }
+  char afeye_buf[320];
+  int afeye_n = std::snprintf(afeye_buf, sizeof(afeye_buf), "call argc=%u%s",
+                              static_cast<unsigned>(params.args.size()),
+                              params.is_construct ? " c=1" : "");
+  if (afeye_n > 0 && IsJSFunction(*params.target)) {
+    // NO-ALLOC (v8): the previous body built a v8::ScriptOrigin, a
+    // v8::String::Utf8Value (heap) and a std::string PER Invoke. Invoke is
+    // THE C++->JS funnel - every Script::Run, microtask, reviver, comparator
+    // and v8-internal call crosses it, including callers running under GC.
+    // Reading script name + line through the internal Tagged<> objects under
+    // DisallowGarbageCollection touches only stack scratch: no Local, no
+    // HandleScope, no heap buffer, no isolate re-entry. Script::GetLineNumber
+    // (the member, not the DirectHandle static) runs under DisallowGC too -
+    // fast path reads the cached line_ends, slow path iterates the flat
+    // source; neither allocates.
+    DisallowGarbageCollection no_gc;
+    Tagged<JSFunction> afeye_fn = Cast<JSFunction>(*params.target);
+    Tagged<SharedFunctionInfo> afeye_sfi = afeye_fn->shared();
+    int afeye_line = 0;
+    const char* afeye_name = "native";
+    int afeye_name_len = 6;
+    char afeye_namebuf[201];
+    if (IsScript(afeye_sfi->script())) {
+      Tagged<Script> afeye_script = Cast<Script>(afeye_sfi->script());
+      afeye_line = afeye_script->GetLineNumber(afeye_sfi->StartPosition());
+      if (afeye_line < 0) afeye_line = 0;
+      Tagged<Object> afeye_nm = afeye_script->name();
+      if (IsString(afeye_nm)) {
+        String::FlatContent afeye_flat =
+            Cast<String>(afeye_nm)->GetFlatContent(no_gc);
+        if (afeye_flat.IsFlat()) {
+          uint32_t afeye_len = afeye_flat.length();
+          if (afeye_len > 200) afeye_len = 200;
+          if (afeye_flat.IsOneByte()) {
+            const uint8_t* afeye_p = afeye_flat.ToOneByteVector().begin();
+            for (uint32_t afeye_k = 0; afeye_k < afeye_len; ++afeye_k) {
+              uint8_t afeye_c = afeye_p[afeye_k];
+              afeye_namebuf[afeye_k] = (afeye_c >= 0x20 && afeye_c < 0x7f)
+                                           ? static_cast<char>(afeye_c)
+                                           : '?';
+            }
+          } else {
+            const base::uc16* afeye_p = afeye_flat.ToUC16Vector().begin();
+            for (uint32_t afeye_k = 0; afeye_k < afeye_len; ++afeye_k) {
+              base::uc16 afeye_c = afeye_p[afeye_k];
+              afeye_namebuf[afeye_k] = (afeye_c >= 0x20 && afeye_c < 0x7f)
+                                           ? static_cast<char>(afeye_c)
+                                           : '?';
+            }
+          }
+          afeye_namebuf[afeye_len] = '\0';
+          afeye_name = afeye_namebuf;
+          afeye_name_len = static_cast<int>(afeye_len);
+        }
+      }
+    }
+    std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                  " script=%.*s:%d", afeye_name_len, afeye_name, afeye_line);
+  }
+  v8::afeye::EmitStr(v8::afeye::kCallCompleted, v8::afeye::NowNs(),
+                     afeye_buf);
+}
+#endif
+
 V8_WARN_UNUSED_RESULT MaybeHandle<Object> Invoke(Isolate* isolate,
                                                  const InvokeParams& params) {
   RCS_SCOPE(isolate, RuntimeCallCounterId::kInvoke);
