+#ifdef V8_AFEYE
+// Every C++ -> JS entry goes through Function::Call below: event listener
+// callbacks, promise continuations, blink-invoked scripting. Recording the
+// callee's script origin + line is the "who got invoked" linkage that the
+// Rust filter joins with input events and network sends on the timeline.
+static void AfeyeLogCall(v8::Isolate* isolate, const v8::Function* fn,
+                         int argc) {
+  static std::atomic<uint64_t> g_afeye_calls{0};
+  static bool g_afeye_calls_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_CALLS");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_calls_off) return;
+  // hard cap: the call stream must never starve the script-source stream
+  if (g_afeye_calls.fetch_add(1, std::memory_order_relaxed) >= 4000000) {
+    return;
+  }
+  char afeye_buf[320];
+  int afeye_n = std::snprintf(afeye_buf, sizeof(afeye_buf), "call argc=%d",
+                              argc);
+  if (afeye_n > 0 && fn != nullptr) {
+    v8::ScriptOrigin afeye_origin = fn->GetScriptOrigin();
+    v8::Local<v8::Value> afeye_rn = afeye_origin.ResourceName();
+    int afeye_line = fn->GetScriptLineNumber();
+    if (afeye_line < 0) afeye_line = 0;
+    std::string afeye_script;
+    if (!afeye_rn.IsEmpty() && afeye_rn->IsString()) {
+      v8::Local<v8::String> afeye_s = afeye_rn.As<v8::String>();
+      v8::String::Utf8Value afeye_uv(isolate, afeye_s);
+      if (*afeye_uv) {
+        size_t afeye_len = std::strlen(*afeye_uv);
+        if (afeye_len > 200) afeye_len = 200;
+        afeye_script.assign(*afeye_uv, afeye_len);
+      }
+    }
+    std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                  " script=%s:%d",
+                  afeye_script.empty() ? "native" : afeye_script.c_str(),
+                  afeye_line);
+  }
+  v8::afeye::EmitStr(v8::afeye::kCallCompleted, v8::afeye::NowNs(),
+                     afeye_buf);
+}
+#endif
