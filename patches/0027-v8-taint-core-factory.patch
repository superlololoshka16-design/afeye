diff --git a/v8/src/afeye/taint.cc b/v8/src/afeye/taint.cc
new file mode 100644
index 0000000..ccdbd0e
--- /dev/null
+++ b/v8/src/afeye/taint.cc
@@ -0,0 +1,213 @@
+#include "src/afeye/taint.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+
+#include "src/afeye/sink.h"
+
+namespace v8 {
+namespace afeye {
+
+
+namespace {
+
+constexpr size_t kTaintSlots = 1u << 20;
+constexpr uint64_t kTaintKeyMask = kTaintSlots - 1;
+constexpr uint64_t kTaintDropCap = 100000;
+
+struct TaintSlot {
+  std::atomic<uint64_t> key{0};
+  std::atomic<uint32_t> tag{0};
+  std::atomic<uint64_t> epoch{0};
+};
+
+TaintSlot g_taint[kTaintSlots];
+std::atomic<uint64_t> g_taint_dropped{0};
+std::atomic<uint32_t> g_sunk_union{0};
+// GC generation counter. A compacting GC invalidates every heap-keyed slot
+// AT ONCE by advancing the epoch - no table wipe, so the pre-GC tag union
+// (the 0032 gc witness) can still be snapshotted, and stale slots are
+// reclaimed lazily by the open-addressing probe on the next write.
+std::atomic<uint64_t> g_taint_epoch{1};
+
+bool TaintEnvOn() {
+  static const bool off = []() {
+    const char* v = ::getenv("AFEYE_TAINT");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off;
+}
+
+inline uint64_t CompositeKey(uint8_t space, uint64_t key) {
+  return (static_cast<uint64_t>(space + 1) << 61) | (key & ((1ull << 61) - 1));
+}
+
+inline uint64_t HashKey(uint64_t ck) {
+  uint64_t h = 1469598103934665603ull;
+  for (int i = 0; i < 8; ++i) {
+    h ^= (ck >> (i * 8)) & 0xff;
+    h *= 1099511628211ull;
+  }
+  return h & kTaintKeyMask;
+}
+
+// A heap-keyed slot is stale when a compacting GC advanced the epoch
+// after the slot was written: the object either moved or was freed and
+// its address reused. Stale slots never match a lookup and are reclaimed
+// lazily by the insert probe. Wasm-keyed slots (raw buffer addresses,
+// not GC-movable) survive epoch bumps.
+inline bool TaintSlotStale(uint64_t ck, uint64_t slot_epoch) {
+  const uint8_t space = static_cast<uint8_t>((ck >> 61) - 1);
+  if (space == kKeyWasm) return false;
+  return slot_epoch != g_taint_epoch.load(std::memory_order_relaxed);
+}
+
+inline TaintSlot* FindSlot(uint64_t ck, bool for_insert) {
+  uint64_t idx = HashKey(ck);
+  TaintSlot* reusable = nullptr;
+  const uint64_t max_probe = kTaintSlots >> 6;
+  for (uint64_t p = 0; p < max_probe; ++p) {
+    TaintSlot* s = &g_taint[idx & kTaintKeyMask];
+    uint64_t k = s->key.load(std::memory_order_acquire);
+    if (k == ck) {
+      if (!TaintSlotStale(ck, s->epoch.load(std::memory_order_relaxed))) {
+        return s;
+      }
+      // stale hit: the key is dead. A lookup stops here (no further probe
+      // may resurrect it); an insert may reuse this very slot.
+      if (!for_insert) return nullptr;
+      return s;
+    }
+    if (k == 0) {
+      if (!for_insert) return nullptr;
+      if (reusable == nullptr) reusable = s;
+    } else if (for_insert && reusable == nullptr &&
+               TaintSlotStale(k, s->epoch.load(std::memory_order_relaxed))) {
+      reusable = s;
+    }
+    ++idx;
+  }
+  return reusable;
+}
+
+inline TaintSlot* AcquireSlot(uint64_t ck) {
+  TaintSlot* s = FindSlot(ck, true);
+  if (s == nullptr) return nullptr;
+  uint64_t expected = s->key.load(std::memory_order_relaxed);
+  if (expected == ck) {
+    // A fresh hit just returns. A STALE same-key hit (slot survived a GC
+    // epoch bump) is reclaimed: clear the old tag and re-stamp below so
+    // the address is tracked again under the current epoch.
+    if (!TaintSlotStale(ck, s->epoch.load(std::memory_order_relaxed))) {
+      return s;
+    }
+    s->tag.store(0, std::memory_order_relaxed);
+  } else if (s->key.compare_exchange_strong(expected, ck,
+                                            std::memory_order_acq_rel,
+                                            std::memory_order_relaxed)) {
+    // claimed an empty or stale slot: start the tag clean.
+    s->tag.store(0, std::memory_order_relaxed);
+  } else {
+    // lost the race: another thread owns this key now.
+    s = FindSlot(ck, false);
+    if (s == nullptr) return nullptr;
+  }
+  s->epoch.store(g_taint_epoch.load(std::memory_order_relaxed),
+                 std::memory_order_relaxed);
+  return s;
+}
+
+}
+
+bool TaintEnabled() { return Enabled() && TaintEnvOn(); }
+
+void TaintSet(uint8_t space, uint64_t key, TaintTag tag) {
+  if (tag == kSrcNone || !TaintEnabled()) return;
+  TaintSlot* s = AcquireSlot(CompositeKey(space, key));
+  if (s == nullptr) {
+    // table full: count the drop and witness the cap exactly once when
+    // the limit is hit (kind 39 cap-exhausted name=taint).
+    AfeyeCapConsume(&g_taint_dropped, kTaintDropCap, "taint");
+    return;
+  }
+  uint32_t cur = s->tag.load(std::memory_order_relaxed);
+  while (!s->tag.compare_exchange_weak(cur, cur | tag,
+                                       std::memory_order_relaxed,
+                                       std::memory_order_relaxed)) {
+  }
+}
+
+TaintTag TaintGet(uint8_t space, uint64_t key) {
+  if (!TaintEnabled()) return kSrcNone;
+  TaintSlot* s = FindSlot(CompositeKey(space, key), false);
+  return s == nullptr ? kSrcNone : s->tag.load(std::memory_order_relaxed);
+}
+
+void TaintPropagate(uint8_t dst_space, uint64_t dst_key, uint8_t src_space,
+                    uint64_t src_key) {
+  if (!TaintEnabled()) return;
+  TaintTag src_tag = TaintGet(src_space, src_key);
+  if (src_tag == kSrcNone) return;
+  TaintSet(dst_space, dst_key, src_tag);
+}
+
+void TaintClear(uint8_t space, uint64_t key) {
+  if (!TaintEnabled()) return;
+  TaintSlot* s = FindSlot(CompositeKey(space, key), false);
+  if (s != nullptr) s->tag.store(0, std::memory_order_relaxed);
+}
+
+void TaintOnGCEpilogue(bool compacting) {
+  if (!compacting) return;
+  // No table wipe: every heap-keyed slot is invalidated AT ONCE by the
+  // epoch bump. Stale slots stop matching lookups immediately and are
+  // reclaimed lazily by the insert probe, so taint set after the GC is
+  // tracked against the new addresses instead of being erased wholesale.
+  g_taint_epoch.fetch_add(1, std::memory_order_relaxed);
+}
+
+void TaintEmitSink(const char* sink, uint8_t space, uint64_t key,
+                   TaintTag tag) {
+  if (tag == kSrcNone || !TaintEnabled()) return;
+  char buf[160];
+  std::snprintf(buf, sizeof(buf), "taint-sink %s space=%u key=%llx tag=%x",
+                sink, static_cast<unsigned>(space),
+                static_cast<unsigned long long>(key),
+                static_cast<unsigned>(tag));
+  EmitStr(kFingerprint, NowNs(), buf);
+  g_sunk_union.fetch_or(tag, std::memory_order_relaxed);
+}
+
+TaintTag TaintLiveHeapTagUnion() {
+  // only slots stamped with the CURRENT epoch are live: the 0032 gc
+  // witness snapshots this union immediately before the epoch bump, so
+  // it sees exactly the taint set since the previous compacting GC.
+  const uint64_t epoch = g_taint_epoch.load(std::memory_order_relaxed);
+  TaintTag u = kSrcNone;
+  for (size_t i = 0; i < kTaintSlots; ++i) {
+    const TaintSlot* s = &g_taint[i];
+    const uint64_t k = s->key.load(std::memory_order_relaxed);
+    if (k == 0) continue;
+    const uint8_t space = static_cast<uint8_t>((k >> 61) - 1);
+    if (space == kKeyWasm) continue;
+    if (s->epoch.load(std::memory_order_relaxed) != epoch) continue;
+    u |= s->tag.load(std::memory_order_relaxed);
+  }
+  return u;
+}
+
+TaintTag TaintSunkUnion() {
+  return static_cast<TaintTag>(g_sunk_union.load(std::memory_order_relaxed));
+}
+
+uint64_t TaintDropped() {
+  return g_taint_dropped.load(std::memory_order_relaxed);
+}
+
+}
+}
+
+#endif
diff --git a/v8/src/afeye/taint.h b/v8/src/afeye/taint.h
new file mode 100644
index 0000000..479f76b
--- /dev/null
+++ b/v8/src/afeye/taint.h
@@ -0,0 +1,58 @@
+#ifndef V8_AFEYE_TAINT_H_
+#define V8_AFEYE_TAINT_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+typedef uint32_t TaintTag;
+
+// Only kSrcFingerprint is a real source: it is the single bit that
+// capture sites actually tag (idl_member_installer, JsonStringify, the
+// Factory concat/slice seams). The former kSrcClock..kSrcOther bits were
+// never set by any emitter, so keeping them in the enum only created the
+// illusion of provenance the tracker did not have. They are removed.
+enum TaintSource : uint32_t {
+  kSrcNone = 0u,
+  kSrcFingerprint = 1u << 0,
+};
+
+enum TaintKeySpace : uint8_t {
+  kKeyHeap = 0,
+  kKeyWasm = 1,
+  kKeyStack = 2,
+  kKeyContext = 3,
+};
+
+bool TaintEnabled();
+
+void TaintSet(uint8_t space, uint64_t key, TaintTag tag);
+
+TaintTag TaintGet(uint8_t space, uint64_t key);
+
+void TaintPropagate(uint8_t dst_space, uint64_t dst_key, uint8_t src_space,
+                    uint64_t src_key);
+
+void TaintClear(uint8_t space, uint64_t key);
+
+void TaintOnGCEpilogue(bool compacting);
+
+void TaintEmitSink(const char* sink, uint8_t space, uint64_t key,
+                   TaintTag tag);
+
+TaintTag TaintLiveHeapTagUnion();
+
+TaintTag TaintSunkUnion();
+
+uint64_t TaintDropped();
+
+}
+}
+
+#endif
+
+#endif
diff --git a/v8/src/afeye/taint_abi.cc b/v8/src/afeye/taint_abi.cc
