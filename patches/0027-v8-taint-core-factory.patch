diff --git a/v8/src/afeye/taint.cc b/v8/src/afeye/taint.cc
new file mode 100644
index 0000000..b4ac6e5
--- /dev/null
+++ b/v8/src/afeye/taint.cc
@@ -0,0 +1,198 @@
+#include "src/afeye/taint.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+
+#include "src/afeye/sink.h"
+
+namespace v8 {
+namespace afeye {
+
+// ---------------------------------------------------------------------------
+// the shadow store. ONE open-addressing table keyed by (space,key) -> u32 tag.
+//
+// Why a fixed table and not a std::unordered_map: this is read/written from
+// inside interpreter handlers and wasm Load/Store on the HOT path. No malloc,
+// no rehash-on-insert stall, no iterator invalidation under the drain thread.
+// A power-of-two open table with linear probing, atomic slots, bounded size.
+// Overflow is COUNTED (TaintDropped) and folded into the sink-drop witness so
+// a taint gap is never silently mistaken for a dead end - the same honesty
+// contract sink.cc holds for ring drops.
+//
+// Capacity: 1<<20 slots (1M) x 16 B = 16 MB. Sized for a single page's
+// fingerprint-collection burst (a few thousand distinct tainted values); the
+// table is cleared at every compacting GC epilogue, so it never grows without
+// bound across a session.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+constexpr size_t kTaintSlots = 1u << 20;
+constexpr uint64_t kTaintKeyMask = kTaintSlots - 1;
+
+struct TaintSlot {
+  // 0 = empty. A real entry always has key != 0 because the composite key
+  // folds in the space in the high bits (space 0 = kKeyHeap is offset by 1).
+  std::atomic<uint64_t> key{0};
+  std::atomic<uint32_t> tag{0};
+};
+
+TaintSlot g_taint[kTaintSlots];
+std::atomic<uint64_t> g_taint_dropped{0};
+std::atomic<uint64_t> g_taint_live{0};
+
+// env gate: AFEYE_TAINT=0 disables the whole DTT layer (falls back to the
+// boundary sieve). Read once, cached.
+bool TaintEnvOn() {
+  static const bool off = []() {
+    const char* v = ::getenv("AFEYE_TAINT");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off;
+}
+
+// composite key: space in the top 3 bits, the 61-bit identity below. The
+// caller-supplied key is already a cage-offset / (instance<<32|off) / frame
+// value that fits in 61 bits; folding the space in makes (space,key) unique
+// across all four spaces in one table.
+inline uint64_t CompositeKey(uint8_t space, uint64_t key) {
+  return (static_cast<uint64_t>(space + 1) << 61) | (key & ((1ull << 61) - 1));
+}
+
+// FNV-1a over the 8-byte composite key -> slot index. Cheap, good spread for
+// the structured keys (offsets, frame slots) this sees.
+inline uint64_t HashKey(uint64_t ck) {
+  uint64_t h = 1469598103934665603ull;
+  for (int i = 0; i < 8; ++i) {
+    h ^= (ck >> (i * 8)) & 0xff;
+    h *= 1099511628211ull;
+  }
+  return h & kTaintKeyMask;
+}
+
+// Linear-probe find. Returns the slot holding `ck`, or the first empty slot
+// (for insert), or nullptr if the table is full along the probe (caller
+// counts a drop). Bounded probe: kTaintSlots/64 steps before giving up, so a
+// pathological cluster cannot spin the hot path.
+inline TaintSlot* FindSlot(uint64_t ck, bool for_insert) {
+  uint64_t idx = HashKey(ck);
+  TaintSlot* first_empty = nullptr;
+  const uint64_t max_probe = kTaintSlots >> 6;
+  for (uint64_t p = 0; p < max_probe; ++p) {
+    TaintSlot* s = &g_taint[idx & kTaintKeyMask];
+    uint64_t k = s->key.load(std::memory_order_acquire);
+    if (k == ck) return s;
+    if (k == 0) {
+      if (!for_insert) return nullptr;
+      if (first_empty == nullptr) first_empty = s;
+      // keep probing a bounded window is unnecessary for insert; take the
+      // first empty.
+      return first_empty;
+    }
+    ++idx;
+  }
+  return nullptr;  // probe budget exhausted
+}
+
+// Insert-or-find under a CAS so two threads racing on the same new key cannot
+// both claim the empty slot. Returns the slot, or nullptr on a lost race that
+// could not be re-won within the probe budget (counted as a drop).
+inline TaintSlot* AcquireSlot(uint64_t ck) {
+  TaintSlot* s = FindSlot(ck, true);
+  if (s == nullptr) return nullptr;
+  uint64_t expected = 0;
+  if (s->key.load(std::memory_order_relaxed) == ck) return s;  // already ours
+  if (s->key.compare_exchange_strong(expected, ck,
+                                     std::memory_order_acq_rel,
+                                     std::memory_order_relaxed)) {
+    g_taint_live.fetch_add(1, std::memory_order_relaxed);
+    return s;
+  }
+  // lost the race: the winner installed either our key or another. Re-find.
+  return FindSlot(ck, false);
+}
+
+}  // namespace
+
+bool TaintEnabled() { return Enabled() && TaintEnvOn(); }
+
+void TaintSet(uint8_t space, uint64_t key, TaintTag tag) {
+  if (tag == kSrcNone || !TaintEnabled()) return;
+  TaintSlot* s = AcquireSlot(CompositeKey(space, key));
+  if (s == nullptr) {
+    g_taint_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  // union: existing bits survive (DTT law)
+  uint32_t cur = s->tag.load(std::memory_order_relaxed);
+  while (!s->tag.compare_exchange_weak(cur, cur | tag,
+                                       std::memory_order_relaxed,
+                                       std::memory_order_relaxed)) {
+  }
+}
+
+TaintTag TaintGet(uint8_t space, uint64_t key) {
+  if (!TaintEnabled()) return kSrcNone;
+  TaintSlot* s = FindSlot(CompositeKey(space, key), false);
+  return s == nullptr ? kSrcNone : s->tag.load(std::memory_order_relaxed);
+}
+
+void TaintPropagate(uint8_t dst_space, uint64_t dst_key, uint8_t src_space,
+                    uint64_t src_key) {
+  if (!TaintEnabled()) return;
+  TaintTag src_tag = TaintGet(src_space, src_key);
+  if (src_tag == kSrcNone) return;  // fast path: untainted source, no write
+  TaintSet(dst_space, dst_key, src_tag);
+}
+
+void TaintClear(uint8_t space, uint64_t key) {
+  if (!TaintEnabled()) return;
+  TaintSlot* s = FindSlot(CompositeKey(space, key), false);
+  if (s != nullptr) s->tag.store(0, std::memory_order_relaxed);
+}
+
+void TaintOnGCEpilogue(bool compacting) {
+  if (!compacting) return;  // minor/scavenges that don't move: keep tags
+  // A compacting GC moves heap objects and frames, so kKeyHeap / kKeyStack /
+  // kKeyContext identities dangle. Clear them; KEEP kKeyWasm (the linear
+  // memory backing store is fixed and does not move). Losing an epoch of
+  // heap taint is honest; a dangling tag on a recycled object is a false
+  // link, which is worse. The boundary records (sink.cc) are the cross-epoch
+  // backstop for exactly this case.
+  for (size_t i = 0; i < kTaintSlots; ++i) {
+    TaintSlot* s = &g_taint[i];
+    uint64_t k = s->key.load(std::memory_order_relaxed);
+    if (k == 0) continue;
+    uint8_t space = static_cast<uint8_t>((k >> 61) - 1);
+    if (space == kKeyWasm) continue;  // survives
+    s->key.store(0, std::memory_order_relaxed);
+    s->tag.store(0, std::memory_order_relaxed);
+    g_taint_live.fetch_sub(1, std::memory_order_relaxed);
+  }
+}
+
+void TaintEmitSink(const char* sink, uint8_t space, uint64_t key,
+                   TaintTag tag) {
+  if (tag == kSrcNone || !TaintEnabled()) return;
+  // record: "taint-sink <sink> space=<n> key=<hex> tag=<hex>" via EmitStr.
+  // The Rust filter reads the tag bitmask to attribute WHICH fingerprint
+  // sources reached the wire - the causality-backed `proven` verdict.
+  char buf[160];
+  std::snprintf(buf, sizeof(buf), "taint-sink %s space=%u key=%llx tag=%x",
+                sink, static_cast<unsigned>(space),
+                static_cast<unsigned long long>(key),
+                static_cast<unsigned>(tag));
+  EmitStr(kFingerprint, NowNs(), buf);
+}
+
+uint64_t TaintDropped() {
+  return g_taint_dropped.load(std::memory_order_relaxed);
+}
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
diff --git a/v8/src/afeye/taint.h b/v8/src/afeye/taint.h
new file mode 100644
index 0000000..4ec5faf
--- /dev/null
+++ b/v8/src/afeye/taint.h
@@ -0,0 +1,103 @@
+#ifndef V8_AFEYE_TAINT_H_
+#define V8_AFEYE_TAINT_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+// afeye dynamic taint tracking (DTT) core. The boundary sieve (sink.cc) can
+// only see values that CROSS a C++ API edge; ~90% of modern antifraud logic
+// (custom alphabets, manual byte shuffling, pure-JS deflate/RSA, closure
+// handoff) never crosses one, so the content graph drops those chains to
+// `unresolved` or false `dead-end-proven`. This module carries a taint TAG
+// through the VM itself, so a fingerprint byte that entered a tracked slot is
+// followed to the socket even across ten pure-JS re-encodings.
+//
+// A taint tag is a 32-bit SOURCE BITMASK: bit i = "touched source i". Tags
+// union with bitwise-OR (the DTT propagation law), so a value assembled from
+// two fingerprint reads carries both bits. 0 = untainted.
+typedef uint32_t TaintTag;
+
+// Source bits (assigned at the capture sites; 32 distinct sources per the
+// u32 mask). A site that needs more folds into kSrcOther and rides its
+// identity in the emitted record's tag string, not in a bit.
+enum TaintSource : uint32_t {
+  kSrcNone = 0u,
+  kSrcFingerprint = 1u << 0,  // navigator/screen/webgl/canvas/audio reads
+  kSrcClock = 1u << 1,        // Date.now / performance.now
+  kSrcInput = 1u << 2,        // mouse/keyboard/pointer events
+  kSrcRandom = 1u << 3,       // crypto.getRandomValues
+  kSrcStorage = 1u << 4,      // cookie / localStorage / sessionStorage read
+  kSrcNetwork = 1u << 5,      // a challenge response body (atob/TextDecoder)
+  kSrcStack = 1u << 6,        // Error().stack materialization
+  kSrcWasm = 1u << 7,         // a value that entered wasm linear memory
+  kSrcOther = 1u << 31,       // folded source; identity in the record tag
+};
+
+// Key spaces. The 64-bit shadow key is namespaced by space so heap values,
+// wasm bytes, interpreter registers and Context slots never collide in one
+// table. Which spaces SURVIVE a compacting GC is the whole soundness story:
+//   kKeyWasm   - wasm linear memory is a fixed, non-moving backing store, so
+//                (instance,offset) keys stay valid across GC. SOUND forever.
+//   kKeyHeap/kKeyContext/kKeyStack - keyed by an address or frame slot that a
+//                compacting GC moves. These are CLEARED at a compacting GC
+//                epilogue (TaintOnGCEpilogue) so taint can never dangle onto
+//                a recycled object (a false link is worse than a lost one).
+//                Within a GC epoch they are exact; the boundary records are
+//                the cross-epoch backstop.
+enum TaintKeySpace : uint8_t {
+  kKeyHeap = 0,     // key = object cage-offset >> kObjectAlignmentBits
+  kKeyWasm = 1,     // key = (instance_id << 32) | byte_offset
+  kKeyStack = 2,    // key = (frame_fp >> 4) | register_index
+  kKeyContext = 3,  // key = (context_cage_off >> align) << 12 | slot_index
+};
+
+// Number of distinct source bits the u32 mask carries.
+constexpr int kTaintSourceBits = 32;
+
+bool TaintEnabled();
+
+// Store/union a tag for (space,key). Union semantics: an existing tag keeps
+// its bits (a value touched by two sources stays touched by both). no-alloc,
+// bounded, drop-counted like the sink ring.
+void TaintSet(uint8_t space, uint64_t key, TaintTag tag);
+
+// Read the tag for (space,key). 0 if absent. no-alloc.
+TaintTag TaintGet(uint8_t space, uint64_t key);
+
+// The DTT primitive: dst inherits (ORs in) src's tag. Used at every move /
+// arithmetic / store handler. no-alloc.
+void TaintPropagate(uint8_t dst_space, uint64_t dst_key, uint8_t src_space,
+                    uint64_t src_key);
+
+// Clear a (space,key) - a slot overwritten by an untainted value.
+void TaintClear(uint8_t space, uint64_t key);
+
+// GC epilogue hook (wired via Heap::AddGCEpilogueCallback). `compacting` is
+// true for mark-compact / scavenges that move objects. Wasm space is never
+// cleared (its backing store does not move).
+void TaintOnGCEpilogue(bool compacting);
+
+// Emit a taint-flow record when a tainted value reaches a SINK (socket write,
+// fetch body, postMessage). This is what turns the byte-graph `proven` verdict
+// from "shares bytes with a sink" into "carries fingerprint taint into a sink"
+// - the honest, causality-backed version. The tag bitmask rides verbatim so
+// the Rust side can attribute WHICH sources reached the wire.
+void TaintEmitSink(const char* sink, uint8_t space, uint64_t key,
+                   TaintTag tag);
+
+// Records dropped because the shadow table was full (the honest-witness
+// counter, folded into the sink-drop stream so a taint gap is never mistaken
+// for a dead end).
+uint64_t TaintDropped();
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
+
+#endif  // V8_AFEYE_TAINT_H_
diff --git a/v8/src/afeye/taint_abi.cc b/v8/src/afeye/taint_abi.cc
new file mode 100644
index 0000000..33a596f
--- /dev/null
+++ b/v8/src/afeye/taint_abi.cc
@@ -0,0 +1,38 @@
+#include "src/afeye/taint_abi.h"
+
+#ifdef V8_AFEYE
+
+#include "src/afeye/taint.h"
+
+// afeye (0027): the extern "C" bridge bodies. Thin wrappers over the v8
+// taint store (taint.cc), exported with default visibility so blink capture
+// sites - which cannot include v8-internal headers - can tag a String by its
+// heap address. The address key matches the v8 Factory propagation hooks
+// exactly, so blink-tagged values and v8-propagated values are the same
+// identity. See taint_abi.h for the GC-epoch soundness contract.
+
+extern "C" {
+
+void afeye_taint_tag_string(uint64_t key, uint32_t source_bit) {
+  if (!v8::afeye::TaintEnabled() || source_bit == 0) return;
+  v8::afeye::TaintSet(v8::afeye::kKeyHeap, key,
+                      static_cast<v8::afeye::TaintTag>(source_bit));
+}
+
+uint32_t afeye_taint_get_string(uint64_t key) {
+  if (!v8::afeye::TaintEnabled()) return 0;
+  return static_cast<uint32_t>(
+      v8::afeye::TaintGet(v8::afeye::kKeyHeap, key));
+}
+
+void afeye_taint_propagate_string(uint64_t dst_key, uint64_t src_key) {
+  if (!v8::afeye::TaintEnabled()) return;
+  v8::afeye::TaintPropagate(v8::afeye::kKeyHeap, dst_key, v8::afeye::kKeyHeap,
+                            src_key);
+}
+
+int afeye_taint_active(void) { return v8::afeye::TaintEnabled() ? 1 : 0; }
+
+}  // extern "C"
+
+#endif  // V8_AFEYE
diff --git a/v8/src/afeye/taint_abi.h b/v8/src/afeye/taint_abi.h
new file mode 100644
index 0000000..497dab1
--- /dev/null
+++ b/v8/src/afeye/taint_abi.h
@@ -0,0 +1,52 @@
+#ifndef V8_AFEYE_TAINT_ABI_H_
+#define V8_AFEYE_TAINT_ABI_H_
+
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+// afeye (0027): the taint ABI bridge. The taint STORE lives in v8
+// (src/afeye/taint.cc) and is keyed by a tagged value's heap address, which
+// is a v8-internal concept (Tagged<String>::address()). Blink capture sites
+// (TextDecoder.decode -> kSrcNetwork, SubtleCrypto output, StorageArea read
+// -> kSrcStorage, document.cookie -> kSrcStorage) CANNOT include v8-internal
+// headers - they live in a different component. So v8 EXPORTS these four
+// extern "C" entry points (default visibility) and blink DECLARES them with
+// the identical signatures, passing the raw address() of the String it just
+// produced. The address is the same identity v8's Factory concat/slice
+// propagation (factory-base.cc / factory.cc, 0027) keys on, so a blink tag
+// and a v8 propagation agree by construction.
+//
+// GC soundness: an address tag is only valid within a GC epoch. v8's
+// TaintOnGCEpilogue(compacting) (registered by 0032) clears all kKeyHeap
+// tags at compaction, so a recycled address can never inherit a stale tag.
+// Between collections the tag follows the object exactly. This is the same
+// epoch model the whole heap-taint layer uses - documented, not hidden.
+//
+// Values are passed as uint64_t (the address) so the ABI is identical on
+// every platform and needs no shared struct layout.
+extern "C" {
+
+// Tag a freshly-captured blink String as carrying taint `source_bit`
+// (one of v8::afeye::TaintSource, passed as its u32 value). Union semantics:
+// an existing tag keeps its bits. `key` is the String's address().
+void afeye_taint_tag_string(uint64_t key, uint32_t source_bit);
+
+// Read the accumulated tag for a String address. Returns 0 if untainted or
+// if taint is disabled. Lets a blink site decide whether to emit.
+uint32_t afeye_taint_get_string(uint64_t key);
+
+// Propagate src -> dst (OR the tags). Used when blink moves a value between
+// two heap Strings without going through v8's Factory (rare; most string
+// creation funnels through Factory and is caught by the 0027 v8 hooks).
+void afeye_taint_propagate_string(uint64_t dst_key, uint64_t src_key);
+
+// True when the DTT layer is active (sink enabled AND AFEYE_TAINT != 0).
+// Lets a blink site skip the address() read entirely when taint is off.
+int afeye_taint_active(void);
+
+}  // extern "C"
+
+#endif  // V8_AFEYE
+
+#endif  // V8_AFEYE_TAINT_ABI_H_
