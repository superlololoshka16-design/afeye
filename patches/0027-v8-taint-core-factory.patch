+#ifdef V8_AFEYE
+namespace {
+// afeye (0027): heap-object taint key. A Tagged<String>'s address() is
+// stable within a GC epoch; TaintOnGCEpilogue(compacting) (registered by
+// 0032 via Heap::AddGCEpilogueCallback) clears all kKeyHeap entries at
+// compaction, so a recycled address can never inherit a stale tag. This is
+// the tier-independent seam: EVERY string concat (a+b, template literals,
+// Array.join, += accumulation) bottoms out in FactoryBase::NewConsString,
+// whether the caller is Ignition bytecode OR TurboFan/Maglev machine code -
+// the compiled tier still calls into this C++ funnel to allocate the result.
+// That is why per-bytecode interpreter taint (a frame-layout fork) is not
+// needed to follow pure-JS string assembly to the wire.
+V8_INLINE uint64_t AfeyeStrKey(Tagged<String> s) {
+  return static_cast<uint64_t>(s.address());
+}
+V8_INLINE void AfeyeTaintConcat(Tagged<String> result, Tagged<String> left,
+                                Tagged<String> right) {
+  if (!v8::afeye::TaintEnabled()) return;
+  v8::afeye::TaintTag t =
+      v8::afeye::TaintGet(v8::afeye::kKeyHeap, AfeyeStrKey(left)) |
+      v8::afeye::TaintGet(v8::afeye::kKeyHeap, AfeyeStrKey(right));
+  if (t != v8::afeye::kSrcNone)
+    v8::afeye::TaintSet(v8::afeye::kKeyHeap, AfeyeStrKey(result), t);
+}
+V8_INLINE void AfeyeTaintCopy(Tagged<String> result, Tagged<String> src) {
+  if (!v8::afeye::TaintEnabled()) return;
+  v8::afeye::TaintPropagate(v8::afeye::kKeyHeap, AfeyeStrKey(result),
+                            v8::afeye::kKeyHeap, AfeyeStrKey(src));
+}
+}  // namespace
+#endif  // V8_AFEYE
+
