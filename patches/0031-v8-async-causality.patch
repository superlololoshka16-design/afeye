index 0000000..fafc6f0
--- /dev/null
+++ b/v8/src/afeye/causality.cc
@@ -0,0 +1,458 @@
+#include "src/afeye/causality.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+#include "src/afeye/sink.h"
+
+namespace v8 {
+namespace afeye {
+
+// ---------------------------------------------------------------------------
+// the trace_id registry.
+//
+// THREE bounded structures, all no-alloc on the hot path:
+//
+//  1. the ambient id + scope stack: thread_local. A MicrotaskQueue belongs to
+//     one Isolate and is drained on one thread, so "the id active right now"
+//     is a per-thread property. Fixed array (not std::vector) because the
+//     enter/exit pair runs inside the drain loop for EVERY microtask - a
+//     malloc per turn is not acceptable in a tracing build whose whole value
+//     is that it stays close enough to real timing to be believed.
+//
+//  2. the enqueue->run side-table: one process-wide open-addressing table
+//     mapping tagged Microtask address -> minted child id. Bounded linear
+//     probe over atomic slots, drop-counted overflow, so no rehash stall, no
+//     iterator invalidation and no malloc. EVERY probe runs under one short
+//     spinlock (see TaskLock below): FindTaskSlot has exactly two callers,
+//     StoreTaskTid and TakeTaskTid, both of which take it first, so there is
+//     no unlocked reader path to reason about. Serialising insert/take is what
+//     makes the tombstone protocol sound - a lock-free `take` tombstoning a
+//     slot can otherwise clobber an insert that just reclaimed it, losing an
+//     async edge (found by stress test, see TaskLock). Unlike taint.cc this
+//     table is NOT cleared at GC: keys are consumed exactly once by the run
+//     side, and an unconsumed key is overwritten when its address is recycled,
+//     so the table self-limits.
+//
+//  3. the monotonic id counter: one process-wide atomic. Never 0.
+//
+// Why a side-table keyed by the Microtask address and not a field on the
+// Microtask object: every Microtask variant (CallableTask, CallbackTask,
+// PromiseFulfillReactionJobTask, PromiseRejectReactionJobTask,
+// PromiseResolveThenableJobTask, AsyncResumeTask) is a Torque-generated struct
+// whose layout is fixed by src/objects/microtask.tq and whose exact size is
+// relied on by the in-place MORPH of a PromiseReaction into a
+// PromiseReactionJobTask (see the comment at src/objects/promise.h:155-161 -
+// "the size of PromiseReaction and the size of the PromiseReactionJobTask has
+// to be same for this to work"). Adding a field would break that invariant and
+// every offset constant derived from it. Keying by address keeps the object
+// layout untouched.
+//
+// Address-recycling soundness: a tagged address can be reused by a LATER
+// microtask after GC. That is handled by insert-or-OVERWRITE - two distinct
+// live microtasks can never share an address, so a key collision always means
+// the same object being re-captured, and the newer id is the correct one. A
+// dangling entry (enqueued, then the queue was cleared via ClearMicrotasks or
+// the Isolate died, so no run ever consumed it) can only be matched by an
+// address that was subsequently re-captured - which overwrites it first. The
+// run side REMOVES the entry, so consumed ids never linger.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+// env gate: AFEYE_CAUSALITY=0 disables the causality layer entirely (the
+// boundary sieve and the DTT shadow store keep working). Read once, cached.
+bool CausalityEnvOn() {
+  static const bool off = []() {
+    const char* v = ::getenv("AFEYE_CAUSALITY");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off;
+}
+
+std::atomic<uint64_t> g_next_id{0};
+
+// --- the enqueue -> run side-table -----------------------------------------
+
+constexpr size_t kTaskSlots = 1u << 16;   // 64K x 16 B = 1 MB
+constexpr uint64_t kTaskKeyMask = kTaskSlots - 1;
+// 0 = empty. A tagged Microtask pointer is never 0 (it is a live heap object),
+// so 0 is a safe empty marker and is never stored.
+constexpr uint64_t kTaskKeyEmpty = 0;
+// Tombstone: consumed entry. Never blocks a lookup (lookups stop only at an
+// empty slot) and is reused by the next insert, so tombstones cannot
+// accumulate into a full table.
+constexpr uint64_t kTaskKeyDead = ~0ull;
+
+struct TaskSlot {
+  std::atomic<uint64_t> key{kTaskKeyEmpty};
+  std::atomic<uint64_t> tid{0};
+};
+
+TaskSlot g_tasks[kTaskSlots];
+
+// One spinlock over the whole side-table, using the SAME bounded idiom
+// sink.cc already applies to its ring (sink.cc EmitFlags: test_and_set, 64
+// spins then std::this_thread::yield). Lock-free open addressing here is
+// technically achievable but needs a tombstone protocol correct against
+// concurrent reclaim; a stress test found interleavings where a `take`
+// tombstoning a slot could lose a concurrent insert's id. Capture
+// completeness is the entire value of this patch - a silently lost async edge
+// is worse than a few nanoseconds of contention - so the table takes the lock.
+// Scope is tiny (one probe + one store), never held across an emit, and the
+// drain is single-threaded per isolate so real contention is rare.
+std::atomic_flag g_task_lock = ATOMIC_FLAG_INIT;
+
+class TaskLock {
+ public:
+  TaskLock() {
+    unsigned spins = 0;
+    while (g_task_lock.test_and_set(std::memory_order_acquire)) {
+      if (++spins >= 64) {
+        spins = 0;
+        std::this_thread::yield();
+      }
+    }
+  }
+  ~TaskLock() { g_task_lock.clear(std::memory_order_release); }
+  TaskLock(const TaskLock&) = delete;
+  TaskLock& operator=(const TaskLock&) = delete;
+};
+
+std::atomic<uint64_t> g_dropped{0};
+std::atomic<uint64_t> g_imbalance{0};
+std::atomic<uint64_t> g_misses{0};
+std::atomic<uint64_t> g_minted{0};
+
+// FNV-1a over the 8-byte key. Same hash shape as taint.cc so the two tables
+// spread the same kind of structured (cage-offset-derived) keys alike.
+inline uint64_t HashTaskKey(uint64_t k) {
+  uint64_t h = 1469598103934665603ull;
+  for (int i = 0; i < 8; ++i) {
+    h ^= (k >> (i * 8)) & 0xff;
+    h *= 1099511628211ull;
+  }
+  return h & kTaskKeyMask;
+}
+
+// Bounded probe. Returns the slot holding {key}, or (for insert) the first
+// reusable slot (empty or tombstone), or nullptr if the probe budget is spent.
+// The budget is a fixed fraction of the table so a pathological cluster cannot
+// spin the enqueue path.
+inline TaskSlot* FindTaskSlot(uint64_t key, bool for_insert) {
+  uint64_t idx = HashTaskKey(key);
+  TaskSlot* reusable = nullptr;
+  const uint64_t max_probe = kTaskSlots >> 4;
+  for (uint64_t p = 0; p < max_probe; ++p) {
+    TaskSlot* s = &g_tasks[idx & kTaskKeyMask];
+    uint64_t k = s->key.load(std::memory_order_acquire);
+    if (k == key) return s;
+    if (k == kTaskKeyEmpty) {
+      // An empty slot terminates the probe for BOTH modes. On insert, prefer a
+      // tombstone seen earlier (it reuses a consumed slot and keeps the chain
+      // shorter) and fall back to this empty slot - returning nullptr here
+      // would fail every first insert into a virgin table.
+      if (!for_insert) return nullptr;
+      return reusable != nullptr ? reusable : s;
+    }
+    if (k == kTaskKeyDead && reusable == nullptr && for_insert) reusable = s;
+    ++idx;
+  }
+  return nullptr;
+}
+
+// Insert-or-overwrite. Returns false if the entry could not be stored (probe
+// budget spent) - the caller counts the drop.
+//
+// Under TaskLock the whole probe+store is atomic against every other accessor,
+// so a plain find-then-write is correct and no CAS retry dance is needed. An
+// existing entry for {key} is OVERWRITTEN, which is the sound choice for a
+// recycled tagged address: two distinct live Microtask objects can never share
+// an address, so a key already present means the same object was re-captured
+// and the newer id is the one the run side must see.
+bool StoreTaskTid(uint64_t key, uint64_t tid) {
+  TaskLock lock;
+  TaskSlot* s = FindTaskSlot(key, true);
+  if (s == nullptr) return false;
+  s->key.store(key, std::memory_order_relaxed);
+  s->tid.store(tid, std::memory_order_relaxed);
+  return true;
+}
+
+// Take (read + REMOVE) the id stored for {key}. Returns 0 if absent.
+uint64_t TakeTaskTid(uint64_t key) {
+  TaskLock lock;
+  TaskSlot* s = FindTaskSlot(key, false);
+  if (s == nullptr) return 0;
+  uint64_t tid = s->tid.load(std::memory_order_relaxed);
+  // Tombstone the key so a recycled address is never matched to an already
+  // consumed id, and so the slot becomes reusable by the next insert. This
+  // store is exactly what a concurrent insert could be clobbered by if the
+  // table were lock-free - hence the lock above.
+  s->tid.store(0, std::memory_order_relaxed);
+  s->key.store(kTaskKeyDead, std::memory_order_relaxed);
+  return tid;
+}
+
+// --- the ambient id + scope stack ------------------------------------------
+
+// Nesting bound. Reaching it means one async turn's body recursively started
+// 256 more drains (each drain nests via
+// Runtime_PerformMicrotaskCheckpoint); anything past that is counted as an
+// imbalance and the turn runs with the OUTER id still ambient, which is the
+// conservative, never-invents-an-edge behaviour.
+constexpr size_t kScopeCap = 256;
+
+thread_local uint64_t g_ambient = 0;
+thread_local uint64_t g_scope[kScopeCap];
+thread_local size_t g_depth = 0;
+// Outstanding enters that could NOT be installed because the scope stack was
+// full. Under the LIFO discipline the skipped enters are always the innermost
+// ones, so a single counter pairs them correctly with their exits.
+thread_local size_t g_skipped = 0;
+
+// One line shape for every causality record:
+//   "causality <what> tid=<hex> parent=<hex>"
+// {what} carries the label plus any extra `k=v` fields verbatim, so a record
+// is never split and the Rust side parses one prefix.
+void EmitCausality(const char* what, uint64_t tid, uint64_t parent) {
+  // 256 not 192: the `witness` record carries four u64 counters, which alone
+  // can reach ~134 chars before the tid=/parent= suffix. snprintf would
+  // truncate safely rather than overflow, but truncation would silently drop
+  // the trailing counter - exactly the field a drop report most needs.
+  char buf[256];
+  std::snprintf(buf, sizeof(buf), "causality %s tid=%llx parent=%llx", what,
+                static_cast<unsigned long long>(tid),
+                static_cast<unsigned long long>(parent));
+  EmitStr(kFingerprint, NowNs(), buf);
+}
+
+// Last-emitted snapshot of the witness counters, so emission is
+// change-detected. Process-wide (the counters are), guarded by a flag swap so
+// only one racing drain emits per change - the rest see the value already
+// recorded and stay silent. Never on the per-task hot path: called only at
+// drain scope exit.
+std::atomic<uint64_t> g_wit_dropped{0};
+std::atomic<uint64_t> g_wit_imbalance{0};
+std::atomic<uint64_t> g_wit_misses{0};
+std::atomic<uint64_t> g_wit_minted{0};
+
+void EmitWitnessIfChanged() {
+  if (!CausalityEnvOn() || !Enabled()) return;
+  const uint64_t dropped = g_dropped.load(std::memory_order_relaxed);
+  const uint64_t imbalance = g_imbalance.load(std::memory_order_relaxed);
+  const uint64_t misses = g_misses.load(std::memory_order_relaxed);
+  const uint64_t minted = g_minted.load(std::memory_order_relaxed);
+  if (dropped == g_wit_dropped.load(std::memory_order_relaxed) &&
+      imbalance == g_wit_imbalance.load(std::memory_order_relaxed) &&
+      misses == g_wit_misses.load(std::memory_order_relaxed) &&
+      minted == g_wit_minted.load(std::memory_order_relaxed)) {
+    return;  // nothing new to say: a healthy drain emits no witness record
+  }
+  g_wit_dropped.store(dropped, std::memory_order_relaxed);
+  g_wit_imbalance.store(imbalance, std::memory_order_relaxed);
+  g_wit_misses.store(misses, std::memory_order_relaxed);
+  g_wit_minted.store(minted, std::memory_order_relaxed);
+  char what[160];
+  std::snprintf(what, sizeof(what),
+                "witness dropped=%llu imbalance=%llu misses=%llu minted=%llu",
+                static_cast<unsigned long long>(dropped),
+                static_cast<unsigned long long>(imbalance),
+                static_cast<unsigned long long>(misses),
+                static_cast<unsigned long long>(minted));
+  // tid is 0 by design: a witness record describes the whole process, not one
+  // turn, and attributing it to whatever id happened to be ambient would
+  // suggest a causal link that does not exist.
+  EmitCausality(what, 0, 0);
+}
+
+}  // namespace
+
+bool CausalityEnabled() { return Enabled() && CausalityEnvOn(); }
+
+uint64_t CausalityCurrent() { return g_ambient; }
+
+void CausalityEnter(uint64_t trace_id) { g_ambient = trace_id; }
+
+uint64_t CausalityExitRestore(uint64_t prev) {
+  uint64_t was = g_ambient;
+  g_ambient = prev;
+  return was;
+}
+
+uint64_t CausalityNewRoot() {
+  // Monotonic, never 0: a root is always distinguishable from an uncaptured
+  // turn (which reads as 0).
+  uint64_t id = g_next_id.fetch_add(1, std::memory_order_relaxed) + 1;
+  g_minted.fetch_add(1, std::memory_order_relaxed);
+  return id;
+}
+
+void CausalityLink(uint64_t parent, uint64_t child) {
+  if (!CausalityEnabled()) return;
+  char what[96];
+  std::snprintf(what, sizeof(what), "link edge=%llx->%llx",
+                static_cast<unsigned long long>(parent),
+                static_cast<unsigned long long>(child));
+  EmitCausality(what, child, parent);
+}
+
+void CausalityEmit(const char* what, uint64_t trace_id, uint64_t parent_id) {
+  if (!CausalityEnabled()) return;
+  EmitCausality(what == nullptr ? "note" : what, trace_id, parent_id);
+}
+
+uint64_t CausalityNewChild(uint64_t parent) {
+  uint64_t child = CausalityNewRoot();
+  if (parent != 0) CausalityLink(parent, child);
+  return child;
+}
+
+void CausalityCaptureEnqueue(uint64_t task_key) {
+  if (!CausalityEnabled() || task_key == kTaskKeyEmpty) return;
+  // The enqueuer's ambient id is the PARENT of this async turn. A turn
+  // scheduled outside any trace (parent 0) becomes a fresh root, so an
+  // uncaptured caller never silently adopts a neighbouring turn's id.
+  uint64_t parent = g_ambient;
+  uint64_t child = CausalityNewChild(parent);
+  if (!StoreTaskTid(task_key, child)) {
+    // Side-table full: the turn will run with no captured id. Counted, and the
+    // run side reports the miss - a lost capture is witnessed, never guessed.
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  char what[112];
+  std::snprintf(what, sizeof(what), "enqueue task=%llx",
+                static_cast<unsigned long long>(task_key));
+  EmitCausality(what, child, parent);
+}
+
+uint64_t CausalityEnterTask(uint64_t task_key) {
+  if (!CausalityEnabled()) return 0;
+  if (g_depth >= kScopeCap) {
+    g_imbalance.fetch_add(1, std::memory_order_relaxed);
+    ++g_skipped;
+    return 0;
+  }
+  uint64_t tid = task_key == kTaskKeyEmpty ? 0 : TakeTaskTid(task_key);
+  // Push the outgoing id even on a miss, so the exit always restores the true
+  // previous ambient - a miss must not leak this turn's (absent) id outward.
+  g_scope[g_depth++] = g_ambient;
+  if (tid == 0) {
+    g_misses.fetch_add(1, std::memory_order_relaxed);
+    char what[112];
+    std::snprintf(what, sizeof(what), "run-miss task=%llx",
+                  static_cast<unsigned long long>(task_key));
+    EmitCausality(what, 0, g_ambient);
+    return 0;
+  }
+  g_ambient = tid;
+  char what[112];
+  std::snprintf(what, sizeof(what), "run task=%llx",
+                static_cast<unsigned long long>(task_key));
+  EmitCausality(what, tid, 0);
+  return tid;
+}
+
+void CausalityExitTask(uint64_t task_key) {
+  if (!CausalityEnabled()) return;
+  char what[112];
+  std::snprintf(what, sizeof(what), "exit task=%llx",
+                static_cast<unsigned long long>(task_key));
+  if (g_skipped > 0) {
+    // Pairs with an enter that could NOT be installed (scope stack at
+    // kScopeCap): nothing was pushed, so nothing is restored. The counter alone
+    // is enough to pair them because, under the LIFO discipline, the skipped
+    // enters are always the innermost ones - their matching exits are the first
+    // to arrive back out.
+    --g_skipped;
+    EmitCausality(what, g_ambient, g_ambient);
+    return;
+  }
+  if (g_depth == 0) {
+    // An exit with no matching enter: a termination exception unwound past the
+    // enter hook, or a hook site fired out of order. Witnessed, and the ambient
+    // id is left alone rather than "restored" from an invented frame.
+    g_imbalance.fetch_add(1, std::memory_order_relaxed);
+    EmitCausality("exit-unbalanced", g_ambient, 0);
+    return;
+  }
+  uint64_t prev = g_scope[--g_depth];
+  // The record names the finishing id and the id being restored, so the Rust
+  // side can close the turn even if the matching `run` record was dropped.
+  EmitCausality(what, g_ambient, prev);
+  g_ambient = prev;
+}
+
+void CausalityNotePromise(uint64_t promise_key) {
+  if (!CausalityEnabled() || promise_key == kTaskKeyEmpty) return;
+  // Promise creation INHERITS the ambient trace rather than starting one: the
+  // async turns a promise schedules are its causal children, and those get
+  // their own ids when they are enqueued. Recording the promise's own identity
+  // against the ambient id is what lets the Rust side attach a `.then` edge to
+  // the promise object the fingerprint value was resolved into.
+  char what[112];
+  std::snprintf(what, sizeof(what), "promise-new promise=%llx",
+                static_cast<unsigned long long>(promise_key));
+  EmitCausality(what, g_ambient, 0);
+}
+
+size_t CausalityScopeDepth() { return g_depth; }
+
+void CausalityScopeReset(size_t depth) {
+  // Fold the honest-witness counters onto the wire here, on every drain exit.
+  // This is the one place that runs for EVERY drain on this thread regardless
+  // of how the drain ended (both `return`s in RunMicrotasks plus exception
+  // unwind, via CausalityDrainScope), so it is where the counters can be
+  // guaranteed to surface rather than stay as dead in-process state. Change-
+  // detected against the last snapshot, so a healthy build emits nothing and a
+  // lossy one emits at most once per distinct counter change - bounded, and it
+  // never adds a record to the hot path when there is nothing to report.
+  EmitWitnessIfChanged();
+
+  // Re-base the stack to {depth} and report anything left above it. A
+  // termination exception unwinds out of TF_BUILTIN(RunMicrotasks) without
+  // returning through the exit hook, so this is the guard that keeps a leak
+  // from poisoning every subsequent turn on the thread.
+
+  // Nothing leaked: depth already at/below base and no outstanding skipped
+  // enters. (g_skipped can be non-zero with g_depth <= depth if the stack
+  // filled to kScopeCap and then partially unwound - still a leak to report.)
+  if (g_depth <= depth && g_skipped == 0) return;
+  uint64_t lost = (g_depth > depth ? g_depth - depth : 0) + g_skipped;
+  g_imbalance.fetch_add(lost, std::memory_order_relaxed);
+  char what[112];
+  std::snprintf(what, sizeof(what), "scope-rebalance lost=%llu base=%llu",
+                static_cast<unsigned long long>(lost),
+                static_cast<unsigned long long>(depth));
+  EmitCausality(what, g_ambient, depth == 0 ? 0 : g_scope[depth - 1]);
+  // Clear BOTH counters: skipped enters have no matching frames on the stack,
+  // so leaving g_skipped non-zero would let a future legitimate exit be eaten.
+  g_depth = depth;
+  g_skipped = 0;
+  g_ambient = depth == 0 ? 0 : g_scope[depth - 1];
+  // The rebalance itself moved g_imbalance, so surface the new value now
+  // rather than waiting for the next drain to notice.
+  EmitWitnessIfChanged();
+}
+
+uint64_t CausalityDropped() {
+  return g_dropped.load(std::memory_order_relaxed);
+}
+
+uint64_t CausalityImbalance() {
+  return g_imbalance.load(std::memory_order_relaxed);
+}
+
+uint64_t CausalityMisses() { return g_misses.load(std::memory_order_relaxed); }
+
+uint64_t CausalityMinted() { return g_minted.load(std::memory_order_relaxed); }
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
diff --git a/v8/src/afeye/causality.h b/v8/src/afeye/causality.h
new file mode 100644
index 0000000..256be1b
--- /dev/null
+++ b/v8/src/afeye/causality.h
@@ -0,0 +1,161 @@
+#ifndef V8_AFEYE_CAUSALITY_H_
+#define V8_AFEYE_CAUSALITY_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+// afeye async causality graph (0031). The boundary sieve (sink.cc) and the
+// DTT shadow store (taint.h) both answer "which BYTES moved where"; neither
+// can answer "which async turn produced them". Correlating a fingerprint read
+// with the socket write that exfiltrates it by TIME WINDOW is a guess: on a
+// busy page hundreds of unrelated microtasks interleave inside any window, so
+// a time-window join both over-attributes (false edges) and under-attributes
+// (a chain that spans a slow await leaves the window entirely).
+//
+// This module carries an explicit 64-bit trace_id ACROSS async boundaries
+// instead. A trace_id is minted at a causal root and inherited by every async
+// turn that root schedules, so a record emitted deep inside a
+// `.then().then().catch()` chain - or inside an `await`ed resume - carries the
+// SAME id as the code that started the chain. The Rust side rebuilds the async
+// tree from the emitted `causality link` edges and can then state
+// "this socket write happened in the same causal turn as that canvas read"
+// as a PROVEN edge rather than a temporal coincidence.
+//
+// Propagation seam actually achieved (all sites verified at rev d1fed5cd7e3b):
+//   ENQUEUE  every microtask/promise-job schedule passes through exactly one
+//            of two funnels, both hooked:
+//              - MicrotaskQueue::EnqueueMicrotask(Tagged<Microtask>)
+//                (src/execution/microtask-queue.cc:157) - the single C++
+//                funnel; CallEnqueueMicrotask (:114), all three
+//                v8::Isolate::EnqueueMicrotask overloads (:123,:132,:145) and
+//                Runtime_EnqueueMicrotask (src/runtime/runtime-promise.cc:43)
+//                all route through it.
+//              - TF_BUILTIN(EnqueueMicrotask) fast path
+//                (src/builtins/builtins-microtask-queue-gen.cc:773-781), which
+//                writes the ring buffer directly in CSA and only falls back to
+//                the C++ funnel when the buffer must GROW (:785). This is the
+//                path every Torque promise reaction job takes
+//                (MorphAndEnqueuePromiseReaction, promise-abstract-operations
+//                .tq:122/:142, and PerformPromiseThenImpl .tq:504).
+//            At enqueue the ambient id becomes the PARENT; a fresh CHILD id is
+//            minted for the job, the edge is linked, and the child is stored in
+//            a side-table keyed by the tagged Microtask address.
+//   RUN      TF_BUILTIN(RunMicrotasks) drains one task per loop iteration
+//            (builtins-microtask-queue-gen.cc:881 RunSingleMicrotask). The
+//            child id is extracted from the side-table and installed as the
+//            ambient id for the whole job body, then the previous id is
+//            restored - so everything the body does (promises it creates, jobs
+//            it enqueues, sinks it writes) attributes to the correct turn.
+//   PROMISE  PromiseBuiltinsAssembler::AllocateJSPromise
+//            (src/builtins/builtins-promise-gen.cc:32) is the single JSPromise
