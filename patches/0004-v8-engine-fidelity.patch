   return DoFunctionBind(isolate, args, ProtoSource::kUseTargetPrototype);
 }
 
+#ifdef V8_AFEYE
+// afeye (v6): Function.prototype.toString is THE antifraud integrity-check
+// surface (native-code probes, eval'd-source diffs). We record WHO was
+// inspected (receiver's script:line, name) before the original runs - no
+// result tampering, pure observation. The receiver identity uses the same
+// v8::Function introspection the 0003 call-origin hook proved against this
+// tree.
+static void AfeyeLogToString(Isolate* isolate, DirectHandle<Object> recv) {
+  static std::atomic<uint64_t> g_afeye_fnts{0};
+  if (g_afeye_fnts.fetch_add(1, std::memory_order_relaxed) >= 2000000) {
+    return;
+  }
+  char afeye_buf[320];
+  v8::Isolate* afeye_api = reinterpret_cast<v8::Isolate*>(isolate);
+  v8::Local<v8::Value> afeye_rv;
+  if (!recv.is_null()) afeye_rv = v8::Utils::ToLocal(recv);
+  if (!afeye_rv.IsEmpty() && afeye_rv->IsFunction()) {
+    v8::Local<v8::Function> afeye_fn = afeye_rv.As<v8::Function>();
+    std::string afeye_name = "?";
+    std::string afeye_script = "native";
+    int afeye_line = 0;
+    v8::Local<v8::Value> afeye_nm = afeye_fn->GetName();
+    if (!afeye_nm.IsEmpty() && afeye_nm->IsString()) {
+      v8::String::Utf8Value afeye_nv(afeye_api,
+                                     afeye_nm.As<v8::String>());
+      if (*afeye_nv) {
+        size_t afeye_l = std::strlen(*afeye_nv);
+        if (afeye_l > 80) afeye_l = 80;
+        afeye_name.assign(*afeye_nv, afeye_l);
+      }
+    }
+    v8::ScriptOrigin afeye_o = afeye_fn->GetScriptOrigin();
+    v8::Local<v8::Value> afeye_rn = afeye_o.ResourceName();
+    if (!afeye_rn.IsEmpty() && afeye_rn->IsString()) {
+      v8::String::Utf8Value afeye_uv(afeye_api,
+                                     afeye_rn.As<v8::String>());
+      if (*afeye_uv) {
+        size_t afeye_l = std::strlen(*afeye_uv);
+        if (afeye_l > 200) afeye_l = 200;
+        afeye_script.assign(*afeye_uv, afeye_l);
+      }
+    }
+    afeye_line = afeye_fn->GetScriptLineNumber();
+    if (afeye_line < 0) afeye_line = 0;
+    std::snprintf(afeye_buf, sizeof(afeye_buf),
+                  "fnts name=%.80s script=%.200s:%d",
+                  afeye_name.c_str(), afeye_script.c_str(), afeye_line);
+  } else {
+    std::snprintf(afeye_buf, sizeof(afeye_buf), "fnts receiver=non-function");
+  }
+  v8::afeye::EmitStr(v8::afeye::kFnToString, v8::afeye::NowNs(), afeye_buf);
+}
+#endif
+
 // https://tc39.es/ecma262/#sec-function.prototype.tostring
 BUILTIN(FunctionPrototypeToString) {
   HandleScope scope(isolate);
   DirectHandle<Object> receiver = args.receiver();
+#ifdef V8_AFEYE
+  if (v8::afeye::Enabled()) {
+    AfeyeLogToString(isolate, receiver);
+  }
+#endif
   if (IsJSBoundFunction(*receiver)) {
     return *JSBoundFunction::ToString(isolate, Cast<JSBoundFunction>(receiver));
   }
