+#ifdef V8_AFEYE
+// afeye (v6): Function.prototype.toString is THE antifraud integrity-check
+// surface (native-code probes, eval'd-source diffs). We record WHO was
+// inspected (receiver's script:line, name) before the original runs - no
+// result tampering, pure observation. The receiver identity uses the same
+// v8::Function introspection the 0003 call-origin hook proved against this
+// tree.
+// Copies up to `cap` flat string bytes into `dst` under `no_gc`, sanitizing
+// to printable ASCII, NUL-terminating, and returning the copied length.
+// No allocation: reads straight off the String's flat content.
+static int AfeyeCopyString(Tagged<String> str, const DisallowGarbageCollection& no_gc,
+                           char* dst, uint32_t cap) {
+  String::FlatContent flat = str->GetFlatContent(no_gc);
+  if (!flat.IsFlat()) {
+    dst[0] = '\0';
+    return 0;
+  }
+  uint32_t len = flat.length();
+  if (len > cap) len = cap;
+  if (flat.IsOneByte()) {
+    const uint8_t* p = flat.ToOneByteVector().begin();
+    for (uint32_t k = 0; k < len; ++k) {
+      uint8_t c = p[k];
+      dst[k] = (c >= 0x20 && c < 0x7f) ? static_cast<char>(c) : '?';
+    }
+  } else {
+    const base::uc16* p = flat.ToUC16Vector().begin();
+    for (uint32_t k = 0; k < len; ++k) {
+      base::uc16 c = p[k];
+      dst[k] = (c >= 0x20 && c < 0x7f) ? static_cast<char>(c) : '?';
+    }
+  }
+  dst[len] = '\0';
+  return static_cast<int>(len);
+}
+
+static void AfeyeLogToString(Isolate* isolate, DirectHandle<Object> recv) {
+  static std::atomic<uint64_t> g_afeye_fnts{0};
+  if (g_afeye_fnts.fetch_add(1, std::memory_order_relaxed) >= 2000000) {
+    return;
+  }
+  char afeye_buf[320];
+  // NO-ALLOC (v8): toString is THE antifraud integrity surface and fires
+  // during the very checks the capture runs alongside. The previous body
+  // built a GetName()/GetScriptOrigin()/Utf8Value/std::string heap chain per
+  // call. This reads name + script + line off the Tagged<> heap objects under
+  // DisallowGarbageCollection - stack scratch only, no Local, no HandleScope,
+  // no heap buffer. Bound functions unwrap to their target so the record still
+  // names the real callee.
+  DisallowGarbageCollection no_gc;
+  Tagged<Object> afeye_recv = *recv;
+  // unwrap JSBoundFunction -> its target JSFunction (no allocation)
+  int afeye_hops = 0;
+  while (IsJSBoundFunction(afeye_recv) && afeye_hops < 8) {
+    afeye_recv = Cast<JSBoundFunction>(afeye_recv)->bound_target_function();
+    ++afeye_hops;
+  }
+  if (IsJSFunction(afeye_recv)) {
+    Tagged<SharedFunctionInfo> afeye_sfi = Cast<JSFunction>(afeye_recv)->shared();
+    char afeye_name[81];
+    int afeye_name_len =
+        AfeyeCopyString(afeye_sfi->Name(), no_gc, afeye_name, 80);
+    if (afeye_name_len == 0) {
+      afeye_name[0] = '?';
+      afeye_name[1] = '\0';
+      afeye_name_len = 1;
+    }
+    char afeye_script[201];
+    int afeye_script_len = 6;
+    int afeye_line = 0;
+    std::memcpy(afeye_script, "native", 7);
+    if (IsScript(afeye_sfi->script())) {
+      Tagged<Script> afeye_sc = Cast<Script>(afeye_sfi->script());
+      afeye_line = afeye_sc->GetLineNumber(afeye_sfi->StartPosition());
+      if (afeye_line < 0) afeye_line = 0;
+      if (IsString(afeye_sc->name())) {
+        int n = AfeyeCopyString(Cast<String>(afeye_sc->name()), no_gc,
+                                afeye_script, 200);
+        if (n > 0) afeye_script_len = n;
+      }
+    }
+    std::snprintf(afeye_buf, sizeof(afeye_buf), "fnts name=%.*s script=%.*s:%d",
+                  afeye_name_len, afeye_name, afeye_script_len, afeye_script,
+                  afeye_line);
+  } else {
+    std::snprintf(afeye_buf, sizeof(afeye_buf), "fnts receiver=non-function");
+  }
+  v8::afeye::EmitStr(v8::afeye::kFnToString, v8::afeye::NowNs(), afeye_buf);
+}
+#endif
+
 // https://tc39.es/ecma262/#sec-function.prototype.tostring
 BUILTIN(FunctionPrototypeToString) {
   HandleScope scope(isolate);
   DirectHandle<Object> receiver = args.receiver();
+#ifdef V8_AFEYE
+  if (v8::afeye::Enabled()) {
+    AfeyeLogToString(isolate, receiver);
+  }
+#endif
   if (IsJSBoundFunction(*receiver)) {
     return *JSBoundFunction::ToString(isolate, Cast<JSBoundFunction>(receiver));
   }
