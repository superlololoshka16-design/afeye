 // ES6 section 20.3.3.1 Date.now ( )
 BUILTIN(DateNow) {
   HandleScope scope(isolate);
+#ifdef V8_AFEYE
+  // afeye (v6): Date.now() is the clock every antifraud timing check reads.
+  // One record per call (capped) - the filter reads cadence from this.
+  if (v8::afeye::Enabled()) {
+    static std::atomic<uint64_t> g_afeye_clock{0};
+    static bool g_afeye_clock_off = []() {
+      const char* v = ::getenv("AFEYE_TRACE_CLOCK");
+      return v != nullptr && *v != '\0' && v[0] == '0';
+    }();
+    if (!g_afeye_clock_off &&
+        g_afeye_clock.fetch_add(1, std::memory_order_relaxed) < 2000000) {
+      v8::afeye::EmitStr(v8::afeye::kClock, v8::afeye::NowNs(),
+                         "clock date-now");
+    }
+  }
+#endif
   return *isolate->factory()->NewNumberFromInt64(
       JSDate::CurrentTimeValue(isolate));
 }
