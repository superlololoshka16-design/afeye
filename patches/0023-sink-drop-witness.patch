   size_t off = 0;
@@ -99,14 +101,46 @@ void EmitHello(int fd) {
   WriteAll(fd, rec, total);
 }
 
+void WriteDropReport(int fd, uint64_t dropped, uint64_t write_err) {
+  if (fd < 0) return;
+  char msg[128];
+  int n = std::snprintf(msg, sizeof(msg),
+                        "sink-drop layer=%s dropped=%llu write_err=%llu",
+                        kLayer, static_cast<unsigned long long>(dropped),
+                        static_cast<unsigned long long>(write_err));
+  if (n <= 0) return;
+  uint8_t rec[24 + 128];
+  uint32_t total = 24 + static_cast<uint32_t>(n);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = kSinkDrop;
+  rec[5] = 0;
+  std::memset(rec + 6, 0, 10);
+  uint64_t ts = MonoNs();
+  std::memcpy(rec + 16, &ts, sizeof(ts));
+  std::memcpy(rec + 24, msg, static_cast<size_t>(n));
+  WriteAll(fd, rec, total);
+}
+
+void AfeyeSignal(int) {
+  Flush(500);
+  WriteDropReport(g_report_fd.load(std::memory_order_relaxed),
+                  g_dropped.load(std::memory_order_relaxed),
+                  g_write_err.load(std::memory_order_relaxed));
+  _exit(0);
+}
+
 void DrainLoop() {
   char pid[16];
   std::snprintf(pid, sizeof(pid), "%d", static_cast<int>(::getpid()));
   std::string path = std::string(RawDir()) + "/" + kLayer + "-" + pid + ".rec";
   int fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+  g_report_fd.store(fd, std::memory_order_relaxed);
   if (fd >= 0) EmitHello(fd);
   static thread_local std::vector<uint8_t> buf;
   buf.resize(kMaxRecord);
+  uint64_t reported_drops = 0;
+  uint64_t reported_werr = 0;
+  uint64_t last_report_ns = 0;
   for (;;) {
     size_t len = 0;
     bool have = false;
@@ -139,15 +173,30 @@ void DrainLoop() {
         if (g_write_err.load(std::memory_order_relaxed) != werr_before) {
           ::close(fd);
           fd = -1;
+          g_report_fd.store(-1, std::memory_order_relaxed);
         }
       }
       if (fd < 0) {
         fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+        g_report_fd.store(fd, std::memory_order_relaxed);
         if (fd >= 0) EmitHello(fd);
       }
     } else {
       std::this_thread::sleep_for(std::chrono::microseconds(500));
     }
+    const uint64_t now_dropped = g_dropped.load(std::memory_order_relaxed);
+    const uint64_t now_werr = g_write_err.load(std::memory_order_relaxed);
+    if (now_dropped != reported_drops || now_werr != reported_werr) {
+      const uint64_t now_ns = MonoNs();
+      if (now_ns - last_report_ns >= 100ull * 1000ull * 1000ull) {
+        WriteDropReport(fd, now_dropped, now_werr);
+        if (fd >= 0) {
+          reported_drops = now_dropped;
+          reported_werr = now_werr;
+          last_report_ns = now_ns;
+        }
+      }
+    }
   }
 }
 
@@ -167,6 +216,13 @@ void InitOnce() {
   g_on.store(true, std::memory_order_release);
   g_pid.store(::getpid(), std::memory_order_release);
   std::thread(DrainLoop).detach();
+  struct sigaction sa;
+  std::memset(&sa, 0, sizeof(sa));
+  sa.sa_handler = AfeyeSignal;
+  sigemptyset(&sa.sa_mask);
+  sigaction(SIGTERM, &sa, nullptr);
+  sigaction(SIGINT, &sa, nullptr);
+  sigaction(SIGHUP, &sa, nullptr);
   std::atexit([] { Flush(500); });
 }
 
