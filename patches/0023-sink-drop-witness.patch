diff --git a/services/network/afeye_sink.cc b/services/network/afeye_sink.cc
index 84e4952..7e5ec4b 100644
--- a/services/network/afeye_sink.cc
+++ b/services/network/afeye_sink.cc
@@ -96,6 +96,25 @@ void EmitHello(int fd) {
   WriteAll(fd, rec, total);
 }
 
+void WriteDropReport(int fd, uint64_t dropped) {
+  if (fd < 0) return;
+  char msg[96];
+  int n = std::snprintf(msg, sizeof(msg), "sink-drop layer=%s dropped=%llu",
+                        kLayer, static_cast<unsigned long long>(dropped));
+  if (n <= 0) return;
+  uint8_t rec[16 + 96];
+  uint32_t total = 16 + static_cast<uint32_t>(n);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = kSinkDrop;
+  rec[5] = 0;
+  rec[6] = 0;
+  rec[7] = 0;
+  uint64_t ts = MonoNs();
+  std::memcpy(rec + 8, &ts, sizeof(ts));
+  std::memcpy(rec + 16, msg, static_cast<size_t>(n));
+  WriteAll(fd, rec, total);
+}
+
 void DrainLoop() {
   char pid[16];
   std::snprintf(pid, sizeof(pid), "%d", static_cast<int>(::getpid()));
@@ -104,6 +123,8 @@ void DrainLoop() {
   if (fd >= 0) EmitHello(fd);
   static thread_local std::vector<uint8_t> buf;
   buf.resize(kMaxRecord);
+  uint64_t reported_drops = 0;
+  uint64_t last_report_ns = 0;
   for (;;) {
     size_t len = 0;
     bool have = false;
@@ -145,6 +166,17 @@ void DrainLoop() {
     } else {
       std::this_thread::sleep_for(std::chrono::microseconds(500));
     }
+    const uint64_t now_dropped = g_dropped.load(std::memory_order_relaxed);
+    if (now_dropped != reported_drops) {
+      const uint64_t now_ns = MonoNs();
+      if (now_ns - last_report_ns >= 100ull * 1000ull * 1000ull) {
+        WriteDropReport(fd, now_dropped);
+        if (fd >= 0) {
+          reported_drops = now_dropped;
+          last_report_ns = now_ns;
+        }
+      }
+    }
   }
 }
 
