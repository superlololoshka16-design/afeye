+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off &&
+         g_afeye_rtc.fetch_add(1, std::memory_order_relaxed) < 200000;
+}
+inline void AfeyeEmitWire(const char* tag, const uint8_t* data, size_t len) {
+  if (len == 0 || !AfeyeWireOn()) return;
+  afeye::EmitSpan(afeye::kWebSocket, afeye::NowNs(), tag, data,
