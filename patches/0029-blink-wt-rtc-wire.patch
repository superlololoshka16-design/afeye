+// true transport identity. Records are spans (tag\\0bytes) so the Rust
+// content graph links them by byte identity like every other payload.
+// Per-TU throttle + env gate (house pattern 0013/0021/0026): a long-lived
+// session cannot drown the ring; AFEYE_TRACE_WT_RTC=0 disables entirely.
+// EmitSpan caps each record at kSpanCap (64 KiB) internally.
+std::atomic<uint64_t> g_afeye_rtc{0};
+inline bool AfeyeWireOn() {
+  static const bool off = []() {
