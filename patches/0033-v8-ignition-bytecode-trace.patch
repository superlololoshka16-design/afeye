+// ---- record formats (little-endian, fixed layout, zero heap) ----
+//
+// instruction record:
+//   [0]  u8   opcode (post-prefix; Wide/ExtraWide resolved via scale arg)
+//   [1]  u8   operand_scale raw enum value (1/2/4)
+//   [2]  u8   n_payload (0..7)
+//   [3]  u8   flags (bit0=func-def, bit1=payload truncated at cap)
+//   [4]  u32  bytecode offset (logical, instruction start)
+//   [8]  u32  func_id (SFI pointer hash, stable per function per run)
+//   [12] u32  source line (func-def only)
+//   [16] u64  accumulator RAW tagged word
+//   [24] u64[6] input register RAW tagged words (operand order)
+//   then n_payload blocks, u16 len + raw bytes:
+//     String register/acc value -> verbatim bytes (cap 256)
+//     HeapNumber acc -> 8 raw f64 bits
+//     Smi acc -> 4 raw int32 bits
+//     order: String regs first, then acc payload
+//
+// func-def record (flags bit0, opcode 0xff), once per BytecodeArray:
+//   hdr (func_id, line) + u32 bc_len + u32 name_len +
+//   RAW bytecode bytes + script name bytes
+//
+// meta record (opcode 0xfe), once per process:
+//   u16 n_bytecodes, then per bytecode:
+//     name\0, u8 n_ops, u8 op_flags (bit0=jump bit1=returns bit2=calls)
+//     then per scale in {kSingle,kDouble,kQuadruple}, per operand:
+//       u8 operand_type, u8 size, u8 offset
+//   The Rust decoder uses THESE tables (sizes/offsets straight from the
+//   engine) - no hardcoded tables, no drift on v8 bumps.
+struct AfeyeBcHdr {
+  uint8_t opcode;
+  uint8_t scale;
+  uint8_t n_payload;
+  uint8_t flags;
+  uint32_t offset;
+  uint32_t func_id;
+  uint32_t line;
+  uint64_t acc;
+  uint64_t regs[6];
+};
+static_assert(sizeof(AfeyeBcHdr) == 72, "fixed record layout");
+
+constexpr uint32_t kAfeyeStrCap = 256;
+constexpr int kAfeyeMaxRegs = 6;
+constexpr int kAfeyeMaxPayload = kAfeyeMaxRegs + 1;
+
+std::atomic<uint64_t> g_afeye_bc_n{0};
+
+bool AfeyeBcOff() {
+  static bool off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_BYTECODE");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return off;
+}
+
+uint64_t AfeyeBcCap() {
+  static uint64_t cap = []() {
+    const char* v = ::getenv("AFEYE_BC_CAP");
+    unsigned long long n = v ? strtoull(v, nullptr, 10) : 0;
+    return n > 0 ? static_cast<uint64_t>(n) : 50000000ull;
+  }();
+  return cap;
+}
+
+bool AfeyeVclockOn() {
+  static bool on = []() {
+    const char* v = ::getenv("AFEYE_VIRTUAL_CLOCK");
+    return v != nullptr && *v != '\0' && v[0] != '0';
+  }();
+  return on;
+}
+
+uint64_t AfeyeVclockNsPerInstr() {
+  static uint64_t n = []() {
+    const char* v = ::getenv("AFEYE_VCLOCK_NS_PER_INSTR");
+    unsigned long long x = v ? strtoull(v, nullptr, 10) : 0;
+    return x > 0 ? x : 10ull;
+  }();
+  return n;
+}
+
+uint32_t AfeyeFuncId(Tagged<SharedFunctionInfo> sfi) {
+  uintptr_t w = reinterpret_cast<uintptr_t>(sfi.ptr()) >> 2;
+  return static_cast<uint32_t>((w * 2654435761u) >> 16);
+}
+
+// func-def dedupe: open-addressed table of seen BytecodeArray addresses.
+// 16k slots, linear probe, CAS insert, no alloc, no lock.
+struct AfeyeSeen {
+  static constexpr size_t kSlots = 16384;
+  std::atomic<uintptr_t> slots[kSlots];
+  bool InsertOrExists(uintptr_t key) {
+    size_t h = (key >> 4) & (kSlots - 1);
+    for (size_t i = 0; i < 64; ++i) {
+      size_t idx = (h + i) & (kSlots - 1);
+      uintptr_t cur = slots[idx].load(std::memory_order_acquire);
+      if (cur == key) return true;
+      if (cur == 0) {
+        uintptr_t expected = 0;
+        if (slots[idx].compare_exchange_strong(expected, key,
+                                               std::memory_order_acq_rel)) {
+          return false;
+        }
+        if (expected == key) return true;
+      }
+    }
+    return true;
+  }
+};
+AfeyeSeen g_afeye_seen;
+
+uint32_t AfeyeStringBytes(Tagged<Object> obj, uint8_t* out,
+                          const DisallowGarbageCollection& no_gc) {
+  if (!IsString(obj)) return 0;
+  Tagged<String> str = Cast<String>(obj);
+  String::FlatContent fc = str->GetFlatContent(no_gc);
+  if (!fc.IsFlat()) return 0;
+  if (fc.IsOneByte()) {
+    base::Vector<const uint8_t> v = fc.ToOneByteVector();
+    uint32_t n = v.length() > kAfeyeStrCap ? kAfeyeStrCap : v.length();
+    std::memcpy(out, v.begin(), n);
+    return n;
+  }
+  base::Vector<const base::uc16> v = fc.ToUC16Vector();
+  uint32_t n = v.length() > kAfeyeStrCap ? kAfeyeStrCap : v.length();
+  for (uint32_t i = 0; i < n; ++i) out[i] = static_cast<uint8_t>(v[i]);
+  return n;
+}
+
+// meta: engine tables, once per process. thread_local vector = one
+// allocation per process lifetime, not per instruction.
+void AfeyeEmitMeta() {
+  static std::atomic<bool> done{false};
+  bool expected = false;
+  if (!done.compare_exchange_strong(expected, true)) return;
+
+  static thread_local std::vector<uint8_t> buf;
+  buf.clear();
+  buf.resize(2 + 1024 * 1024);
+  uint8_t* p = buf.data();
+  uint16_t n_bc = static_cast<uint16_t>(interpreter::Bytecodes::kBytecodeCount);
+  std::memcpy(p, &n_bc, 2);
+  p += 2;
+  // register-file origin: index = reg_start - operand. Lets the Rust
+  // decoder name registers r0/r1/... with no guesswork.
+  int32_t reg_start = interpreter::Register::kRegisterFileStartOffset;
+  std::memcpy(p, &reg_start, 4);
+  p += 4;
+
+  const interpreter::OperandScale scales[3] = {
+      interpreter::OperandScale::kSingle,
+      interpreter::OperandScale::kDouble,
+      interpreter::OperandScale::kQuadruple};
+
+  for (int b = 0; b < interpreter::Bytecodes::kBytecodeCount; ++b) {
+    interpreter::Bytecode bc = interpreter::Bytecodes::FromByte(
+        static_cast<uint8_t>(b));
+    const char* nm = interpreter::Bytecodes::ToString(bc);
+    size_t nl = std::strlen(nm);
+    std::memcpy(p, nm, nl);
+    p += nl;
+    *p++ = 0;
+    int nops = interpreter::Bytecodes::NumberOfOperands(bc);
+    *p++ = static_cast<uint8_t>(nops);
+    uint8_t opf = 0;
+    if (interpreter::Bytecodes::IsJump(bc)) opf |= 1;
+    if (interpreter::Bytecodes::Returns(bc)) opf |= 2;
+    if (interpreter::Bytecodes::MakesCallAlongCriticalPath(bc)) opf |= 4;
+    // jump subtype so the Rust CFG resolves targets with v8's exact
+    // semantics, not a guess:
+    //   bits 3-4: 1 = immediate forward (target = offset + imm)
+    //             2 = JumpLoop backward (target = offset - imm)
+    //             3 = constant-pool (JumpIfTrueConstant etc: target is a
+    //                 Smi in the pool at cp[imm])
+    //             4 = switch table (targets in pool, table_start/size)
+    //   bit 5: conditional (has a fall-through edge)
+    if (interpreter::Bytecodes::IsJump(bc)) {
+      if (bc == interpreter::Bytecode::kJumpLoop) {
+        opf |= 2 << 3;
+      } else if (interpreter::Bytecodes::IsJumpImmediate(bc)) {
+        opf |= 1 << 3;
+      } else if (interpreter::Bytecodes::IsJumpConstant(bc)) {
+        opf |= 3 << 3;
+      } else {
+        opf |= 4 << 3;  // SwitchOnSmiNoFeedback / SwitchOnGeneratorState
+      }
+      if (bc != interpreter::Bytecode::kJump &&
+          bc != interpreter::Bytecode::kJumpLoop) {
+        opf |= 1 << 5;  // everything but unconditional jumps falls through
+      }
+    }
+    *p++ = opf;
+    // implicit accumulator use: bit1 = writes acc (so the NEXT executed
+    // instruction's acc field is THIS instruction's result - the engine's
+    // own dataflow edge, not a guess), bit0 = reads acc, bit2 = clobbers.
+    *p++ = static_cast<uint8_t>(
+        interpreter::Bytecodes::GetImplicitRegisterUse(bc));
+    for (int sc = 0; sc < 3; ++sc) {
+      // total instruction size at this scale, then per-operand
+      // (type, offset). Operand WIDTH = next_offset - offset (last
+      // operand: total_size - offset). All from engine tables - the
+      // Rust decoder never hardcodes a layout.
+      *p++ = static_cast<uint8_t>(
+          interpreter::Bytecodes::Size(bc, scales[sc]));
+      for (int i = 0; i < nops; ++i) {
+        interpreter::OperandType ot =
+            interpreter::Bytecodes::GetOperandType(bc, i);
+        *p++ = static_cast<uint8_t>(ot);
+        *p++ = static_cast<uint8_t>(
+            interpreter::Bytecodes::GetOperandOffset(bc, i, scales[sc]));
+      }
+    }
+  }
+  // runtime function name table: id -> C-string. Resolves CallRuntime
+  // operands (RuntimeId) to the actual runtime function name.
+  {
+    uint16_t n_rt = static_cast<uint16_t>(Runtime::kNumFunctions);
+    std::memcpy(p, &n_rt, 2);
+    p += 2;
+    for (int id = 0; id < Runtime::kNumFunctions; ++id) {
+      const Runtime::Function* f =
+          Runtime::FunctionForId(static_cast<Runtime::FunctionId>(id));
+      const char* rnm = (f && f->name) ? f->name : "";
+      size_t rl = std::strlen(rnm);
+      std::memcpy(p, rnm, rl);
+      p += rl;
+      *p++ = 0;
+    }
+  }
+  uint8_t hdr[4] = {0xfe, 0, 0, 0};
+  // meta = its own record: 4-byte tag header then the table blob
+  static thread_local std::vector<uint8_t> rec;
+  rec.resize(4 + static_cast<size_t>(p - buf.data()));
+  std::memcpy(rec.data(), hdr, 4);
+  std::memcpy(rec.data() + 4, buf.data(), static_cast<size_t>(p - buf.data()));
+  v8::afeye::Emit(v8::afeye::kBytecodeTrace, v8::afeye::NowNs(), rec.data(),
+                  static_cast<uint32_t>(rec.size()));
+}
+
+void AfeyeEmitFuncDef(Tagged<BytecodeArray> arr,
+                      Tagged<SharedFunctionInfo> sfi,
+                      const DisallowGarbageCollection& no_gc) {
+  int bc_len = arr->length();
+  if (bc_len <= 0 || bc_len > 900 * 1024) return;
+
+  char sc_buf[161];
+  uint32_t sc_len = 6;
+  std::memcpy(sc_buf, "native", 6);
+  int line = 0;
+  if (IsScript(sfi->script())) {
+    Tagged<Script> sc = Cast<Script>(sfi->script());
+    line = sc->GetLineNumber(sfi->StartPosition());
+    if (line < 0) line = 0;
+    Tagged<Object> nm = sc->name();
+    if (IsString(nm)) {
+      String::FlatContent fc = Cast<String>(nm)->GetFlatContent(no_gc);
+      if (fc.IsFlat() && fc.IsOneByte()) {
+        uint32_t l = fc.length();
+        if (l > 160) l = 160;
+        const uint8_t* src = fc.ToOneByteVector().begin();
+        for (uint32_t i = 0; i < l; ++i) {
+          sc_buf[i] = (src[i] >= 0x20 && src[i] < 0x7f)
+                          ? static_cast<char>(src[i])
+                          : '?';
+        }
+        sc_len = l;
+      }
+    }
+  }
+
+  // constant pool: LdaConstant reads the challenge's string literals and
+  // numbers from here - without it the Rust side cannot resolve operands.
+  // Raw words verbatim; Strings as bytes; HeapNumbers as f64 bits.
+  Tagged<TrustedFixedArray> cp_arr = arr->constant_pool();
+  int cp_len = cp_arr.length();
+  if (cp_len < 0) cp_len = 0;
+  if (cp_len > 65535) cp_len = 65535;
+
+  static thread_local std::vector<uint8_t> def_buf;
+  static thread_local std::vector<uint8_t> cp_buf;
+  cp_buf.clear();
+  cp_buf.resize(static_cast<size_t>(cp_len) * (3 + kAfeyeStrCap + 8));
+  uint8_t* cp = cp_buf.data();
+  for (int i = 0; i < cp_len; ++i) {
+    Tagged<Object> cv = cp_arr.get(i);
+    if (IsString(cv)) {
+      *cp++ = 1;
+      uint32_t sl = AfeyeStringBytes(cv, cp + 2, no_gc);
+      uint16_t sl16 = static_cast<uint16_t>(sl);
+      std::memcpy(cp, &sl16, 2);
+      cp += 2 + sl;
+    } else if (IsHeapNumber(cv)) {
+      *cp++ = 2;
+      double d = Cast<HeapNumber>(cv)->value();
+      uint64_t bits;
+      std::memcpy(&bits, &d, 8);
+      cp += 8;
+      std::memcpy(cp - 8, &bits, 8);
+    } else {
+      *cp++ = 0;
+      uint64_t w = static_cast<uint64_t>(cv.ptr());
+      std::memcpy(cp, &w, 8);
+      cp += 8;
+    }
+  }
+  uint32_t cp_total = static_cast<uint32_t>(cp - cp_buf.data());
+
+  def_buf.resize(sizeof(AfeyeBcHdr) + 12 + static_cast<size_t>(bc_len) +
+                 sc_len + cp_total);
+  AfeyeBcHdr* hdr = reinterpret_cast<AfeyeBcHdr*>(def_buf.data());
+  std::memset(hdr, 0, sizeof(*hdr));
+  hdr->opcode = 0xff;
+  hdr->flags = 1;
+  hdr->func_id = AfeyeFuncId(sfi);
+  hdr->line = static_cast<uint32_t>(line);
+  // def-record field overload: offset = frame_size, acc = parameter_count.
+  hdr->offset = static_cast<uint32_t>(arr->frame_size());
+  hdr->acc = static_cast<uint64_t>(arr->parameter_count());
+  uint8_t* p = def_buf.data() + sizeof(AfeyeBcHdr);
+  uint32_t bl = static_cast<uint32_t>(bc_len);
+  std::memcpy(p, &bl, 4);
+  std::memcpy(p + 4, &sc_len, 4);
+  std::memcpy(p + 8, &cp_total, 4);
+  p += 12;
+  std::memcpy(p,
+              reinterpret_cast<const void*>(arr->GetFirstBytecodeAddress()),
+              static_cast<size_t>(bc_len));
+  p += bc_len;
+  std::memcpy(p, sc_buf, sc_len);
+  p += sc_len;
+  std::memcpy(p, cp_buf.data(), cp_total);
+  p += cp_total;
+  v8::afeye::Emit(v8::afeye::kBytecodeTrace, v8::afeye::NowNs(),
+                  def_buf.data(), static_cast<uint32_t>(p - def_buf.data()));
+}
