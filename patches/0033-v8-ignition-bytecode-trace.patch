index 0000000..4d0d53d
--- /dev/null
+++ b/v8/src/afeye/bcrec.h
@@ -0,0 +1,380 @@
+#ifndef V8_AFEYE_BCREC_H_
+#define V8_AFEYE_BCREC_H_
+
+// afeye 0033 bytecode-trace wire format. Header-only, ZERO v8
+// dependencies by design: tools/bcrec_main.cc compiles this standalone
+// and tests/bcrec_roundtrip.rs round-trips its output through the Rust
+// decoder, so encoder and decoder are proven to agree byte-for-byte
+// WITHOUT building chromium. runtime-trace.cc feeds the same builders
+// with engine-extracted values - one implementation of the format.
+//
+// No limits anywhere: every executed instruction is recorded, operand
+// values are decoded BY THE ENGINE and emitted verbatim, string payloads
+// are emitted in full (8-bit or UTF-16LE, tag-distinguished), and any
+// record larger than one sink slot is split into kFlagCont parts that
+// the consumer reassembles byte-exactly. Nothing is truncated, capped or
+// silently dropped.
+
+#include <stdint.h>
+#include <string.h>
+
+#include <vector>
+
+namespace v8 {
+namespace afeye {
+namespace bcrec {
+
+constexpr uint8_t kKind = 40;  // sink.h kBytecodeTrace
+
+// Record header. 72 bytes, little-endian, no padding.
+struct Hdr {
+  uint8_t opcode;    // post-prefix opcode byte.
+                     // 0xff = func-def part, 0xfe = meta part,
+                     // else the executed instruction's opcode
+  uint8_t scale;     // raw OperandScale enum value (1/2/4)
+  uint8_t n_payload; // payload blocks in this part (saturates at 255;
+                     // consumers parse blocks structurally to part end)
+  uint8_t flags;     // kFlag* below
+  uint32_t offset;   // instruction: logical bytecode offset (same on all
+                     // parts of one record - the glue key).
+                     // func-def: byte position of this part in the blob.
+                     // meta: part position, same scheme.
+  uint32_t func_id;  // deterministic identity, see MakeFuncId. GC-stable:
+                     // identical for every record of one function.
+  uint32_t line;     // instruction: isolate tag (result attribution must
+                     // not cross isolates when workers share a pid).
+                     // func-def: function start line. meta: 0.
+  uint64_t acc;      // instruction: raw tagged accumulator word.
+                     // func-def/meta: total blob length in bytes.
+  uint64_t regs[6];  // first six input-register raw tagged words
+};
+static_assert(sizeof(Hdr) == 72, "bcrec Hdr must be exactly 72 bytes");
+
+constexpr uint8_t kFlagFuncDef = 1u << 0;
+constexpr uint8_t kFlagCont = 1u << 1;     // MORE PARTS FOLLOW this one
+constexpr uint8_t kFlagAccPayload = 1u << 2;
+constexpr uint8_t kOpFuncDef = 0xff;
+constexpr uint8_t kOpMeta = 0xfe;
+
+// Payload block framing: [u8 tag][u32 len][len bytes]. Decode is
+// tag-driven - a type is NEVER inferred from byte length.
+enum PayloadTag : uint8_t {
+  kTagAccStr = 0,     // accumulator String, 8-bit bytes
+  kTagAccF64 = 1,     // accumulator HeapNumber, 8 raw f64 bits
+  kTagAccSmi = 2,     // accumulator Smi, 4 raw int32 bits
+  kTagReg = 3,        // [u16 reg_index][u64 raw tagged word]
+  kTagRegStr = 4,     // [u16 reg_index][8-bit string bytes]
+  kTagRegF64 = 5,     // [u16 reg_index][8 f64 bits]
+  kTagRegSmi = 6,     // [u16 reg_index][4 int32 bits]
+  kTagOperand = 7,    // [u8 operand_index][u64 engine-decoded value].
+                      // For register-typed operands the value is the
+                      // register index (signed, as the engine decoded).
+  kTagCpStr = 8,      // func-def blob only (see CpSpan)
+  kTagCpF64 = 9,
+  kTagCpRaw = 10,
+  kTagAccStr16 = 11,  // accumulator String, UTF-16LE bytes
+  kTagRegStr16 = 12,  // [u16 reg_index][UTF-16LE bytes]
+  kTagVclock = 14,    // [u64 virtual clock ns] - present only when
+                      // AFEYE_VIRTUAL_CLOCK=1; gives every instruction a
+                      // timestamp_virtual = cost*instruction_count, on top
+                      // of the physical sink ts. Distinct from cp tag 13.
+};
+
+constexpr uint32_t kBlockPrefixSize = 5;  // tag(1) + len(4)
+
+// One sink record carries at most this payload; larger records split.
+// sink kMaxRecord is 1MiB, wire header is 16 bytes.
+constexpr uint32_t kSinkRecordCap = (1u << 20) - 16;
+
+inline void PutU16(uint8_t* p, uint16_t v) { memcpy(p, &v, 2); }
+inline void PutU32(uint8_t* p, uint32_t v) { memcpy(p, &v, 4); }
+inline void PutI32(uint8_t* p, int32_t v) { memcpy(p, &v, 4); }
+inline void PutU64(uint8_t* p, uint64_t v) { memcpy(p, &v, 8); }
+
+inline uint16_t GetU16(const uint8_t* p) {
+  uint16_t v;
+  memcpy(&v, p, 2);
+  return v;
+}
+inline uint32_t GetU32(const uint8_t* p) {
+  uint32_t v;
+  memcpy(&v, p, 4);
+  return v;
+}
+inline int32_t GetI32(const uint8_t* p) {
+  int32_t v;
+  memcpy(&v, p, 4);
+  return v;
+}
+inline uint64_t GetU64(const uint8_t* p) {
+  uint64_t v;
+  memcpy(&v, p, 8);
+  return v;
+}
+
+// Deterministic function identity from GC-immovable facts only: script
+// id, function literal id, source start position, isolate tag. The same
+// function hashes identically for the whole run even if the SFI moves.
+inline uint32_t MakeFuncId(int32_t script_id, int32_t literal_id,
+                           int32_t start_pos, uint32_t isolate_tag) {
+  uint8_t tmp[16];
+  PutI32(tmp, script_id);
+  PutI32(tmp + 4, literal_id);
+  PutI32(tmp + 8, start_pos);
+  PutU32(tmp + 12, isolate_tag);
+  uint64_t h = 1469598103934665603ull;  // FNV-1a over the 16 bytes
+  for (int i = 0; i < 16; ++i) {
+    h ^= tmp[i];
+    h *= 1099511628211ull;
+  }
+  return static_cast<uint32_t>(h >> 16);
+}
+
+// Append one framed block. No length cap - u32 len covers any JS string.
+inline void AppendBlock(std::vector<uint8_t>* out, uint8_t tag,
+                        const void* data, size_t n) {
+  size_t at = out->size();
+  out->resize(at + kBlockPrefixSize + n);
+  uint8_t* p = out->data() + at;
+  p[0] = tag;
+  PutU32(p + 1, static_cast<uint32_t>(n));
+  if (n != 0) memcpy(p + kBlockPrefixSize, data, n);
+}
+
+// ---- instruction record builder ----
+class InstrBuilder {
+ public:
+  void Begin(uint8_t opcode, uint8_t scale, uint32_t offset, uint32_t func_id,
+             uint32_t iso_tag, uint64_t acc_word) {
+    memset(&hdr_, 0, sizeof(hdr_));
+    hdr_.opcode = opcode;
+    hdr_.scale = scale;
+    hdr_.offset = offset;
+    hdr_.func_id = func_id;
+    hdr_.line = iso_tag;
+    hdr_.acc = acc_word;
+    payload_.clear();
+    blocks_ = 0;
+    n_regs_ = 0;
+  }
+
+  void Operand(uint8_t index, uint64_t value) {
+    uint8_t b[9];
+    b[0] = index;
+    PutU64(b + 1, value);
+    AppendBlock(&payload_, kTagOperand, b, sizeof(b));
+    ++blocks_;
+  }
+
+  void Reg(uint16_t index, uint64_t word) {
+    uint8_t b[10];
+    PutU16(b, index);
+    PutU64(b + 2, word);
+    AppendBlock(&payload_, kTagReg, b, sizeof(b));
+    ++blocks_;
+    if (n_regs_ < 6) hdr_.regs[n_regs_++] = word;
+  }
+
+  void RegStr(uint16_t index, const uint8_t* bytes, uint32_t n, bool utf16) {
+    std::vector<uint8_t> b(2 + n);
+    PutU16(b.data(), index);
+    if (n) memcpy(b.data() + 2, bytes, n);
+    AppendBlock(&payload_, utf16 ? kTagRegStr16 : kTagRegStr, b.data(),
+                b.size());
+    ++blocks_;
+  }
+
+  void RegF64(uint16_t index, uint64_t bits) {
+    uint8_t b[10];
+    PutU16(b, index);
+    PutU64(b + 2, bits);
+    AppendBlock(&payload_, kTagRegF64, b, sizeof(b));
+    ++blocks_;
+  }
+
+  void RegSmi(uint16_t index, int32_t v) {
+    uint8_t b[6];
+    PutU16(b, index);
+    PutI32(b + 2, v);
+    AppendBlock(&payload_, kTagRegSmi, b, sizeof(b));
+    ++blocks_;
+  }
+
+  void AccStr(const uint8_t* bytes, uint32_t n, bool utf16) {
+    AppendBlock(&payload_, utf16 ? kTagAccStr16 : kTagAccStr, bytes, n);
+    ++blocks_;
+    hdr_.flags |= kFlagAccPayload;
+  }
+  void AccF64(uint64_t bits) {
+    uint8_t b[8];
+    PutU64(b, bits);
+    AppendBlock(&payload_, kTagAccF64, b, sizeof(b));
+    ++blocks_;
+    hdr_.flags |= kFlagAccPayload;
+  }
+  void AccSmi(int32_t v) {
+    uint8_t b[4];
+    PutI32(b, v);
+    AppendBlock(&payload_, kTagAccSmi, b, sizeof(b));
+    ++blocks_;
+    hdr_.flags |= kFlagAccPayload;
+  }
+
+  void Vclock(uint64_t ns) {
+    uint8_t b[8];
+    PutU64(b, ns);
+    AppendBlock(&payload_, kTagVclock, b, sizeof(b));
+    ++blocks_;
+  }
+
+  const uint8_t* payload() const { return payload_.data(); }
+  size_t payload_len() const { return payload_.size(); }
+  Hdr FinishHdr() {
+    hdr_.n_payload = blocks_ > 255 ? 255 : static_cast<uint8_t>(blocks_);
+    return hdr_;
+  }
+
+ private:
+  Hdr hdr_;
+  std::vector<uint8_t> payload_;
+  uint32_t blocks_ = 0;
+  int n_regs_ = 0;
+};
+
+// ---- func-def blob ----
+// [u32 bc_len][u32 name_len][u32 cp_bytes][i32 frame_size]
+// [u32 param_count] | bc bytes | name bytes | cp entries
+// cp entry: framed block, tag kCpTag* (see PayloadTag; string tags carry
+// bytes, kCpTagF64/kCpTagRaw carry 8 raw bytes).
+constexpr uint8_t kCpTagStr = 8;
+constexpr uint8_t kCpTagF64 = 9;
+constexpr uint8_t kCpTagRaw = 10;
+constexpr uint8_t kCpTagStr16 = 13;
+
+struct CpSpan {
+  uint8_t tag;
+  const uint8_t* data;  // string bytes, or 8-byte f64/raw word
+  uint32_t len;         // string byte length; 8 for f64/raw
+};
+
+class FuncDefBuilder {
+ public:
+  // head (32 bytes): [u32 bc_len][u32 script_name_len][u32 fn_name_len]
+  //   [u32 cp_bytes][i32 frame_size][u32 param_count][i32 script_id]
+  //   [u32 _reserved]
+  // body: | bc | script name | JS function name | cp entries |
+  void Build(const uint8_t* bc, uint32_t bc_len, const uint8_t* script_name,
+             uint32_t script_name_len, const uint8_t* fn_name,
+             uint32_t fn_name_len, int32_t script_id, int32_t frame_size,
+             uint32_t param_count, const CpSpan* cp, uint32_t cp_count) {
+    blob_.clear();
+    cp_.clear();
+    for (uint32_t i = 0; i < cp_count; ++i) {
+      if (cp[i].tag == kCpTagStr || cp[i].tag == kCpTagStr16) {
+        AppendBlock(&cp_, cp[i].tag, cp[i].data, cp[i].len);
+      } else {
+        AppendBlock(&cp_, cp[i].tag, cp[i].data, 8);
+      }
+    }
+    const size_t head = 32;
+    blob_.resize(head);
+    uint8_t* h = blob_.data();
+    PutU32(h, bc_len);
+    PutU32(h + 4, script_name_len);
+    PutU32(h + 8, fn_name_len);
+    PutU32(h + 12, static_cast<uint32_t>(cp_.size()));
+    PutI32(h + 16, frame_size);
+    PutU32(h + 20, param_count);
+    PutI32(h + 24, script_id);
+    PutU32(h + 28, 0);  // reserved
+    blob_.insert(blob_.end(), bc, bc + bc_len);
+    blob_.insert(blob_.end(), script_name, script_name + script_name_len);
+    blob_.insert(blob_.end(), fn_name, fn_name + fn_name_len);
+    blob_.insert(blob_.end(), cp_.begin(), cp_.end());
+  }
+  const uint8_t* data() const { return blob_.data(); }
+  size_t size() const { return blob_.size(); }
+
+ private:
+  std::vector<uint8_t> blob_;
+  std::vector<uint8_t> cp_;
+};
+
+// ---- meta blob ----
+// [u16 n_bytecodes][i32 reg_file_start_offset]
+// per bytecode: name\0 u8 n_ops u8 flags u8 acc_use
+//   3 scales x (u8 total_size, n_ops x (u8 operand_type, u8 operand_offset))
+// [u16 n_runtime_fns] per fn: name\0
+class MetaBuilder {
+ public:
+  void Begin(uint16_t n_bytecodes, int32_t reg_file_start) {
+    buf_.clear();
+    buf_.resize(6);
+    PutU16(buf_.data(), n_bytecodes);
+    PutI32(buf_.data() + 2, reg_file_start);
+  }
+  void Opcode(const char* name, uint8_t n_ops, uint8_t flags, uint8_t acc_use) {
+    size_t nl = strlen(name);
+    buf_.insert(buf_.end(), name, name + nl);
+    buf_.push_back(0);
+    buf_.push_back(n_ops);
+    buf_.push_back(flags);
+    buf_.push_back(acc_use);
+  }
+  void Scale(uint8_t total_size) { buf_.push_back(total_size); }
+  void Operand(uint8_t type, uint8_t offset) {
+    buf_.push_back(type);
+    buf_.push_back(offset);
+  }
+  void RuntimeNames(uint16_t n) {
+    size_t at = buf_.size();
+    buf_.resize(at + 2);
+    PutU16(buf_.data() + at, n);
+  }
+  void RuntimeName(const char* name) {
+    size_t nl = strlen(name);
+    buf_.insert(buf_.end(), name, name + nl);
+    buf_.push_back(0);
+  }
+  const uint8_t* data() const { return buf_.data(); }
+  size_t size() const { return buf_.size(); }
+
+ private:
+  std::vector<uint8_t> buf_;
+};
+
+// ---- split emitter ----
+// Emits hdr+payload as one or more sink records of <= kSinkRecordCap
+// payload bytes. All parts but the last carry kFlagCont. For func-def /
+// meta blobs each part's hdr.offset is its byte position in the blob;
+// instruction parts keep the logical offset (the glue key) on every part.
+template <typename EmitFn>
+inline void EmitSplit(const Hdr& base, const uint8_t* payload, size_t n,
+                      bool offset_is_position, EmitFn emit) {
+  const size_t cap = kSinkRecordCap - sizeof(Hdr);
+  size_t sent = 0;
+  if (n <= cap) {
+    Hdr h = base;
+    h.flags &= ~kFlagCont;
+    emit(h, payload, n);
+    return;
+  }
+  while (sent < n) {
+    size_t take = n - sent < cap ? n - sent : cap;
+    Hdr h = base;
+    if (offset_is_position) h.offset = static_cast<uint32_t>(sent);
+    if (sent + take < n) {
+      h.flags |= kFlagCont;
+    } else {
+      h.flags &= ~kFlagCont;
+    }
+    emit(h, payload + sent, take);
+    sent += take;
+  }
+}
+
+}  // namespace bcrec
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE_BCREC_H_
