+RUNTIME_FUNCTION(Runtime_AfeyeTraceBytecodeEntry) {
+  if (!v8::afeye::Enabled()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  if (AfeyeBcOff()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  if (g_afeye_bc_n.fetch_add(1, std::memory_order_relaxed) >= AfeyeBcCap()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  DisallowGarbageCollection no_gc;
+  DCHECK_EQ(4, args.length());
+  Handle<BytecodeArray> bytecode_array =
+      CheckedCast<BytecodeArray>(args.at(0));
+  int bytecode_offset = args.smi_value_at(1);
+  Handle<Object> accumulator = args.at(2);
+  int scale_raw = args.smi_value_at(3);
+  Tagged<BytecodeArray> arr = *bytecode_array;
+  Tagged<Object> acc = *accumulator;
+
+  if (AfeyeVclockOn()) {
+    v8::afeye::VclockTick(AfeyeVclockNsPerInstr());
+  }
+  AfeyeEmitMeta();
+
+  int offset = bytecode_offset - BytecodeArray::kHeaderSize + kHeapObjectTag;
+  if (offset < 0 || offset >= arr->length()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  const uint8_t* pc =
+      reinterpret_cast<const uint8_t*>(arr->GetFirstBytecodeAddress()) +
+      offset;
+
+  // scale comes from codegen (handler constant), so at pc we already
+  // stand on the REAL opcode - Wide/ExtraWide prefixes were consumed by
+  // the dispatch, offset points past them.
+  interpreter::OperandScale scale =
+      static_cast<interpreter::OperandScale>(scale_raw);
+  uint8_t op_byte = *pc;
+  interpreter::Bytecode bc = interpreter::Bytecodes::FromByte(op_byte);
+
+  JavaScriptStackFrameIterator frame_iterator(isolate);
+  UnoptimizedJSFrame* frame =
+      reinterpret_cast<UnoptimizedJSFrame*>(frame_iterator.frame());
+  Tagged<JSFunction> fn = frame->function();
+  Tagged<SharedFunctionInfo> sfi = fn->shared();
+  uint32_t func_id = AfeyeFuncId(sfi);
+
+  if (!g_afeye_seen.InsertOrExists(
+          reinterpret_cast<uintptr_t>(arr.ptr()))) {
+    AfeyeEmitFuncDef(arr, sfi, no_gc);
+  }
+
+  uint8_t rec[sizeof(AfeyeBcHdr) + kAfeyeMaxPayload * (3 + kAfeyeStrCap)];
+  AfeyeBcHdr* hdr = reinterpret_cast<AfeyeBcHdr*>(rec);
+  std::memset(hdr, 0, sizeof(*hdr));
+  hdr->opcode = op_byte;
+  hdr->scale = static_cast<uint8_t>(scale_raw);
+  hdr->offset = static_cast<uint32_t>(offset);
+  hdr->func_id = func_id;
+  // instruction records carry the isolate tag in `line` (start line lives
+  // on the func-def). Result attribution (acc of record N+1 = result of
+  // record N) must not cross isolates when workers interleave in one pid.
+  hdr->line = static_cast<uint32_t>(
+      (reinterpret_cast<uintptr_t>(isolate) >> 3) & 0xffffffffu);
+  hdr->acc = static_cast<uint64_t>(acc.ptr());
+
+  uint8_t* pp = rec + sizeof(AfeyeBcHdr);
+  int n_pay = 0;
+  int n_regs = 0;
+
+  // Payload blocks: [u8 tag][u16 len][bytes]. Tags:
+  //   0 = accumulator string, 1 = accumulator f64 bits, 2 = accumulator
+  //       smi int32
+  //   3..250 = string value of input register (hdr->regs[tag-3])
+  // The tag carries the type - the Rust decoder never guesses f64 vs
+  // string from length.
+  //
+  // Input registers: decoded with the engine's own signed decoder
+  // (DecodeRegisterOperand - FromOperand on an unsigned read would turn
+  // r0 (-1) into 255 and read garbage). RegPair/RegList contribute all
+  // their registers, not just the first.
+  Address pc_addr =
+      reinterpret_cast<Address>(const_cast<uint8_t*>(pc));
+  int nops = interpreter::Bytecodes::NumberOfOperands(bc);
+  for (int i = 0; i < nops && n_regs < kAfeyeMaxRegs; ++i) {
+    interpreter::OperandType ot =
+        interpreter::Bytecodes::GetOperandType(bc, i);
+    if (!interpreter::Bytecodes::IsRegisterInputOperandType(ot)) continue;
+    Address operand_start =
+        pc_addr + interpreter::Bytecodes::GetOperandOffset(bc, i, scale);
+    interpreter::Register first =
+        interpreter::BytecodeDecoder::DecodeRegisterOperand(operand_start,
+                                                            ot, scale);
+    uint32_t count;
+    if (ot == interpreter::OperandType::kRegList && i + 1 < nops) {
+      // RegList: register count lives in the NEXT operand (kRegCount).
+      Address count_start =
+          pc_addr +
+          interpreter::Bytecodes::GetOperandOffset(bc, i + 1, scale);
+      count = interpreter::BytecodeDecoder::DecodeUnsignedOperand(
+          count_start, interpreter::OperandType::kRegCount, scale);
+      if (count > 32) count = 32;
+    } else {
+      count = interpreter::Bytecodes::GetNumberOfRegistersRepresentedBy(ot);
+    }
+    for (uint32_t j = 0; j < count && n_regs < kAfeyeMaxRegs; ++j) {
+      Tagged<Object> val =
+          frame->ReadInterpreterRegister(first.index() + static_cast<int>(j));
+      hdr->regs[n_regs] = static_cast<uint64_t>(val.ptr());
+      if (n_pay < kAfeyeMaxPayload) {
+        uint32_t sl = AfeyeStringBytes(val, pp + 3, no_gc);
+        if (sl > 0) {
+          pp[0] = static_cast<uint8_t>(3 + n_regs);
+          uint16_t sl16 = static_cast<uint16_t>(sl);
+          std::memcpy(pp + 1, &sl16, 2);
+          pp += 3 + sl;
+          n_pay++;
+          if (sl == kAfeyeStrCap) hdr->flags |= 2;
+        }
+      }
+      n_regs++;
+    }
+  }
+
+  if (n_pay < kAfeyeMaxPayload) {
+    uint32_t sl = AfeyeStringBytes(acc, pp + 3, no_gc);
+    if (sl > 0) {
+      pp[0] = 0;
+      uint16_t sl16 = static_cast<uint16_t>(sl);
+      std::memcpy(pp + 1, &sl16, 2);
+      pp += 3 + sl;
+      n_pay++;
+      hdr->flags |= 4;
+      if (sl == kAfeyeStrCap) hdr->flags |= 2;
+    } else if (IsHeapNumber(acc)) {
+      double d = Cast<HeapNumber>(acc)->value();
+      uint64_t bits;
+      std::memcpy(&bits, &d, 8);
+      pp[0] = 1;
+      uint16_t sl16 = 8;
+      std::memcpy(pp + 1, &sl16, 2);
+      std::memcpy(pp + 3, &bits, 8);
+      pp += 11;
+      n_pay++;
+      hdr->flags |= 4;
+    } else if (IsSmi(acc)) {
+      int32_t v = Smi::ToInt(acc);
+      pp[0] = 2;
+      uint16_t sl16 = 4;
+      std::memcpy(pp + 1, &sl16, 2);
+      std::memcpy(pp + 3, &v, 4);
+      pp += 7;
+      n_pay++;
+      hdr->flags |= 4;
+    }
+  }
+  hdr->n_payload = static_cast<uint8_t>(n_pay);
+  // register count in flags bits 5-7: Rust keeps ALL 6 reg slots and
+  // slices [0, n_regs) - never skips zero words (Smi 0 has tagged word 0
+  // and skipping it would shift tag 3+k attribution).
+  hdr->flags = static_cast<uint8_t>((hdr->flags & 0x1f) | (n_regs << 5));
+
+  v8::afeye::Emit(v8::afeye::kBytecodeTrace, v8::afeye::NowNs(), rec,
+                  static_cast<uint32_t>(pp - rec));
+  return ReadOnlyRoots(isolate).undefined_value();
+}
+
+#endif  // V8_AFEYE
