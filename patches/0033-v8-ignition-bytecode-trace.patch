+#ifdef V8_AFEYE
+
+namespace {
+
+using v8::afeye::bcrec::Hdr;
+using v8::afeye::bcrec::InstrBuilder;
+
+// No caps, no truncation, no dedupe table overflow paths. Every record
+// is emitted in full; oversized records split via EmitSplit (kFlagCont).
+// func_id is deterministic from GC-immovable facts, so a moved SFI keeps
+// its identity. Operand VALUES are decoded by the engine itself
+// (BytecodeDecoder) - the Rust side never re-derives the layout.
+
+bool AfeyeBcOff() {
+  static bool off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_BYTECODE");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return off;
+}
+
+bool AfeyeVclockOn() {
+  static bool on = []() {
+    const char* v = ::getenv("AFEYE_VIRTUAL_CLOCK");
+    return v != nullptr && *v != '\0' && v[0] != '0';
+  }();
+  return on;
+}
+
+uint64_t AfeyeVclockNsPerInstr() {
+  static uint64_t n = []() {
+    const char* v = ::getenv("AFEYE_VCLOCK_NS_PER_INSTR");
+    unsigned long long x = v ? strtoull(v, nullptr, 10) : 0;
+    return x > 0 ? x : 10ull;
+  }();
+  return n;
+}
+
+uint32_t AfeyeIsoTag(Isolate* isolate) {
+  return static_cast<uint32_t>(
+      (reinterpret_cast<uintptr_t>(isolate) >> 3) & 0xffffffffu);
+}
+
+// func-def dedupe keyed on the deterministic func_id: exact, unbounded
+// (std::unordered_set), never silently skips. A recompiled function with
+// the same id and a new bytecode array re-emits its def only if the
+// array length differs - the identity is (id, bc_len).
+struct AfeyeSeenKey {
+  uint32_t id;
+  uint32_t len;
+  bool operator==(const AfeyeSeenKey& o) const {
+    return id == o.id && len == o.len;
+  }
+};
+struct AfeyeSeenKeyHash {
+  size_t operator()(const AfeyeSeenKey& k) const {
+    return std::hash<uint64_t>()(
+        (static_cast<uint64_t>(k.id) << 32) | k.len);
+  }
+};
+thread_local std::unordered_set<AfeyeSeenKey, AfeyeSeenKeyHash>
+    g_afeye_seen;
+
+// Raw string bytes, FULL length, no cap. Returns byte count; sets utf16
+// when the flat content is two-byte (bytes are UTF-16LE).
+uint32_t AfeyeStringBytes(Tagged<Object> obj, std::vector<uint8_t>* out,
+                          bool* utf16,
+                          const DisallowGarbageCollection& no_gc) {
+  *utf16 = false;
+  if (!IsString(obj)) return 0;
+  Tagged<String> str = Cast<String>(obj);
+  String::FlatContent fc = str->GetFlatContent(no_gc);
+  if (!fc.IsFlat()) return 0;
+  size_t at = out->size();
+  if (fc.IsOneByte()) {
+    base::Vector<const uint8_t> v = fc.ToOneByteVector();
+    out->resize(at + v.length());
+    memcpy(out->data() + at, v.begin(), v.length());
+    return static_cast<uint32_t>(v.length());
+  }
+  base::Vector<const base::uc16> v = fc.ToUC16Vector();
+  *utf16 = true;
+  out->resize(at + v.length() * 2);
+  for (uint32_t i = 0; i < static_cast<uint32_t>(v.length()); ++i) {
+    v8::afeye::bcrec::PutU16(out->data() + at + i * 2, v[i]);
+  }
+  return static_cast<uint32_t>(v.length() * 2);
+}
+
+void AfeyeEmit(Isolate* isolate, const Hdr& hdr, const uint8_t* payload,
+               size_t n) {
+  // thread_local scratch: no ~1MiB stack buffer, no per-call heap alloc.
+  static thread_local std::vector<uint8_t> buf;
+  buf.resize(sizeof(Hdr) + n);
+  memcpy(buf.data(), &hdr, sizeof(hdr));
+  if (n) memcpy(buf.data() + sizeof(hdr), payload, n);
+  v8::afeye::Emit(v8::afeye::kBytecodeTrace, v8::afeye::NowNs(),
+                  buf.data(), static_cast<uint32_t>(buf.size()));
+  (void)isolate;
+}
+
+void AfeyeEmitMeta(Isolate* isolate) {
+  static std::atomic<bool> done{false};
+  bool expected = false;
+  if (!done.compare_exchange_strong(expected, true)) return;
+
+  v8::afeye::bcrec::MetaBuilder mb;
+  mb.Begin(static_cast<uint16_t>(interpreter::Bytecodes::kBytecodeCount),
+           interpreter::Register::kRegisterFileStartOffset);
+  const interpreter::OperandScale scales[3] = {
+      interpreter::OperandScale::kSingle,
+      interpreter::OperandScale::kDouble,
+      interpreter::OperandScale::kQuadruple};
+  for (int b = 0; b < interpreter::Bytecodes::kBytecodeCount; ++b) {
+    interpreter::Bytecode bc =
+        interpreter::Bytecodes::FromByte(static_cast<uint8_t>(b));
+    int nops = interpreter::Bytecodes::NumberOfOperands(bc);
+    uint8_t opf = 0;
+    if (interpreter::Bytecodes::IsJump(bc)) {
+      opf |= 1;
+      if (bc == interpreter::Bytecode::kJumpLoop) {
+        opf |= 2 << 3;
+      } else if (interpreter::Bytecodes::IsJumpImmediate(bc)) {
+        opf |= 1 << 3;
+      } else if (interpreter::Bytecodes::IsJumpConstant(bc)) {
+        opf |= 3 << 3;
+      } else {
+        opf |= 4 << 3;
+      }
+      if (bc != interpreter::Bytecode::kJump &&
+          bc != interpreter::Bytecode::kJumpLoop) {
+        opf |= 1 << 5;
+      }
+    }
+    if (interpreter::Bytecodes::Returns(bc)) opf |= 2;
+    if (interpreter::Bytecodes::MakesCallAlongCriticalPath(bc)) opf |= 4;
+    mb.Opcode(interpreter::Bytecodes::ToString(bc),
+              static_cast<uint8_t>(nops), opf,
+              static_cast<uint8_t>(
+                  interpreter::Bytecodes::GetImplicitRegisterUse(bc)));
+    for (int sc = 0; sc < 3; ++sc) {
+      mb.Scale(static_cast<uint8_t>(
+          interpreter::Bytecodes::Size(bc, scales[sc])));
+      for (int i = 0; i < nops; ++i) {
+        mb.Operand(
+            static_cast<uint8_t>(
+                interpreter::Bytecodes::GetOperandType(bc, i)),
+            static_cast<uint8_t>(interpreter::Bytecodes::GetOperandOffset(
+                bc, i, scales[sc])));
+      }
+    }
+  }
+  mb.RuntimeNames(static_cast<uint16_t>(Runtime::kNumFunctions));
+  for (int id = 0; id < Runtime::kNumFunctions; ++id) {
+    const Runtime::Function* f =
+        Runtime::FunctionForId(static_cast<Runtime::FunctionId>(id));
+    mb.RuntimeName((f && f->name) ? f->name : "");
+  }
+
+  Hdr hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  hdr.opcode = v8::afeye::bcrec::kOpMeta;
+  hdr.acc = mb.size();
+  v8::afeye::bcrec::EmitSplit(
+      hdr, mb.data(), mb.size(), true,
+      [&](const Hdr& h, const uint8_t* pl, size_t n) {
+        AfeyeEmit(isolate, h, pl, n);
+      });
+}
+
+void AfeyeEmitFuncDef(Isolate* isolate, Tagged<BytecodeArray> arr,
+                      Tagged<SharedFunctionInfo> sfi, uint32_t func_id,
+                      const DisallowGarbageCollection& no_gc) {
+  int bc_len = arr->length();
+  if (bc_len <= 0) return;
+
+  // script name + JS function name, full bytes. The function name was
+  // previously NOT emitted at all - reports showed the script name under
+  // "function" (audit finding). Both now travel in the func-def head.
+  std::vector<uint8_t> name_buf;
+  bool name_utf16 = false;
+  std::vector<uint8_t> fn_buf;
+  bool fn_utf16 = false;
+  int line = 0;
+  int32_t script_id = -1;
+  if (IsScript(sfi->script())) {
+    Tagged<Script> sc = Cast<Script>(sfi->script());
+    line = sc->GetLineNumber(sfi->StartPosition());
+    if (line < 0) line = 0;
+    script_id = sc->id();
+    Tagged<Object> nm = sc->name();
+    if (IsString(nm)) {
+      AfeyeStringBytes(nm, &name_buf, &name_utf16, no_gc);
+    }
+  }
+  Tagged<String> fn_name = sfi->Name();
+  if (IsString(fn_name)) {
+    AfeyeStringBytes(fn_name, &fn_buf, &fn_utf16, no_gc);
+  }
+
+  // constant pool: raw_constant_pool is Union<Smi, TrustedFixedArray> -
+  // an empty pool is a Smi, dereferencing it as an array is a crash.
+  std::vector<v8::afeye::bcrec::CpSpan> spans;
+  std::vector<uint8_t> cp_scratch;
+  std::vector<size_t> cp_off;  // (tag, offset, len) packed below
+  std::vector<uint8_t> cp_tags;
+  std::vector<uint32_t> cp_lens;
+  Tagged<Object> raw_pool = arr->raw_constant_pool();
+  if (!IsSmi(raw_pool)) {
+    Tagged<TrustedFixedArray> pool = Cast<TrustedFixedArray>(raw_pool);
+    for (int i = 0; i < pool.length(); ++i) {
+      Tagged<Object> cv = pool.get(i);
+      cp_off.push_back(cp_scratch.size());
+      if (IsString(cv)) {
+        bool u16 = false;
+        uint32_t n = AfeyeStringBytes(cv, &cp_scratch, &u16, no_gc);
+        cp_tags.push_back(u16 ? v8::afeye::bcrec::kCpTagStr16
+                              : v8::afeye::bcrec::kCpTagStr);
+        cp_lens.push_back(n);
+      } else if (IsHeapNumber(cv)) {
+        double d = Cast<HeapNumber>(cv)->value();
+        uint64_t bits;
+        memcpy(&bits, &d, 8);
+        cp_off.back() = cp_scratch.size();
+        cp_scratch.resize(cp_scratch.size() + 8);
+        v8::afeye::bcrec::PutU64(cp_scratch.data() + cp_scratch.size() - 8,
+                                 bits);
+        cp_tags.push_back(v8::afeye::bcrec::kCpTagF64);
+        cp_lens.push_back(8);
+      } else {
+        uint64_t w = static_cast<uint64_t>(cv.ptr());
+        cp_off.back() = cp_scratch.size();
+        cp_scratch.resize(cp_scratch.size() + 8);
+        v8::afeye::bcrec::PutU64(cp_scratch.data() + cp_scratch.size() - 8,
+                                 w);
+        cp_tags.push_back(v8::afeye::bcrec::kCpTagRaw);
+        cp_lens.push_back(8);
+      }
+    }
+  }
+  spans.resize(cp_tags.size());
+  for (size_t i = 0; i < spans.size(); ++i) {
+    spans[i].tag = cp_tags[i];
+    spans[i].data = cp_scratch.data() + cp_off[i];
+    spans[i].len = cp_lens[i];
+  }
+
+  v8::afeye::bcrec::FuncDefBuilder fb;
+  fb.Build(reinterpret_cast<const uint8_t*>(arr->GetFirstBytecodeAddress()),
+           static_cast<uint32_t>(bc_len), name_buf.data(),
+           static_cast<uint32_t>(name_buf.size()), fn_buf.data(),
+           static_cast<uint32_t>(fn_buf.size()), script_id,
+           arr->frame_size(),
+           static_cast<uint32_t>(arr->parameter_count()), spans.data(),
+           static_cast<uint32_t>(spans.size()));
+
+  Hdr hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  hdr.opcode = v8::afeye::bcrec::kOpFuncDef;
+  hdr.flags = v8::afeye::bcrec::kFlagFuncDef;
+  hdr.func_id = func_id;
+  hdr.line = static_cast<uint32_t>(line);
+  hdr.acc = fb.size();
+  v8::afeye::bcrec::EmitSplit(
+      hdr, fb.data(), fb.size(), true,
+      [&](const Hdr& h, const uint8_t* pl, size_t n) {
+        AfeyeEmit(isolate, h, pl, n);
+      });
+}
+
+}  // namespace
+
+RUNTIME_FUNCTION(Runtime_AfeyeTraceBytecodeEntry) {
+  if (!v8::afeye::Enabled()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  if (AfeyeBcOff()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  DisallowGarbageCollection no_gc;
+  DCHECK_EQ(4, args.length());
+  Handle<BytecodeArray> bytecode_array =
+      CheckedCast<BytecodeArray>(args.at(0));
+  int bytecode_offset = args.smi_value_at(1);
+  Handle<Object> accumulator = args.at(2);
+  int scale_raw = args.smi_value_at(3);
+  Tagged<BytecodeArray> arr = *bytecode_array;
+  Tagged<Object> acc = *accumulator;
+
+  if (AfeyeVclockOn()) {
+    v8::afeye::VclockTick(AfeyeVclockNsPerInstr());
+  }
+  AfeyeEmitMeta(isolate);
+
+  int offset = bytecode_offset - BytecodeArray::kHeaderSize + kHeapObjectTag;
+  if (offset < 0 || offset >= arr->length()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  const uint8_t* pc =
+      reinterpret_cast<const uint8_t*>(arr->GetFirstBytecodeAddress()) +
+      offset;
+
+  // scale is the handler's codegen constant: at pc stands the REAL
+  // opcode, Wide/ExtraWide prefixes were consumed by the dispatch.
+  interpreter::OperandScale scale =
+      static_cast<interpreter::OperandScale>(scale_raw);
+  uint8_t op_byte = *pc;
+  interpreter::Bytecode bc = interpreter::Bytecodes::FromByte(op_byte);
+
+  JavaScriptStackFrameIterator frame_iterator(isolate);
+  UnoptimizedJSFrame* frame =
+      reinterpret_cast<UnoptimizedJSFrame*>(frame_iterator.frame());
+  Tagged<JSFunction> fn = frame->function();
+  Tagged<SharedFunctionInfo> sfi = fn->shared();
+  uint32_t iso_tag = AfeyeIsoTag(isolate);
+  int32_t script_id =
+      IsScript(sfi->script()) ? Cast<Script>(sfi->script())->id() : -1;
+  uint32_t func_id = v8::afeye::bcrec::MakeFuncId(
+      script_id, sfi->function_literal_id(), sfi->StartPosition(), iso_tag);
+
+  AfeyeSeenKey key{func_id, static_cast<uint32_t>(arr->length())};
+  if (g_afeye_seen.insert(key).second) {
+    AfeyeEmitFuncDef(isolate, arr, sfi, func_id, no_gc);
+  }
+
+  static thread_local std::vector<uint8_t> str_scratch;
+  InstrBuilder ib;
+  ib.Begin(op_byte, static_cast<uint8_t>(scale_raw),
+           static_cast<uint32_t>(offset), func_id, iso_tag,
+           static_cast<uint64_t>(acc.ptr()));
+
+  // operands: decoded by the ENGINE, emitted as values. Register-typed
+  // operands additionally dump the register's raw word and, when the
+  // register holds a String/HeapNumber/Smi, its full value.
+  Address pc_addr =
+      reinterpret_cast<Address>(const_cast<uint8_t*>(pc));
+  int nops = interpreter::Bytecodes::NumberOfOperands(bc);
+  for (int i = 0; i < nops; ++i) {
+    interpreter::OperandType ot =
+        interpreter::Bytecodes::GetOperandType(bc, i);
+    Address operand_start =
+        pc_addr + interpreter::Bytecodes::GetOperandOffset(bc, i, scale);
+    if (interpreter::Bytecodes::IsRegisterInputOperandType(ot)) {
+      interpreter::Register first =
+          interpreter::BytecodeDecoder::DecodeRegisterOperand(operand_start,
+                                                              ot, scale);
+      uint32_t count = 1;
+      if (ot == interpreter::OperandType::kRegList && i + 1 < nops) {
+        Address count_start =
+            pc_addr +
+            interpreter::Bytecodes::GetOperandOffset(bc, i + 1, scale);
+        count = interpreter::BytecodeDecoder::DecodeUnsignedOperand(
+            count_start, interpreter::OperandType::kRegCount, scale);
+      } else {
+        count =
+            interpreter::Bytecodes::GetNumberOfRegistersRepresentedBy(ot);
+      }
+      for (uint32_t j = 0; j < count; ++j) {
+        int ridx = first.index() + static_cast<int>(j);
+        Tagged<Object> val = frame->ReadInterpreterRegister(ridx);
+        uint16_t ru = static_cast<uint16_t>(ridx);
+        ib.Reg(ru, static_cast<uint64_t>(val.ptr()));
+        if (IsString(val)) {
+          str_scratch.clear();
+          bool u16 = false;
+          AfeyeStringBytes(val, &str_scratch, &u16, no_gc);
+          ib.RegStr(ru, str_scratch.data(),
+                    static_cast<uint32_t>(str_scratch.size()), u16);
+        } else if (IsHeapNumber(val)) {
+          double d = Cast<HeapNumber>(val)->value();
+          uint64_t bits;
+          memcpy(&bits, &d, 8);
+          ib.RegF64(ru, bits);
+        } else if (IsSmi(val)) {
+          ib.RegSmi(ru, Smi::ToInt(val));
+        }
+      }
+      // the decoded operand value itself (register index, signed)
+      ib.Operand(static_cast<uint8_t>(i),
+                 static_cast<uint64_t>(static_cast<int64_t>(first.index())));
+    } else {
+      uint32_t uv = interpreter::BytecodeDecoder::DecodeUnsignedOperand(
+          operand_start, ot, scale);
+      int32_t sv = interpreter::BytecodeDecoder::DecodeSignedOperand(
+          operand_start, ot, scale);
+      ib.Operand(static_cast<uint8_t>(i),
+                 static_cast<uint64_t>(static_cast<int64_t>(sv)));
+      (void)uv;
+    }
+  }
+
+  // accumulator value in full
+  if (IsString(acc)) {
+    str_scratch.clear();
+    bool u16 = false;
+    AfeyeStringBytes(acc, &str_scratch, &u16, no_gc);
+    ib.AccStr(str_scratch.data(),
+              static_cast<uint32_t>(str_scratch.size()), u16);
+  } else if (IsHeapNumber(acc)) {
+    double d = Cast<HeapNumber>(acc)->value();
+    uint64_t bits;
+    memcpy(&bits, &d, 8);
+    ib.AccF64(bits);
+  } else if (IsSmi(acc)) {
+    ib.AccSmi(Smi::ToInt(acc));
+  }
+
+  if (AfeyeVclockOn()) {
+    ib.Vclock(v8::afeye::afeye_vclock_ns());
+  }
+
+  Hdr hdr = ib.FinishHdr();
+  v8::afeye::bcrec::EmitSplit(
+      hdr, ib.payload(), ib.payload_len(), false,
+      [&](const Hdr& h, const uint8_t* pl, size_t n) {
+        AfeyeEmit(isolate, h, pl, n);
+      });
+  return ReadOnlyRoots(isolate).undefined_value();
+}
