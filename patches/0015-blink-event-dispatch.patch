 #include <optional>
 
@@ -72,6 +79,49 @@
 DispatchEventResult EventDispatcher::DispatchEvent(Node& node, Event& event) {
   TRACE_EVENT0(TRACE_DISABLED_BY_DEFAULT("blink.debug"),
                "EventDispatcher::dispatchEvent");
+#ifdef BLINK_AFEYE
+  if (blink::afeye::Enabled()) {
+    const std::string afeye_type = event.type().Utf8();
+    const std::string afeye_node = node.nodeName().Utf8();
+    char afeye_buf[256];
+    int afeye_n = std::snprintf(afeye_buf, sizeof(afeye_buf),
+                                 "evt %s trusted=%d target=%.48s",
+                                 afeye_type.c_str(),
+                                 event.isTrusted() ? 1 : 0,
+                                 afeye_node.c_str());
+    if (afeye_n > 0) {
+      blink::afeye::EmitStr(blink::afeye::kEventDispatch,
+                            blink::afeye::NowNs(), afeye_buf);
+    }
+    if (auto* afeye_me = DynamicTo<MouseEvent>(&event)) {
+      char afeye_m[192];
+      int afeye_mn = std::snprintf(
+          afeye_m, sizeof(afeye_m),
+          "evt-mouse %s x=%.1f y=%.1f sx=%.0f sy=%.0f btn=%d",
+          afeye_type.c_str(), afeye_me->clientX(), afeye_me->clientY(),
+          afeye_me->screenX(), afeye_me->screenY(),
+          static_cast<int>(afeye_me->button()));
+      if (afeye_mn > 0) {
+        blink::afeye::EmitStr(blink::afeye::kEventDispatch,
+                              blink::afeye::NowNs(), afeye_m);
+      }
+    } else if (auto* afeye_ke = DynamicTo<KeyboardEvent>(&event)) {
+      char afeye_k[128];
+      int afeye_kn = std::snprintf(
+          afeye_k, sizeof(afeye_k), "evt-key %s key=%.24s code=%.24s",
+          afeye_type.c_str(), afeye_ke->key().Utf8().c_str(),
+          afeye_ke->code().Utf8().c_str());
+      if (afeye_kn > 0) {
+        blink::afeye::EmitStr(blink::afeye::kEventDispatch,
+                              blink::afeye::NowNs(), afeye_k);
+      }
+    }
+    char afeye_tag[64];
+    std::snprintf(afeye_tag, sizeof(afeye_tag), "evt:%.48s",
+                  afeye_type.c_str());
+    blink::afeye::SetTag(afeye_tag);
+  }
+#endif
 #if DCHECK_IS_ON()
   DCHECK(!EventDispatchForbiddenScope::IsEventDispatchForbidden());
 #endif
