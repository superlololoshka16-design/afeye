diff --git a/v8/src/afeye/gc_witness.cc b/v8/src/afeye/gc_witness.cc
new file mode 100644
index 0000000..2f4d8c3
--- /dev/null
+++ b/v8/src/afeye/gc_witness.cc
@@ -0,0 +1,93 @@
+#include "src/afeye/gc_witness.h"
+
+#ifdef V8_AFEYE
+
+#include <cstdio>
+
+#include "src/afeye/sink.h"
+#include "src/afeye/taint.h"
+
+namespace v8 {
+namespace afeye {
+
+// afeye (0032): the GC dead-end witness callback. Registered once per isolate
+// by Heap::SetUp via Heap::AddGCEpilogueCallback (verified against the real
+// 153 source: heap.cc:6447 AddGCEpilogueCallback(GCCallbackWithData, GCType,
+// void*); the existing HeapLayoutTracer registration at heap.cc:5874-5875 is
+// the in-file precedent, and its callback signature - heap-layout-tracer.h:22
+// GCEpiloguePrintHeapLayout(v8::Isolate*, v8::GCType, v8::GCCallbackFlags,
+// void*) - is exactly GCCallbackWithData, v8-isolate.h:1167-1168).
+//
+// THIS CALLBACK OWNS THE WIPE. Ordering is rigid and matters: the union
+// readers (TaintLiveHeapTagUnion / TaintSunkUnion, taint.cc:196/209 added by
+// 0027) walk the LIVE g_taint table, so they MUST run BEFORE TaintOnGCEpilogue
+// clears the heap/stack/context spaces. Sequence:
+//   (a) compute `compacting` from the gc_type bits,
+//   (b) read live = TaintLiveHeapTagUnion(), sunk = TaintSunkUnion(),
+//   (c) emit the swept / dead-end prose records,
+//   (d) call TaintOnGCEpilogue(compacting) to clear the moved-identity spaces.
+// v8 does NOT register a second epilogue callback for the wipe (0027 stays
+// wipe-free) - this single callback is the whole GC-taint seam, so ordering is
+// deterministic regardless of the callback list's invoke order.
+//
+// `compacting` semantics match TaintOnGCEpilogue's own contract (taint.h:80-83
+// "true for mark-compact / scavenges that move objects"): the three MOVING
+// collection types set it. kGCTypeIncrementalMarking / kGCTypeProcessWeak-
+// Callbacks epilogues are not moving-collection completions, so they neither
+// wipe nor witness (the store is untouched). Enum values verified at
+// include/v8-callbacks.h:154-162 (kGCTypeScavenge = 1 << 0,
+// kGCTypeMinorMarkSweep = 1 << 1, kGCTypeMarkSweepCompact = 1 << 2).
+void GCEpilogueWitness(v8::Isolate* isolate, v8::GCType gc_type,
+                       v8::GCCallbackFlags flags, void* data) {
+  if (!TaintEnabled()) return;
+
+  // (a) A collection that MOVES objects: heap/stack/context address keys go
+  // stale, so TaintOnGCEpilogue will wipe them. The witness only fires here -
+  // a non-moving epilogue leaves the store intact, so nothing is swept.
+  const bool compacting =
+      (gc_type & (v8::kGCTypeScavenge | v8::kGCTypeMinorMarkSweep |
+                  v8::kGCTypeMarkSweepCompact)) != 0;
+  if (!compacting) return;
+
+  // (b) READ BEFORE WIPE. live = OR of every tag currently in a swept space
+  // (kKeyHeap/kKeyStack/kKeyContext; kKeyWasm survives compaction and is
+  // excluded by the reader - taint.cc:203). sunk = OR of every tag that ever
+  // crossed an in-renderer TaintEmitSink (taint.cc:191-193, fed by the
+  // postMessage path and any other in-v8 sink). Both walk the live table, so
+  // this MUST precede the (d) wipe.
+  const TaintTag live = TaintLiveHeapTagUnion();
+  const TaintTag sunk = TaintSunkUnion();
+
+  // (c) The two process-level FACT records. They are run-level (a GC has no
+  // active JS entry to attribute), consumed by the Rust filter as report
+  // fields taint_swept_union / taint_deadend_union - exact prefixes locked
+  // with the consumer. "swept" = these sources were live in the heap shadow
+  // and are being collected now. "deadend" = swept AND never reached an
+  // in-renderer sink: (live & ~sunk) is the conservative in-renderer
+  // dead-end - the authoritative cross-process proven/dead-end is the Rust
+  // content-match of the socket-write bytes (0032 req-body-stream / 0011
+  // req-body spans) against the renderer taint captures, because the
+  // network-service process cannot see this store.
+  if (live != kSrcNone) {
+    char buf[96];
+    std::snprintf(buf, sizeof(buf), "taint-swept tag=%x",
+                  static_cast<unsigned>(live));
+    EmitStr(kFingerprint, NowNs(), buf);
+    const TaintTag dead = static_cast<TaintTag>(live & ~sunk);
+    if (dead != kSrcNone) {
+      std::snprintf(buf, sizeof(buf), "taint-deadend tag=%x",
+                    static_cast<unsigned>(dead));
+      EmitStr(kFingerprint, NowNs(), buf);
+    }
+  }
+
+  // (d) WIPE LAST. Clears kKeyHeap/kKeyStack/kKeyContext so a recycled address
+  // can never inherit a stale tag (taint.h:44-51, taint.cc:157-175). kKeyWasm
+  // survives - the linear-memory backing store is off-heap and does not move.
+  TaintOnGCEpilogue(compacting);
+}
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
