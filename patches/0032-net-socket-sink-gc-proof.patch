@@ -0,0 +1,67 @@
+#ifndef V8_AFEYE_GC_WITNESS_H_
+#define V8_AFEYE_GC_WITNESS_H_
+
+#include <stdint.h>
+
+// GCType / GCCallbackFlags enums + the Isolate forward declaration the
+// callback signature needs (heap-layout-tracer.h:8 is the in-tree precedent
+// for a GC-callback header including exactly this).
+#include "include/v8-callbacks.h"
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+// afeye (0032): GC dead-end witness. This module turns the heap-shadow taint
+// store (taint.cc, 0027) into an OBSERVABLE FACT: which fingerprint sources
+// were live in the renderer at each moving GC, and which reached a sink vs.
+// which were swept without ever crossing one. The `dead-end-proven` verdict
+// becomes a FACT (the tainted value was collected and provably never hit an
+// in-renderer sink) instead of a heuristic ("no link + no ring drops").
+//
+// ARCHITECTURE (verified at chromium 153.0.8010.52 / v8 rev d1fed5cd):
+// - The taint store lives in v8 (RENDERER process). services/network (the
+//   network-service process) has NO //v8 dep (services/network/BUILD.gn deps:
+//   //base, //net, //services/network/public/* - verified) and the harness
+//   runs multi-process (no --single-process in the launch flags), so the
+//   socket sink in url_loader/chunked-stream emits CONTENT BYTES
+//   (network::afeye), which the Rust filter content-matches against
+//   renderer-side taint captures => cross-process `proven`.
+// - This witness runs in the RENDERER at each GC epilogue. It reads the
+//   private g_taint aggregate via the taint.cc helpers (0027):
+//   TaintLiveHeapTagUnion() (taint.cc:196) returns the OR of all live
+//   heap/stack/context-space tags BEFORE TaintOnGCEpilogue clears them;
+//   TaintSunkUnion() (taint.cc:209) returns the OR of every tag that ever
+//   crossed TaintEmitSink (an in-renderer sink, incl. the postMessage path).
+// - Record shapes (kind-16 prose, exact prefixes locked with the Rust
+//   consumer): "taint-swept tag=<hex>" and "taint-deadend tag=<hex>"
+//   (deadend = live & ~sunk). These are PROCESS-level facts with no active JS
+//   entry at GC time; the Rust filter consumes them as run-level report
+//   fields (taint_swept_union / taint_deadend_union), NOT per-chain verdicts.
+//
+// GC epoch soundness: a heap address key is only valid within a GC epoch
+// (taint.h:44-51). TaintOnGCEpilogue clears kKeyHeap/kKeyStack/kKeyContext at
+// a moving GC (kKeyWasm survives - the wasm linear-memory backing store is
+// off-heap and fixed). This witness queries the live union BEFORE the clear,
+// so it reports exactly what was in the store at sweep time.
+
+// GC epilogue callback (registered via Heap::AddGCEpilogueCallback from
+// Heap::SetUp, once per isolate - heap.cc:6447; the HeapLayoutTracer
+// registration at heap.cc:5874-5875 is the in-file precedent). Signature =
+// v8::Isolate::GCCallbackWithData (v8-isolate.h:1167-1168; identical to
+// HeapLayoutTracer::GCEpiloguePrintHeapLayout, heap-layout-tracer.h:22).
+//
+// THIS CALLBACK OWNS THE WIPE: it (a) computes `compacting` from the gc_type
+// bits, (b) reads both unions, (c) emits the swept/dead-end records, (d) THEN
+// calls TaintOnGCEpilogue(compacting). v8 registers no second epilogue
+// callback for the wipe, so the read-before-wipe ordering is deterministic.
+void GCEpilogueWitness(v8::Isolate* isolate, v8::GCType gc_type,
+                       v8::GCCallbackFlags flags, void* data);
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
+
+#endif  // V8_AFEYE_GC_WITNESS_H_
