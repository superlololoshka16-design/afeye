diff --git a/third_party/blink/renderer/modules/crypto/subtle_crypto.cc b/third_party/blink/renderer/modules/crypto/subtle_crypto.cc
index 8896206..d7e5b69 100644
--- a/third_party/blink/renderer/modules/crypto/subtle_crypto.cc
+++ b/third_party/blink/renderer/modules/crypto/subtle_crypto.cc
@@ -709,6 +709,27 @@ ScriptPromise<CryptoKey> SubtleCrypto::importKey(
 
   HistogramAlgorithm(ExecutionContext::From(script_state),
                      normalized_algorithm);
+#ifdef BLINK_AFEYE
+  if (blink::afeye::Enabled() && !key_data.empty()) {
+    static std::atomic<uint64_t> g_afeye_keyin{0};
+    static bool g_afeye_keyin_off = []() {
+      const char* v = ::getenv("AFEYE_TRACE_CRYPTO_KEYIN");
+      return v != nullptr && *v != '\0' && v[0] == '0';
+    }();
+    if (!g_afeye_keyin_off &&
+        blink::afeye::AfeyeCapConsume(&g_afeye_keyin, 200000,
+                                      "crypto-keyin")) {
+      char afeye_tag[128];
+      std::snprintf(afeye_tag, sizeof(afeye_tag),
+                    "crypto-keyin importKey %s extractable=%d len=%zu",
+                    AfeyeAlgName(normalized_algorithm), extractable ? 1 : 0,
+                    key_data.size());
+      blink::afeye::EmitSpan(
+          blink::afeye::kCryptoOp, blink::afeye::NowNs(), afeye_tag,
+          key_data.data(), static_cast<uint32_t>(key_data.size()));
+    }
+  }
+#endif
   scoped_refptr<base::SingleThreadTaskRunner> task_runner =
       ExecutionContext::From(script_state)
           ->GetTaskRunner(blink::TaskType::kInternalWebCrypto);
