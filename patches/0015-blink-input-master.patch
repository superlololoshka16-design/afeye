+void AfeyeLogRawInput(const WebInputEvent& event) {
+  static std::atomic<uint64_t> g_afeye_rawin{0};
+  static bool g_afeye_rawin_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_INPUT");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_rawin_off) return;
+  if (!blink::afeye::AfeyeCapConsume(&g_afeye_rawin, 4000000, "input-raw")) {
+    return;
+  }
+  const int afeye_mods = static_cast<int>(event.GetModifiers());
+  const int afeye_dbg =
+      (afeye_mods & static_cast<int>(WebInputEvent::Modifiers::kFromDebugger))
+          ? 1
+          : 0;
+  char afeye_buf[224];
+  int afeye_n = std::snprintf(afeye_buf, sizeof(afeye_buf),
+                              "input/raw type=%.24s mods=%d dbg=%d",
+                              WebInputEvent::GetName(event.GetType()),
+                              afeye_mods, afeye_dbg);
+  if (afeye_n <= 0) return;
+  switch (event.GetType()) {
+    case WebInputEvent::Type::kMouseMove:
+    case WebInputEvent::Type::kMouseDown:
+    case WebInputEvent::Type::kMouseUp: {
+      const auto& afeye_m = static_cast<const WebMouseEvent&>(event);
+      std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                    " x=%.1f y=%.1f sx=%.1f sy=%.1f btn=%d clicks=%d",
+                    afeye_m.PositionInWidget().x(),
+                    afeye_m.PositionInWidget().y(),
+                    afeye_m.PositionInScreen().x(),
+                    afeye_m.PositionInScreen().y(),
+                    static_cast<int>(afeye_m.button), afeye_m.ClickCount());
+      break;
+    }
+    case WebInputEvent::Type::kMouseWheel: {
+      const auto& afeye_w = static_cast<const WebMouseWheelEvent&>(event);
+      std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                    " dx=%.1f dy=%.1f phase=%d",
+                    afeye_w.delta_x, afeye_w.delta_y,
+                    static_cast<int>(afeye_w.phase));
+      break;
+    }
+    case WebInputEvent::Type::kRawKeyDown:
+    case WebInputEvent::Type::kKeyDown:
+    case WebInputEvent::Type::kKeyUp:
+    case WebInputEvent::Type::kChar: {
+      const auto& afeye_k = static_cast<const WebKeyboardEvent&>(event);
+      std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                    " vk=%d code=%d key=%u", afeye_k.windows_key_code,
+                    afeye_k.dom_code, static_cast<unsigned>(afeye_k.dom_key));
+      break;
+    }
+    case WebInputEvent::Type::kPointerDown:
+    case WebInputEvent::Type::kPointerUp:
+    case WebInputEvent::Type::kPointerMove: {
+      const auto& afeye_p = static_cast<const WebPointerEvent&>(event);
+      std::snprintf(afeye_buf + afeye_n, sizeof(afeye_buf) - afeye_n,
+                    " id=%d ptype=%d x=%.1f y=%.1f force=%.2f",
+                    afeye_p.id,
+                    static_cast<int>(afeye_p.pointer_type),
+                    afeye_p.PositionInWidget().x(),
+                    afeye_p.PositionInWidget().y(), afeye_p.force);
+      break;
+    }
+    default:
+      break;
+  }
+  blink::afeye::EmitStr(blink::afeye::kInput, blink::afeye::NowNs(),
+                        afeye_buf);
+}
+
+}
