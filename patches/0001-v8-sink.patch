diff --git a/v8/BUILD.gn b/v8/BUILD.gn
index 0c48f1e..2d4799e 100644
--- a/v8/BUILD.gn
+++ b/v8/BUILD.gn
@@ -64,6 +64,9 @@ declare_args() {
   # Sets -DVERIFY_PREDICTABLE
   v8_enable_verify_predictable = false
 
+  # afeye: env-activated record sink compiled into v8 (patches/SERIES.md).
+  v8_enable_afeye = false
+
   # Enable DWARF line info for Torque files.
   # TODO(olivf): Find out how this works on other platforms.
   v8_enable_torque_dwarf = is_debug && is_linux
@@ -7041,6 +7044,25 @@ v8_cluster_source_set("v8_base_without_compiler") {
     ]
     deps += [ "third_party/vtune:v8_vtune_trace_mark" ]
   }
+
+  # afeye: env-activated record sink compiled into v8 (patches/SERIES.md).
+  # SIBLING of the vtune block, NOT nested inside it. v6 had this nested
+  # under `if (v8_enable_vtunetracemark && ...)` which is false by default:
+  # sink.cc never compiled and every `#ifdef V8_AFEYE` hook in api.cc /
+  # compiler.cc / wasm / execution silently compiled to nothing. The
+  # args.gn extra_cflags define is the belt to this suspenders.
+  # v12.1: `defines = []` first - this target scope never declared a
+  # defines list, so a bare `defines +=` is an Undefined identifier error
+  # in GN (the CI build died at exactly BUILD.gn:7059). Same pattern as
+  # the `libs = []` declaration above.
+  defines = []
+  if (v8_enable_afeye) {
+    sources += [
+      "src/afeye/sink.cc",
+      "src/afeye/sink.h",
+    ]
+    defines += [ "V8_AFEYE" ]
+  }
 }
 
 group("v8_base") {
diff --git a/v8/src/afeye/sink.cc b/v8/src/afeye/sink.cc
new file mode 100644
index 0000000..22f2587
--- /dev/null
+++ b/v8/src/afeye/sink.cc
@@ -0,0 +1,363 @@
+#include "src/afeye/sink.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+#if defined(__has_include)
+#if __has_include("src/afeye/causality.h")
+#include "src/afeye/causality.h"
+#define AFEYE_HAVE_CAUSALITY 1
+#endif
+#if __has_include("src/execution/isolate.h")
+#include "src/execution/isolate.h"
+#include "src/frames/frames.h"
+#include "src/frames/frames-inl.h"
+#include "src/objects/js-function-inl.h"
+#include "src/objects/script-inl.h"
+#include "src/objects/shared-function-info-inl.h"
+#define AFEYE_HAVE_V8_INTERNAL 1
+#endif
+#endif
+
+namespace v8 {
+namespace afeye {
+namespace {
+
+constexpr size_t kRingBytes = 8u << 20;
+constexpr size_t kMaxRecord = 1u << 20;
+constexpr uint32_t kSpanCap = 64u * 1024u;
+constexpr const char* kLayer = "v8";
+
+std::atomic<bool> g_on{false};
+std::atomic<uint64_t> g_dropped{0};
+std::once_flag g_init_once;
+std::atomic<pid_t> g_pid{0};
+thread_local pid_t t_pid = 0;
+
+struct Ring {
+  std::atomic_flag lock = ATOMIC_FLAG_INIT;
+  size_t head = 0;
+  size_t tail = 0;
+  uint8_t data[kRingBytes + kMaxRecord];
+};
+Ring g_ring;
+
+uint64_t MonoNs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull +
+         static_cast<uint64_t>(ts.tv_nsec);
+}
+
+bool EnvOn() {
+  const char* v = ::getenv("AFEYE_SINK");
+  return v != nullptr && *v != '\0' && v[0] != '0';
+}
+
+const char* RawDir() {
+  static const char* kDir = []() -> const char* {
+    const char* v = ::getenv("AFEYE_RAW_DIR");
+    return (v != nullptr && *v != '\0') ? v : "/tmp/afeye-raw";
+  }();
+  return kDir;
+}
+
+std::atomic<uint64_t> g_write_err{0};
+
+void WriteAll(int fd, const uint8_t* p, size_t n) {
+  size_t off = 0;
+  while (off < n) {
+    ssize_t w = ::write(fd, p + off, n - off);
+    if (w < 0) {
+      if (errno == EINTR) continue;
+      g_write_err.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    if (w == 0) return;
+    off += static_cast<size_t>(w);
+  }
+}
+
+void AfeyeFillAttrs(uint8_t* rec, uint8_t kind) {
+  std::memset(rec + 6, 0, 10);
+  if (kind == kSinkDrop || kind == 40) return;
+#ifdef AFEYE_HAVE_V8_INTERNAL
+  internal::Isolate* iso = internal::Isolate::Current();
+  if (iso == nullptr || iso->thread_id() != base::ThreadId::Current()) return;
+  uint32_t sid = 0;
+  internal::JavaScriptStackFrameIterator it(iso);
+  if (!it.done()) {
+    internal::Tagged<internal::JSFunction> fn = it.frame()->function();
+    internal::Tagged<internal::SharedFunctionInfo> sfi = fn->shared();
+    if (internal::IsScript(sfi->script())) {
+      sid = static_cast<uint32_t>(
+          internal::Cast<internal::Script>(sfi->script())->id());
+    }
+  }
+  uint16_t tid = 0;
+#ifdef AFEYE_HAVE_CAUSALITY
+  tid = static_cast<uint16_t>(CausalityCurrent() & 0xffff);
+#endif
+  std::memcpy(rec + 6, &sid, sizeof(sid));
+  std::memcpy(rec + 10, &tid, sizeof(tid));
+#endif
+}
+
+void EmitHello(int fd) {
+  char msg[96];
+  int n = std::snprintf(msg, sizeof(msg), "afeye-sink/%s v2 pid=%d", kLayer,
+                        static_cast<int>(::getpid()));
+  if (n <= 0) return;
+  uint8_t rec[24 + 96];
+  uint32_t total = 24 + static_cast<uint32_t>(n);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = 0;
+  rec[5] = 0;
+  std::memset(rec + 6, 0, 10);
+  uint64_t ts = MonoNs();
+  std::memcpy(rec + 16, &ts, sizeof(ts));
+  std::memcpy(rec + 24, msg, static_cast<size_t>(n));
+  WriteAll(fd, rec, total);
+}
+
+void DrainLoop() {
+  char pid[16];
+  std::snprintf(pid, sizeof(pid), "%d", static_cast<int>(::getpid()));
+  std::string path = std::string(RawDir()) + "/" + kLayer + "-" + pid + ".rec";
+  int fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+  if (fd >= 0) EmitHello(fd);
+  static thread_local std::vector<uint8_t> buf;
+  buf.resize(kMaxRecord);
+  for (;;) {
+    size_t len = 0;
+    bool have = false;
+    uint32_t spin = 0;
+    while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+      if (++spin >= 64) {
+        spin = 0;
+        std::this_thread::yield();
+      }
+    }
+    if (g_ring.tail != g_ring.head) {
+      uint32_t len32;
+      std::memcpy(&len32, g_ring.data + g_ring.tail, sizeof(len32));
+      len = len32;
+      if (len < 24 || len > kMaxRecord) {
+        g_ring.tail = g_ring.head;
+      } else {
+        std::memcpy(buf.data(), g_ring.data + g_ring.tail, len);
+        size_t nt = g_ring.tail + len;
+        if (nt >= kRingBytes) nt -= kRingBytes;
+        g_ring.tail = nt;
+        have = true;
+      }
+    }
+    g_ring.lock.clear(std::memory_order_release);
+    uint64_t werr_before = g_write_err.load(std::memory_order_relaxed);
+    if (have) {
+      if (fd >= 0) {
+        WriteAll(fd, buf.data(), len);
+        if (g_write_err.load(std::memory_order_relaxed) != werr_before) {
+          ::close(fd);
+          fd = -1;
+        }
+      }
+      if (fd < 0) {
+        fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+        if (fd >= 0) EmitHello(fd);
+      }
+    } else {
+      std::this_thread::sleep_for(std::chrono::microseconds(500));
+    }
+  }
+}
+
+void ReinitAfterFork() {
+  g_ring.lock.clear(std::memory_order_release);
+  g_ring.tail = 0;
+  g_ring.head = 0;
+  g_dropped.store(0, std::memory_order_relaxed);
+  g_pid.store(::getpid(), std::memory_order_release);
+  std::thread(DrainLoop).detach();
+}
+
+void InitOnce() {
+  if (!EnvOn()) return;
+  ::mkdir(RawDir(), 0777);
+  ::chmod(RawDir(), 0777);
+  g_on.store(true, std::memory_order_release);
+  g_pid.store(::getpid(), std::memory_order_release);
+  std::thread(DrainLoop).detach();
+  std::atexit([] { Flush(500); });
+}
+
+}
+
+bool Enabled() {
+  std::call_once(g_init_once, InitOnce);
+  pid_t me = t_pid;
+  if (me == 0) {
+    me = ::getpid();
+    t_pid = me;
+  }
+  if (g_pid.load(std::memory_order_acquire) != me) {
+    pid_t old = g_pid.load(std::memory_order_acquire);
+    if (g_pid.compare_exchange_strong(old, me, std::memory_order_acq_rel)) {
+      ReinitAfterFork();
+    }
+  }
+  return g_on.load(std::memory_order_acquire);
+}
+
+uint64_t NowNs() { return MonoNs(); }
+
+void EmitFlags(uint8_t kind, uint64_t ts_ns, uint8_t flags, const void* data,
+               uint32_t len) {
+  if (!g_on.load(std::memory_order_acquire)) return;
+  if (data == nullptr || len == 0) return;
+  if (len > kMaxRecord - 24) {
+    len = kMaxRecord - 24;
+    flags |= 1;
+  }
+  const size_t need = 24 + static_cast<size_t>(len);
+  uint32_t afeye_spin = 0;
+  while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+    if (++afeye_spin >= 64) {
+      afeye_spin = 0;
+      std::this_thread::yield();
+    }
+  }
+  const size_t h = g_ring.head;
+  const size_t t = g_ring.tail;
+  const size_t used = (h >= t) ? h - t : kRingBytes - t + h;
+  if (kRingBytes - used < need + 8) {
+    g_ring.lock.clear(std::memory_order_release);
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  uint8_t* rec = g_ring.data + h;
+  const uint32_t total = static_cast<uint32_t>(need);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = kind;
+  rec[5] = flags;
+  AfeyeFillAttrs(rec, kind);
+  std::memcpy(rec + 16, &ts_ns, sizeof(ts_ns));
+  std::memcpy(rec + 24, data, len);
+  size_t nh = h + need;
+  if (nh >= kRingBytes) nh -= kRingBytes;
+  g_ring.head = nh;
+  g_ring.lock.clear(std::memory_order_release);
+}
+
+void Emit(uint8_t kind, uint64_t ts_ns, const void* data, uint32_t len) {
+  EmitFlags(kind, ts_ns, 0, data, len);
+}
+
+void EmitStr(uint8_t kind, uint64_t ts_ns, const char* s) {
+  if (s == nullptr) return;
+  EmitFlags(kind, ts_ns, 0, s, static_cast<uint32_t>(std::strlen(s)));
+}
+
+void EmitTwoStr(uint8_t kind, uint64_t ts_ns, const char* a, const char* b) {
+  if (a == nullptr || b == nullptr) return;
+  size_t la = std::strlen(a);
+  size_t lb = std::strlen(b);
+  bool trunc = false;
+  const size_t kCap = kMaxRecord - 25;
+  if (la > kCap) {
+    la = kCap;
+    trunc = true;
+  }
+  if (lb > kCap - la) {
+    lb = kCap - la;
+    trunc = true;
+  }
+  static thread_local std::string buf;
+  buf.clear();
+  buf.reserve(la + lb + 1);
+  buf.append(a, la);
+  buf.push_back('\0');
+  buf.append(b, lb);
+  EmitFlags(kind, ts_ns, trunc ? 1 : 0, buf.data(),
+            static_cast<uint32_t>(buf.size()));
+}
+
+void EmitSpan(uint8_t kind, uint64_t ts_ns, const char* tag,
+              const uint8_t* bytes, uint32_t n) {
+  if (tag == nullptr || bytes == nullptr || n == 0) return;
+  size_t lt = std::strlen(tag);
+  if (lt > 64) lt = 64;
+  bool trunc = false;
+  if (n >= kSpanCap) {
+    n = kSpanCap;
+    trunc = true;
+  }
+  static thread_local std::vector<char> buf;
+  buf.clear();
+  buf.reserve(lt + 1 + n);
+  buf.insert(buf.end(), tag, tag + lt);
+  buf.push_back('\0');
+  buf.insert(buf.end(), reinterpret_cast<const char*>(bytes),
+             reinterpret_cast<const char*>(bytes) + n);
+  EmitFlags(kind, ts_ns, trunc ? 1 : 0, buf.data(),
+            static_cast<uint32_t>(buf.size()));
+}
+void EmitWasmMemGrow(size_t old_pages, size_t new_pages) {
+  static std::atomic<uint64_t> g_afeye_wmem{0};
+  static bool g_afeye_wmem_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMMEM");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_wmem_off) return;
+  if (!AfeyeCapConsume(&g_afeye_wmem, 100000, "wasm-mem-grow")) return;
+  char afeye_buf[128];
+  std::snprintf(afeye_buf, sizeof(afeye_buf), "wasm-mem grow old=%u new=%u",
+                static_cast<unsigned>(old_pages),
+                static_cast<unsigned>(new_pages));
+  EmitStr(kWasmInstance, NowNs(), afeye_buf);
+}
+
+
+uint64_t SinkDropped() {
+  return g_dropped.load(std::memory_order_relaxed) +
+         g_write_err.load(std::memory_order_relaxed);
+}
+
+bool Flush(uint32_t timeout_ms) {
+  if (!g_on.load(std::memory_order_acquire)) return true;
+  auto deadline = std::chrono::steady_clock::now() +
+                  std::chrono::milliseconds(timeout_ms);
+  while (std::chrono::steady_clock::now() < deadline) {
+    bool empty;
+    while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+    }
+    empty = g_ring.tail == g_ring.head;
+    g_ring.lock.clear(std::memory_order_release);
+    if (empty) return true;
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+  }
+  return false;
+}
+
+}
+}
+
+#endif
+
diff --git a/v8/src/afeye/sink.h b/v8/src/afeye/sink.h
new file mode 100644
index 0000000..4167882
--- /dev/null
+++ b/v8/src/afeye/sink.h
@@ -0,0 +1,68 @@
+#ifndef V8_AFEYE_SINK_H_
+#define V8_AFEYE_SINK_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cstdio>
+
+namespace v8 {
+namespace afeye {
+
+enum EventKind : uint8_t {
+  kSinkHello = 0,
+  kScriptSource = 1,
+  kBytecodeEntry = 2,
+  kWasmModule = 3,
+  kWasmMemory = 4,
+  kWasmTable = 5,
+  kMicrotaskEnqueue = 6,
+  kMicrotaskRun = 7,
+  kCallCompleted = 8,
+  kAtomics = 9,
+  kSabBacking = 10,
+  kMicrotaskDrain = 30,
+  kWasmInstance = 31,
+  kFnToString = 32,
+  kClock = 33,
+  kIsolateBirth = 34,
+  kFingerprint = 16,
+  kErrorStack = 38,
+  kSinkDrop = 39,
+};
+
+bool Enabled();
+uint64_t NowNs();
+void EmitFlags(uint8_t kind, uint64_t ts_ns, uint8_t flags, const void* data,
+               uint32_t len);
+void Emit(uint8_t kind, uint64_t ts_ns, const void* data, uint32_t len);
+void EmitStr(uint8_t kind, uint64_t ts_ns, const char* s);
+void EmitTwoStr(uint8_t kind, uint64_t ts_ns, const char* a, const char* b);
+void EmitWasmMemGrow(size_t old_pages, size_t new_pages);
+void EmitSpan(uint8_t kind, uint64_t ts_ns, const char* tag,
+              const uint8_t* bytes, uint32_t n);
+uint64_t SinkDropped();
+bool Flush(uint32_t timeout_ms);
+
+inline bool AfeyeCapConsume(std::atomic<uint64_t>* ctr, uint64_t cap,
+                            const char* name) {
+  const uint64_t old = ctr->fetch_add(1, std::memory_order_relaxed);
+  if (old == cap) {
+    char msg[128];
+    std::snprintf(msg, sizeof(msg), "cap-exhausted name=%s limit=%llu", name,
+                  static_cast<unsigned long long>(cap));
+    EmitStr(kSinkDrop, NowNs(), msg);
+  }
+  return old < cap;
+}
+
+}
+}
+
+#endif
+
+#endif
+
