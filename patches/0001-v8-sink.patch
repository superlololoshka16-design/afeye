diff --git a/v8/src/afeye/sink.cc b/v8/src/afeye/sink.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/v8/src/afeye/sink.cc
@@ -0,0 +58,284 @@
+#include "src/afeye/sink.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace v8 {
+namespace afeye {
+namespace {
+
+constexpr size_t kRingBytes = 8u << 20;
+constexpr size_t kMaxRecord = 1u << 20;
+constexpr uint32_t kSpanCap = 64u * 1024u;
+constexpr const char* kLayer = "v8";
+
+std::atomic<bool> g_on{false};
+std::atomic<uint64_t> g_dropped{0};
+std::once_flag g_init_once;
+// v12.4: atomic + CAS so two child threads post-fork cannot both run
+// ReinitAfterFork and spawn two drain threads on one file.
+std::atomic<pid_t> g_pid{0};  // fork safety - see Enabled()
+// v12.4: getpid() is a REAL syscall on modern glibc (the pid cache was
+// removed in 2.25) - Enabled() sits in the hottest funnel (Invoke, every
+// C++->JS entry), so the pid is cached per thread and re-checked only
+// against the atomic (vDSO-priced load). A fork changes the pid, the
+// thread-local is refreshed then - one syscall per fork, zero per call.
+thread_local pid_t t_pid = 0;
+
+struct Ring {
+  std::atomic_flag lock = ATOMIC_FLAG_INIT;
+  size_t head = 0;
+  size_t tail = 0;
+  uint8_t data[kRingBytes + kMaxRecord];
+};
+Ring g_ring;
+
+uint64_t MonoNs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull +
+         static_cast<uint64_t>(ts.tv_nsec);
+}
+
+bool EnvOn() {
+  const char* v = ::getenv("AFEYE_SINK");
+  return v != nullptr && *v != '\0' && v[0] != '0';
+}
+
+const char* RawDir() {
+  static const char* kDir = []() -> const char* {
+    const char* v = ::getenv("AFEYE_RAW_DIR");
+    return (v != nullptr && *v != '\0') ? v : "/tmp/afeye-raw";
+  }();
+  return kDir;
+}
+
+// v12.4: write errors are COUNTED, not swallowed. The chunk is already
+// out of the ring, g_dropped does not move, and the 0023 drop witness
+// watches ring overflow only - a silent return made ENOSPC/EIO invisible
+// loss (exactly the class of hidden gap the witness exists to close).
+// The drain loop reads the counter, folds it into its sink-drop report,
+// and reopens the fd so a transient failure (full disk, then space) does
+// not silently kill every subsequent record forever.
+std::atomic<uint64_t> g_write_err{0};
+
+void WriteAll(int fd, const uint8_t* p, size_t n) {
+  size_t off = 0;
+  while (off < n) {
+    ssize_t w = ::write(fd, p + off, n - off);
+    if (w < 0) {
+      if (errno == EINTR) continue;
+      g_write_err.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    if (w == 0) return;
+    off += static_cast<size_t>(w);
+  }
+}
+
+void EmitHello(int fd) {
+  char msg[96];
+  int n = std::snprintf(msg, sizeof(msg), "afeye-sink/%s v2 pid=%d", kLayer,
+                        static_cast<int>(::getpid()));
+  if (n <= 0) return;
+  uint8_t rec[16 + 96];
+  uint32_t total = 16 + static_cast<uint32_t>(n);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = 0;
+  rec[5] = 0;
+  rec[6] = 0;
+  rec[7] = 0;
+  uint64_t ts = MonoNs();
+  std::memcpy(rec + 8, &ts, sizeof(ts));
+  std::memcpy(rec + 16, msg, static_cast<size_t>(n));
+  WriteAll(fd, rec, total);
+}
+
+void DrainLoop() {
+  char pid[16];
+  std::snprintf(pid, sizeof(pid), "%d", static_cast<int>(::getpid()));
+  std::string path = std::string(RawDir()) + "/" + kLayer + "-" + pid + ".rec";
+  int fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+  if (fd >= 0) EmitHello(fd);
+  // v12.4 (N6): fixed stack-of-heap buffer, NOT a std::vector. The old
+  // buf.assign() ran a malloc + memcpy of up to 1 MiB INSIDE the ring lock
+  // - if the drain thread descheduled mid-copy, every JS thread in the
+  // process spun on test_and_set for the whole copy (the v8 ring is one
+  // per process; main thread + every worker isolate contend on it).
+  // Now: copy under lock into a pre-sized buffer, write outside it.
+  static thread_local std::vector<uint8_t> buf;
+  buf.resize(kMaxRecord);
+  for (;;) {
+    size_t len = 0;
+    bool have = false;
+    uint32_t spin = 0;
+    while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+      // bounded spin then yield: an unbounded test_and_set on a contended
+      // cache line burns the whole timeslice without progress
+      if (++spin >= 64) {
+        spin = 0;
+        std::this_thread::yield();
+      }
+    }
+    if (g_ring.tail != g_ring.head) {
+      uint32_t len32;
+      std::memcpy(&len32, g_ring.data + g_ring.tail, sizeof(len32));
+      len = len32;
+      if (len < 16 || len > kMaxRecord) {
+        g_ring.tail = g_ring.head;
+      } else {
+        // single memcpy under the lock - no allocation, no syscalls
+        std::memcpy(buf.data(), g_ring.data + g_ring.tail, len);
+        size_t nt = g_ring.tail + len;
+        if (nt >= kRingBytes) nt -= kRingBytes;
+        g_ring.tail = nt;
+        have = true;
+      }
+    }
+    g_ring.lock.clear(std::memory_order_release);
+    uint64_t werr_before = g_write_err.load(std::memory_order_relaxed);
+    if (have) {
+      if (fd >= 0) {
+        WriteAll(fd, buf.data(), len);
+        // v12.4: a failed write (ENOSPC/EIO) leaves a live fd that would
+        // keep swallowing records - force the reopen path below so the
+        // next cycle retries a FRESH open (disk-full-then-space, etc.).
+        if (g_write_err.load(std::memory_order_relaxed) != werr_before) {
+          ::close(fd);
+          fd = -1;
+        }
+      }
+      if (fd < 0) {
+        fd = ::open(path.c_str(), O_CREAT | O_APPEND | O_WRONLY, 0666);
+        if (fd >= 0) EmitHello(fd);
+      }
+    } else {
+      std::this_thread::sleep_for(std::chrono::microseconds(500));
+    }
+  }
+}
+
+// v12.1: fork safety. Chrome zygote-forks renderers AFTER InitOnce ran in
+// the parent: the child inherits the once_flag as COMPLETED, the ring, and
+// g_pid - but the drain thread does NOT survive fork (only the calling
+// thread continues). The child would fill the inherited 8 MiB ring, drop
+// everything, and never create its <layer>-<pid>.rec. getpid is vDSO (no
+// syscall) so the check is free in the hot path.
+void ReinitAfterFork() {
+  // v12.4: the parent's drain thread may have HELD the ring lock at fork
+  // time - the (dead) holder never clears it, and the first child Enabled()
+  // would spin forever on a test_and_set owned by nobody. In the fresh
+  // child only the calling thread exists, so an unconditional clear is
+  // race-free by definition.
+  g_ring.lock.clear(std::memory_order_release);
+  g_ring.tail = 0;
+  g_ring.head = 0;
+  g_dropped.store(0, std::memory_order_relaxed);
+  g_pid.store(::getpid(), std::memory_order_release);
+  std::thread(DrainLoop).detach();
+}
+
+void InitOnce() {
+  if (!EnvOn()) return;
+  ::mkdir(RawDir(), 0777);
+  ::chmod(RawDir(), 0777);
+  g_on.store(true, std::memory_order_release);
+  g_pid.store(::getpid(), std::memory_order_release);
+  std::thread(DrainLoop).detach();
+  std::atexit([] { Flush(500); });
+}
+
+}  // namespace
+
+bool Enabled() {
+  std::call_once(g_init_once, InitOnce);
+  // v12.4: no raw getpid() here - it is a real syscall on glibc >= 2.25 and
+  // this sits in the Invoke funnel (every C++->JS entry). The thread-local
+  // cache holds the last observed pid; only a mismatch (a fork happened on
+  // THIS thread) pays the syscall + the CAS-reinit. The CAS admits exactly
+  // one winner when several threads race post-fork; the losers just
+  // refresh their cache. Sink-off early-exit: a disabled build never spawns
+  // a drain thread, never leaves a .rec file (the v12.4 N4 fix).
+  pid_t me = t_pid;
+  if (me == 0) {
+    me = ::getpid();
+    t_pid = me;
+  }
+  if (g_pid.load(std::memory_order_acquire) != me) {
+    pid_t old = g_pid.load(std::memory_order_acquire);
+    if (g_pid.compare_exchange_strong(old, me, std::memory_order_acq_rel)) {
+      ReinitAfterFork();
+    }
+  }
+  return g_on.load(std::memory_order_acquire);
+}
+
+uint64_t NowNs() { return MonoNs(); }
+
+void EmitFlags(uint8_t kind, uint64_t ts_ns, uint8_t flags, const void* data,
+               uint32_t len) {
+  if (!g_on.load(std::memory_order_acquire)) return;
+  if (data == nullptr || len == 0) return;
+  if (len > kMaxRecord - 16) {
+    len = kMaxRecord - 16;
+    flags |= 1;
+  }
+  const size_t need = 16 + static_cast<size_t>(len);
+  uint32_t afeye_spin = 0;
+  while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+    // v12.4 (N6): emit hot path - every Invoke crosses here. Unbounded
+    // test_and_set against a descheduled holder burns a full timeslice;
+    // 64 spins then yield keeps the latency bounded for the holder's
+    // cache-line release.
+    if (++afeye_spin >= 64) {
+      afeye_spin = 0;
+      std::this_thread::yield();
+    }
+  }
+  const size_t h = g_ring.head;
+  const size_t t = g_ring.tail;
+  const size_t used = (h >= t) ? h - t : kRingBytes - t + h;
+  if (kRingBytes - used < need + 8) {
+    g_ring.lock.clear(std::memory_order_release);
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  uint8_t* rec = g_ring.data + h;
+  const uint32_t total = static_cast<uint32_t>(need);
+  std::memcpy(rec, &total, sizeof(total));
+  rec[4] = kind;
+  rec[5] = flags;
+  rec[6] = 0;
+  rec[7] = 0;
+  std::memcpy(rec + 8, &ts_ns, sizeof(ts_ns));
+  std::memcpy(rec + 16, data, len);
+  size_t nh = h + need;
+  if (nh >= kRingBytes) nh -= kRingBytes;
+  g_ring.head = nh;
+  g_ring.lock.clear(std::memory_order_release);
+}
+
+void Emit(uint8_t kind, uint64_t ts_ns, const void* data, uint32_t len) {
+  EmitFlags(kind, ts_ns, 0, data, len);
+}
+
+void EmitStr(uint8_t kind, uint64_t ts_ns, const char* s) {
+  if (s == nullptr) return;
+  EmitFlags(kind, ts_ns, 0, s, static_cast<uint32_t>(std::strlen(s)));
+}
+
+void EmitTwoStr(uint8_t kind, uint64_t ts_ns, const char* a, const char* b) {
+  if (a == nullptr || b == nullptr) return;
+  size_t la = std::strlen(a);
+  size_t lb = std::strlen(b);
+  bool trunc = false;
+  const size_t kCap = kMaxRecord - 17;
+  if (la > kCap) {
+    la = kCap;
+    trunc = true;
+  }
+  if (lb > kCap - la) {
+    lb = kCap - la;
+    trunc = true;
+  }
+  static thread_local std::string buf;
+  buf.clear();
+  buf.reserve(la + lb + 1);
+  buf.append(a, la);
+  buf.push_back('\0');
+  buf.append(b, lb);
+  EmitFlags(kind, ts_ns, trunc ? 1 : 0, buf.data(),
+            static_cast<uint32_t>(buf.size()));
+}
+
+void EmitSpan(uint8_t kind, uint64_t ts_ns, const char* tag,
+              const uint8_t* bytes, uint32_t n) {
+  if (tag == nullptr || bytes == nullptr || n == 0) return;
+  size_t lt = std::strlen(tag);
+  if (lt > 64) lt = 64;
+  bool trunc = false;
+  if (n > kSpanCap) {
+    n = kSpanCap;
+    trunc = true;
+  }
+  static thread_local std::vector<char> buf;
+  buf.clear();
+  buf.reserve(lt + 1 + n);
+  buf.insert(buf.end(), tag, tag + lt);
+  buf.push_back('\0');
+  buf.insert(buf.end(), reinterpret_cast<const char*>(bytes),
+             reinterpret_cast<const char*>(bytes) + n);
+  EmitFlags(kind, ts_ns, trunc ? 1 : 0, buf.data(),
+            static_cast<uint32_t>(buf.size()));
+}
+// v12.4 (N9): the DEFINITION lives here (was 0025 wasm-objects.cc-only) -
+// the sink.h declaration alone left every other TU calling it with an
+// undefined symbol. Same body as 0025; the 0025 copy is removed.
+void EmitWasmMemGrow(size_t old_pages, size_t new_pages) {
+  static std::atomic<uint64_t> g_afeye_wmem{0};
+  static bool g_afeye_wmem_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMMEM");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_wmem_off) return;
+  if (g_afeye_wmem.fetch_add(1, std::memory_order_relaxed) >= 100000)
+    return;
+  char afeye_buf[128];
+  std::snprintf(afeye_buf, sizeof(afeye_buf), "wasm-mem grow old=%u new=%u",
+                static_cast<unsigned>(old_pages),
+                static_cast<unsigned>(new_pages));
+  EmitStr(kWasmInstance, NowNs(), afeye_buf);
+}
+
+
+// v12.4: ring drops AND write errors - the 0023 witness must see both or
+// ENOSPC is an invisible gap the graph then misreads as dead-end evidence.
+uint64_t SinkDropped() {
+  return g_dropped.load(std::memory_order_relaxed) +
+         g_write_err.load(std::memory_order_relaxed);
+}
+
+bool Flush(uint32_t timeout_ms) {
+  if (!g_on.load(std::memory_order_acquire)) return true;
+  auto deadline = std::chrono::steady_clock::now() +
+                  std::chrono::milliseconds(timeout_ms);
+  while (std::chrono::steady_clock::now() < deadline) {
+    bool empty;
+    while (g_ring.lock.test_and_set(std::memory_order_acquire)) {
+    }
+    empty = g_ring.tail == g_ring.head;
+    g_ring.lock.clear(std::memory_order_release);
+    if (empty) return true;
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+  }
+  return false;
+}
+
+}
+}  // namespace v8
+
+#endif
+
