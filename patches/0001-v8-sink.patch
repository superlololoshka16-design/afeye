+#ifndef V8_AFEYE_SINK_H_
+#define V8_AFEYE_SINK_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+enum EventKind : uint8_t {
+  kSinkHello = 0,
+  kScriptSource = 1,
+  kBytecodeEntry = 2,
+  kWasmModule = 3,
+  kWasmMemory = 4,
+  kWasmTable = 5,
+  kMicrotaskEnqueue = 6,
+  kMicrotaskRun = 7,
+  kCallCompleted = 8,
+  kAtomics = 9,
+  kSabBacking = 10,
+  // v6 additions (wire-compatible, new records only)
+  kMicrotaskDrain = 30,
+  kWasmInstance = 31,
+  kFnToString = 32,
+  kClock = 33,
+  kIsolateBirth = 34,
+  // v9 additions (wire-compatible). kind 16 "fingerprint" already named by
+  // the collector for the blink layer; the v8 layer joins it for the
+  // in-engine fingerprint reads (JSON.stringify result, Intl resolved
+  // options, GOPD tamper-checks) that have no blink binding.
+  kFingerprint = 16,
+  // 38 error-stack: Error().stack / captureStackTrace materialization
+  // (0022) - the automation-detection surface AND the JS->JS edge source.
+  kErrorStack = 38,
+};
+
+bool Enabled();
+uint64_t NowNs();
+void EmitFlags(uint8_t kind, uint64_t ts_ns, uint8_t flags, const void* data,
+               uint32_t len);
+void Emit(uint8_t kind, uint64_t ts_ns, const void* data, uint32_t len);
+void EmitStr(uint8_t kind, uint64_t ts_ns, const char* s);
+void EmitTwoStr(uint8_t kind, uint64_t ts_ns, const char* a, const char* b);
+void EmitWasmMemGrow(size_t old_pages, size_t new_pages);
+void EmitSpan(uint8_t kind, uint64_t ts_ns, const char* tag,
+              const uint8_t* bytes, uint32_t n);
+uint64_t SinkDropped();
+bool Flush(uint32_t timeout_ms);
+
+}
+}  // namespace v8
+
+#endif
+
+#endif
