+// afeye (v6): raw script-source dumper. ONE definition, placed before every
+// call site - the three compilation funnels below (eval, streamed, buffered)
+// all reach it. DirectHandle<String> accepts both Handle<String> and
+// DirectHandle<String> callers in every build configuration. The name is
+// iso-prefixed ("iso:<isolate> <name>") so the external filter can group
+// eval-chains per isolate/session - a dedicated worker's stream never mixes
+// with the main thread even though both live in the same renderer process.
+// v12.4 (N8, documented invariant): this body ALLOCATES (String::Utf8Value
+// may Flatten -> GC, std::string for the name). It is legal ONLY because
+// every call site (the compile funnels: eval / streamed / buffered /
+// wrapped) is an allocating compilation context that already owns handles
+// and can absorb a GC - it is NOT no-alloc and must never be moved into
+// Invoke / GC-active / DisallowGarbageCollection callers. The sink itself
+// (EmitTwoStr path after this) copies into the ring under the spin lock
+// with no allocation.
+static void AfeyeDumpScriptSource(Isolate* isolate,
+                                  DirectHandle<String> source,
+                                  const char* fallback_name,
+                                  MaybeHandle<Object> maybe_name) {
+  // env-gate, not a v8_flag: a DEFINE_BOOL in flag-definitions.h would force
+  // EVERY v8 translation unit to recompile (the header is included tree-wide)
+  // for one knob with one reader. getenv is read once, static-cached.
+  static bool g_afeye_source_off = []() {
+    const char* v = ::getenv("AFEYE_SOURCE");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (!v8::afeye::Enabled() || g_afeye_source_off) return;
+  if (source.is_null()) return;
+  v8::Isolate* api_isolate = reinterpret_cast<v8::Isolate*>(isolate);
+  v8::Local<v8::String> local_source = v8::Utils::ToLocal(source);
+  if (local_source.IsEmpty()) return;
+  v8::String::Utf8Value utf8(api_isolate, local_source);
+  if (!*utf8 || **utf8 == '\0') return;
+  const char* name = fallback_name;
+  std::string name_buf;
+  Handle<Object> name_obj;
+  if (maybe_name.ToHandle(&name_obj) && IsString(*name_obj)) {
+    v8::Local<v8::String> local_name =
+        v8::Utils::ToLocal(Cast<String>(name_obj));
+    if (!local_name.IsEmpty()) {
+      v8::String::Utf8Value name8(api_isolate, local_name);
+      if (*name8 && **name8 != '\0') {
+        name_buf.assign(*name8);
+        name = name_buf.c_str();
+      }
+    }
+  }
+  char afeye_iso[26];
+  std::snprintf(afeye_iso, sizeof(afeye_iso), "iso:%p ",
+                static_cast<void*>(isolate));
+  std::string final_name = std::string(afeye_iso) + name;
+  v8::afeye::EmitTwoStr(v8::afeye::kScriptSource, v8::afeye::NowNs(),
+                        final_name.c_str(), *utf8);
+}
+
 constexpr bool IsOSR(BytecodeOffset osr_offset) { return !osr_offset.IsNone(); }
 
