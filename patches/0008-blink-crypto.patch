+#ifdef BLINK_AFEYE
+static void AfeyeDumpSubtleOp(const char* op,
+                              const V8BufferSource* raw_data) {
+  if (!blink::afeye::Enabled() || !raw_data) return;
+  const uint8_t* p = nullptr;
+  size_t n = 0;
+  if (raw_data->IsArrayBuffer()) {
+    const DOMArrayBuffer* b = raw_data->GetAsArrayBuffer();
+    if (b) {
+      p = reinterpret_cast<const uint8_t*>(b->Data());
+      n = b->ByteLength();
+    }
+  } else if (raw_data->IsArrayBufferView()) {
+    const DOMArrayBufferView* v = raw_data->GetAsArrayBufferView();
+    if (v) {
+      auto s = v->ByteSpan();
+      p = reinterpret_cast<const uint8_t*>(s.data());
+      n = s.size();
+    }
+  }
+  if (p && n) {
+    blink::afeye::EmitSpan(blink::afeye::kCryptoOp,
+                           blink::afeye::NowNs(), op,
+                           p, static_cast<uint32_t>(n));
+  }
+}
+#endif
