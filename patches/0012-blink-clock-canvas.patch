 DOMHighResTimeStamp Performance::now() const {
+#ifdef BLINK_AFEYE
+  if (blink::afeye::Enabled()) {
+    static std::atomic<uint64_t> g_afeye_pnow{0};
+    static bool g_afeye_pnow_off = []() {
+      const char* v = ::getenv("AFEYE_TRACE_CLOCK");
+      return v != nullptr && *v != '\0' && v[0] == '0';
+    }();
+    if (!g_afeye_pnow_off &&
+        blink::afeye::AfeyeCapConsume(&g_afeye_pnow, 2000000, "clock-now")) {
+      const double afeye_pnow_v =
+          MonotonicTimeToDOMHighResTimeStamp(base::TimeTicks::Now());
+      char afeye_buf[64];
+      std::snprintf(afeye_buf, sizeof(afeye_buf),
+                    "clock performance-now v=%.17g", afeye_pnow_v);
+      blink::afeye::EmitStr(blink::afeye::kClock, blink::afeye::NowNs(),
+                            afeye_buf);
+    }
+  }
+#endif
   return MonotonicTimeToDOMHighResTimeStamp(base::TimeTicks::Now());
 }
 
