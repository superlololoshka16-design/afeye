+v8::Local<v8::Value> AfeyeWrapDomApi(v8::Isolate* isolate,
+                                     v8::FunctionCallback orig,
+                                     const char* interface_name,
+                                     const char* accessor,
+                                     const char* property_name) {
+  if (!orig || !blink::afeye::Enabled()) {
+    return v8::Local<v8::Value>();
+  }
+  const size_t slot = (reinterpret_cast<uintptr_t>(orig) >> 4) &
+                      (kAfeyeApiCells - 1);
+  std::lock_guard<std::mutex> lock(g_afeye_api_mu);
+  for (size_t i = 0; i < kAfeyeApiCells; ++i) {
+    AfeyeApiCell& c = g_afeye_api_cells[(slot + i) & (kAfeyeApiCells - 1)];
+    if (c.orig == nullptr) {
+      c.orig = orig;
+      c.prop = property_name;
+      std::snprintf(c.what, sizeof(c.what), "dom %s.%s %s", interface_name,
+                    accessor, property_name);
+      return v8::External::New(isolate, &c, v8::kExternalPointerTypeTagDefault);
+    }
+    if (c.orig == orig && std::strcmp(c.prop, property_name) == 0) {
+      return v8::External::New(isolate, &c, v8::kExternalPointerTypeTagDefault);
+    }
+  }
+  blink::afeye::AfeyeCapConsume(&g_afeye_cells, 65536, "dom-cells");
+  return v8::Local<v8::Value>();
+}
+#endif
