+void AfeyeDomApiThunk(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  AfeyeApiCell* cell = nullptr;
+  v8::Local<v8::Value> data = info.Data();
+  if (data->IsExternal()) {
+    cell = static_cast<AfeyeApiCell*>(data.As<v8::External>()->Value(v8::kExternalPointerTypeTagDefault));
