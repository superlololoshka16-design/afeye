+  if (cell) {
+    if (blink::afeye::AfeyeCapConsume(&g_afeye_api_calls, 8000000,
+                                      "dom-api")) {
+      blink::afeye::EmitStr(blink::afeye::kDomApi,
+                            blink::afeye::NowNs(), cell->what);
+    }
