+// Explicit JS type tag. The etalon requires the RETURN TYPE as a field,
+// not inferred from the value's render shape ("[object]" told an
+// HTMLCanvasElement from a plain Object). This gives the type directly.
+const char* AfeyeTypeOf(v8::Local<v8::Value> v) {
+  if (v.IsEmpty() || v->IsUndefined()) return "undefined";
+  if (v->IsNull()) return "null";
+  if (v->IsBoolean()) return "bool";
+  if (v->IsNumber()) return "number";
+  if (v->IsString()) return "string";
+  if (v->IsArray()) return "array";
+  if (v->IsFunction()) return "function";
+  return "object";
+}
