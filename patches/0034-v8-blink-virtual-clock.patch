+#ifdef BLINK_AFEYE
+  // afeye 0034: when the virtual clock is on, performance.now() returns
+  // epoch-origin + executed-instruction time. Monotone per instruction
+  // tick, smooth regardless of host speed. Off by default; the 0012
+  // trace above still logs real now() calls for telemetry.
+  if (blink::afeye::Enabled()) {
+    static bool g_afeye_vclock = []() {
+      const char* v = ::getenv("AFEYE_VIRTUAL_CLOCK");
+      return v != nullptr && *v != '\0' && v[0] != '0';
+    }();
+    if (g_afeye_vclock) {
+      static double g_afeye_origin_ms = []() {
+        return base::TimeTicks::Now().since_origin().InMillisecondsF();
