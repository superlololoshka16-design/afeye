diff --git a/services/network/afeye_sink.cc b/services/network/afeye_sink.cc
index 66c5ddb..91389bf 100644
--- a/services/network/afeye_sink.cc
+++ b/services/network/afeye_sink.cc
@@ -201,10 +201,32 @@ void DrainLoop() {
 }
 
 void ReinitAfterFork() {
+  if (!g_on.load(std::memory_order_acquire)) {
+    g_pid.store(::getpid(), std::memory_order_release);
+    return;
+  }
   g_ring.lock.clear(std::memory_order_release);
+  const int parent_fd = g_report_fd.load(std::memory_order_relaxed);
+  if (parent_fd >= 0) {
+    const auto deadline = std::chrono::steady_clock::now() +
+                          std::chrono::milliseconds(100);
+    while (g_ring.tail != g_ring.head &&
+           std::chrono::steady_clock::now() < deadline) {
+      uint32_t len32;
+      std::memcpy(&len32, g_ring.data + g_ring.tail, sizeof(len32));
+      if (len32 < 24 || len32 > kMaxRecord) break;
+      WriteAll(parent_fd, g_ring.data + g_ring.tail, len32);
+      size_t nt = g_ring.tail + len32;
+      if (nt >= kRingBytes) nt -= kRingBytes;
+      g_ring.tail = nt;
+    }
+    WriteDropReport(parent_fd, g_dropped.load(std::memory_order_relaxed),
+                    g_write_err.load(std::memory_order_relaxed));
+    ::close(parent_fd);
+    g_report_fd.store(-1, std::memory_order_relaxed);
+  }
   g_ring.tail = 0;
   g_ring.head = 0;
-  g_dropped.store(0, std::memory_order_relaxed);
   g_pid.store(::getpid(), std::memory_order_release);
   std::thread(DrainLoop).detach();
 }
