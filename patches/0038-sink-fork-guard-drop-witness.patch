 void ReinitAfterFork() {
+  if (!g_on.load(std::memory_order_acquire)) {
+    // Sink disabled: adopt the new pid but do NOT spawn a drain thread.
+    // Without this guard every fork re-armed DrainLoop, which opens a
+    // .rec and emits sink-hello even with AFEYE_SINK unset - poisoning
+    // the sink_alive capture-integrity check (false "afeye-patched").
+    // Mirrors the blink sink guard (0005).
+    g_pid.store(::getpid(), std::memory_order_release);
+    return;
+  }
   g_ring.lock.clear(std::memory_order_release);
   g_ring.tail = 0;
   g_ring.head = 0;
