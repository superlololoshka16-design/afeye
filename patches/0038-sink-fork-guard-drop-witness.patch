@@ -181,6 +183,14 @@ void DrainLoop() {
 }
 
 void ReinitAfterFork() {
+  if (!g_on.load(std::memory_order_acquire)) {
+    // Sink disabled: adopt the new pid but do NOT spawn a drain thread
+    // (guard parity with blink 0005; net lacked it - every fork with the
+    // sink off spawned a DrainLoop that opened a .rec and emitted
+    // sink-hello, poisoning the sink_alive capture-integrity check).
+    g_pid.store(::getpid(), std::memory_order_release);
+    return;
+  }
   g_ring.lock.clear(std::memory_order_release);
   g_ring.tail = 0;
   g_ring.head = 0;
