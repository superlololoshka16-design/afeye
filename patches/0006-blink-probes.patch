+  } else if (raw_data->IsArrayBufferView()) {
+    const DOMArrayBufferView* v = raw_data->GetAsArrayBufferView();
+    if (v) {
+      auto s = v->ByteSpan();
+      p = reinterpret_cast<const uint8_t*>(s.data());
+      n = s.size();
+    }
+  }
+  if (p && n) {
+    blink::afeye::EmitSpan(blink::afeye::kCryptoOp,
+                           blink::afeye::NowNs(), op,
+                           p, static_cast<uint32_t>(n));
+  }
