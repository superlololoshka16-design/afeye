--- a/v8/src/afeye/sink.cc
+++ b/v8/src/afeye/sink.cc
@@ -328,6 +328,24 @@ void EmitWasmMemGrow(size_t old_pages, size_t new_pages) {
   EmitStr(kWasmInstance, NowNs(), afeye_buf);
 }
 
+void EmitWasmMemContent(const void* mem_id, const uint8_t* base,
+                        size_t byte_length) {
+  static std::atomic<uint64_t> g_afeye_wmdump{0};
+  static bool g_afeye_wmdump_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMMEMDUMP");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_wmdump_off) return;
+  if (base == nullptr || byte_length == 0) return;
+  if (g_afeye_wmdump.fetch_add(1, std::memory_order_relaxed) >= 512) return;
+  char afeye_tag[96];
+  std::snprintf(afeye_tag, sizeof(afeye_tag),
+                "wasm-mem-content id=%p len=%llu", mem_id,
+                static_cast<unsigned long long>(byte_length));
+  EmitSpan(kWasmMemory, NowNs(), afeye_tag, base,
+           static_cast<uint32_t>(byte_length));
+}
+
 
 uint64_t SinkDropped() {
   return g_dropped.load(std::memory_order_relaxed) +
