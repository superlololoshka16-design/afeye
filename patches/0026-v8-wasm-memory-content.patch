 }
 
+// afeye (0026): wasm linear-memory CONTENT capture. Called at every
+// WasmMemoryObject::Grow success exit with the live backing store. PoW-style
+// antifraud (Kasada) accumulates its challenge state in linear memory and
+// grows in deterministic bursts - the CONTENT at each grow is the payload
+// the boundary sieve can never see (per-byte JS reads cross no C++ funnel).
+// Same contract as every sink emitter:
+//  - no-alloc on the emit path (EmitSpan copies into the ring under the lock)
+//  - bounded: kSpanCap (64 KiB) head per dump + 512 dumps per process
+//  - env-gated: AFEYE_TRACE_WASMMEMDUMP=0 disables content (grow events stay)
+//  - the dump races a worker thread mutating memory: bytes may tear between
+//    read and ring-copy. Accepted and documented - a torn head still carries
+//    the deterministic burst pattern; exactness needs a stop-the-world dump
+//    (a pause antifraud would detect, defeating the stealth).
+void EmitWasmMemContent(const void* mem_id, const uint8_t* base,
+                        size_t byte_length) {
+  static std::atomic<uint64_t> g_afeye_wmdump{0};
+  static bool g_afeye_wmdump_off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMMEMDUMP");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  if (g_afeye_wmdump_off) return;
+  if (base == nullptr || byte_length == 0) return;
+  if (g_afeye_wmdump.fetch_add(1, std::memory_order_relaxed) >= 512) return;
+  char afeye_tag[96];
+  std::snprintf(afeye_tag, sizeof(afeye_tag),
+                "wasm-mem-content id=%p len=%llu", mem_id,
+                static_cast<unsigned long long>(byte_length));
+  // kind 4 (kWasmMemory) - the collector already names it "wasm-memory";
+  // the tag prefix carries the discriminator, zero wire-format change.
+  EmitSpan(kWasmMemory, NowNs(), afeye_tag, base,
+           static_cast<uint32_t>(byte_length));
+}
