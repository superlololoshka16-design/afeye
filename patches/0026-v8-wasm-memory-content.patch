+// across compaction (unlike heap-value taint). Head-capped by EmitSpan's
+// kSpanCap; per-dump throttle + env gate AFEYE_TRACE_WASMMEMDUMP=0 off.
+void EmitWasmMemContent(const void* mem_id, const uint8_t* base,
+                        size_t byte_length);
