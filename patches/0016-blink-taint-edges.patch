+
+void FormData::SetEntry(const Entry* entry) {
+  DCHECK(entry);
+  bool found = false;
+  wtf_size_t i = 0;
+  while (i < entries_.size()) {
+    if (entries_[i]->name() != entry->name()) {
+      ++i;
+    } else if (found) {
+      entries_.EraseAt(i);
+    } else {
+      found = true;
+      entries_[i] = entry;
+      ++i;
+    }
+  }
+  if (!found)
+    entries_.push_back(entry);
+}
