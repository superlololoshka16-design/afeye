+#include "src/afeye/wasm_shadow.h"
+
+#ifdef V8_AFEYE
+
+#include <atomic>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <sys/mman.h>
+#include <unistd.h>
