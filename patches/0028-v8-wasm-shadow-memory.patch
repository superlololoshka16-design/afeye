+#include "src/afeye/sink.h"
+#include "src/afeye/taint.h"
+
+namespace v8 {
+namespace afeye {
+namespace {
+
+// ---------------------------------------------------------------------------
+// bounds. Each exists so a memory-hungry PoW module cannot turn the tracer into
+// a stall, and every refusal that LOSES taint is counted so the Rust witness
+// never reads a shadow gap as a dead end.
+// ---------------------------------------------------------------------------
+
+// Tracked instances. 64 is far past any real page's module count (antifraud
+// ships 1-3); the table is a fixed array, so the hot path never allocates and
+// never rehashes.
+constexpr size_t kMaxTracked = 64;
+constexpr size_t kTrackedMask = kMaxTracked - 1;
+
+// Per-instance shadow capacity, 1:1 with linear memory. 256 MiB covers the
+// largest memory any realistic PoW uses; the memory32 spec max is 4 GiB, so a
+// bigger module is tracked only up to this cap and the untracked tail counted.
+constexpr size_t kMaxShadowBytes = 256u << 20;
+
+// One bulk op (memory.copy/fill/init) cannot move more shadow bytes than this.
+// A 256 MiB memory.copy would otherwise become a 256 MiB memmove on the wasm
+// thread mid-crawl; the truncated tail is counted.
+constexpr size_t kMaxBulkBytes = 8u << 20;
+
+// One grow-by-copy migration cannot copy more than this. The rekey runs on the
+// JS thread inside memory.grow, so a 256 MiB memcpy there is a visible stall.
+// Truncation is counted.
+constexpr size_t kMigrateCapBytes = 32u << 20;
+
+// Records emitted per process. Bounded like every other afeye stream (0026's
+// content dumps use 512, the taint-edge stream 100k).
+constexpr uint64_t kEmitCap = 100000;
+
+// Bytes of linear memory read into one record body. Matches sink.cc's kSpanCap
+// (EmitSpan head-caps there anyway) so no work is done that gets thrown away.
+constexpr uint32_t kEmitBodyCap = 64u * 1024u;
+
+// Open addressing cannot punch a hole in a probe chain, so a retired slot keeps
+// a tombstone that lookups skip and inserts may reuse. A real mem_id is a
+// page-aligned base pointer and is never 1.
+void* const kTombstone = reinterpret_cast<void*>(1);
+
+struct ShadowEntry {
+  // Published LAST with release ordering: a reader that acquire-loads a
+  // matching mem_id and then sees shadow == nullptr is observing a claim still
+  // in progress, and must bail (a few missed accesses during setup, never a
+  // torn read).
+  std::atomic<uint8_t*> shadow{nullptr};
+  std::atomic<size_t> len{0};
+  // Installed before {shadow} on claim, tombstoned on retire. The claim CAS is
+  // what makes two threads racing on one free slot produce exactly one winner.
+  std::atomic<void*> mem_id{nullptr};
+  // True once this region has held non-zero tags. A fresh mmap is zero-filled by
+  // the kernel, so a slot's first occupant needs no memset and later ones do -
+  // this avoids a 256 MiB memset on first allocation.
+  std::atomic<bool> dirty{false};
+};
+
+ShadowEntry g_shadow[kMaxTracked];
+std::atomic<uint64_t> g_shadow_dropped{0};
+std::atomic<uint64_t> g_shadow_emitted{0};
+std::atomic<uint64_t> g_shadow_live{0};
+
+// The value-taint handoff (see the HONEST PRECISION LIMIT in the header).
+// liftoff has no per-register taint side table, so a tainted value pushed into
+// wasm parks its tag here and the next store on this thread applies it.
+thread_local uint32_t t_store_taint = 0;
+thread_local uint32_t t_load_taint = 0;
+
+// Per-thread emit dedup. A tight PoW loop over one tainted buffer would
+// otherwise emit once per iteration and saturate kEmitCap in milliseconds,
+// drowning every other record in the process. Consecutive IDENTICAL events (same
+// op, offset, length, tag) emit once; the next CHANGE emits again. So record
+// volume tracks taint FLOW, not access count - the honest volume story for a
+// tracing build. 0 is "nothing yet"; no real signature hashes to 0.
+thread_local uint64_t t_last_sig = 0;
+
+// The STAGE half of a bulk op (see the header for why stage/commit and not one
+// callout). Thread-local, not passed back through the generated code: the real
+// memory.copy/fill/init runtime call clobbers caller-saved registers, and the
+// popped VarStates holding the operands are no longer in cache_state, so
+// SpillAllRegisters will not save them. Keeping the operands here means the
+// COMMIT callout takes ZERO arguments and needs no frame-slot or rsp
+// assumption - which is what makes it arch-generic.
+struct StagedBulk {
+  uint32_t op = 0;  // kWasmShadowOpCopy / Fill / Init; 0 = nothing staged
+  void* dst_base = nullptr;
+  size_t dst_off = 0;
+  void* src_base = nullptr;
+  size_t src_off = 0;
+  size_t len = 0;
+};
+thread_local StagedBulk t_staged;
+
+// Bulk/access op ids, internal to this translation unit (the emitted-code seam
+// in wasm_shadow.h uses one dedicated function per operation, not an opcode
+// enum, so these are only for record-tag bookkeeping and the dedup signature).
+enum : uint32_t {
+  kOpNone = 0,
+  kOpLoad = 1,
+  kOpStore = 2,
+  kOpCopy = 3,
+  kOpFill = 4,
+  kOpInit = 5,
+  kOpReKey = 6,
+};
+
+// env gate: AFEYE_WASM_SHADOW=0 disables the whole layer (0026's grow/buffer
+// content dumps keep working; only the per-byte shadow stops). Read once,
+// cached - the same idiom taint.cc uses for AFEYE_TAINT (taint.cc:49-55).
+bool ShadowEnvOn() {
+  static const bool off = []() {
+    const char* v = ::getenv("AFEYE_WASM_SHADOW");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off;
+}
+
+// Emission gate, separate from the tracking gate: AFEYE_TRACE_WASMSHADOW=0 keeps
+// the shadow plus the load/store thread-local seam live but stops records.
+// Matches the series convention of a per-stream AFEYE_TRACE_* knob.
+bool EmitOn() {
+  static const bool off = []() {
+    const char* v = ::getenv("AFEYE_TRACE_WASMSHADOW");
+    return v != nullptr && *v != '\0' && v[0] == '0';
+  }();
+  return !off;
+}
+
+inline void CountDrop() {
+  g_shadow_dropped.fetch_add(1, std::memory_order_relaxed);
+}
+
+// Linear bases are page-aligned, so the low 12 bits carry no entropy: shift them
+// out, then keep the HIGH bits of a multiply (the better half of the mixer) for
+// the 6-bit table index.
+inline size_t HashId(const void* mem_id) {
+  uint64_t v = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(mem_id)) >> 12;
+  v *= 0x9E3779B97F4A7C15ull;
+  return static_cast<size_t>(v >> 51) & kTrackedMask;
+}
+
+// Probe for {mem_id}. Stops at the first genuinely empty slot (end of chain),
+// skips tombstones and foreign keys. The returned entry may still have
+// shadow == nullptr (claim in progress) - callers must check.
+inline ShadowEntry* FindEntry(void* mem_id) {
+  size_t idx = HashId(mem_id);
+  for (size_t p = 0; p < kMaxTracked; ++p) {
+    ShadowEntry* e = &g_shadow[idx & kTrackedMask];
+    void* k = e->mem_id.load(std::memory_order_acquire);
+    if (k == mem_id) return e;
+    if (k == nullptr) return nullptr;
+    ++idx;
+  }
+  return nullptr;  // probe budget exhausted (table saturated)
+}
+
+// Claim a slot: an existing entry if {mem_id} is already tracked, else a freshly
+// claimed one (mem_id CAS-installed, shadow/len NOT yet published). nullptr =
+// table full; the caller counts that as a drop.
+inline ShadowEntry* ClaimSlot(void* mem_id) {
+  size_t idx = HashId(mem_id);
+  ShadowEntry* reuse = nullptr;
+  for (size_t p = 0; p < kMaxTracked; ++p) {
+    ShadowEntry* e = &g_shadow[idx & kTrackedMask];
+    void* k = e->mem_id.load(std::memory_order_acquire);
+    if (k == mem_id) return e;  // another thread won the race to track it
+    if (k == nullptr) {
+      void* expected = nullptr;
+      if (e->mem_id.compare_exchange_strong(expected, mem_id,
+                                            std::memory_order_acq_rel,
+                                            std::memory_order_relaxed)) {
+        return e;
+      }
+      return FindEntry(mem_id);  // lost the race; re-probe for the winner's key
+    }
+    if (k == kTombstone && reuse == nullptr) reuse = e;
+    ++idx;
+  }
+  if (reuse != nullptr) {
+    void* expected = kTombstone;
+    if (reuse->mem_id.compare_exchange_strong(expected, mem_id,
+                                              std::memory_order_acq_rel,
+                                              std::memory_order_relaxed)) {
+      return reuse;
+    }
+    return FindEntry(mem_id);
+  }
+  return nullptr;  // every slot holds a live foreign key
+}
+
+// The mapping for a slot, created at most once per slot for the process lifetime.
+// mmap rather than malloc: the region must be zero-filled on first touch (the
+// kernel gives that free), must not perturb the V8 heap or its accounting, and
+// must be cheap to leave reserved-but-untouched. MAP_NORESERVE keeps
+// kMaxShadowBytes of ADDRESS SPACE per slot from becoming committed memory -
+// physical pages materialize only where a tag is actually written. This is the
+// reserve-address-space-then-touch-lazily shape V8 itself uses for wasm memory
+// (src/base/platform/platform-posix.cc:136 sets MAP_ANONYMOUS; :680 and :1186
+// use MAP_ANONYMOUS|MAP_PRIVATE), and afeye already talks to the kernel directly
+// instead of through base/ (sink.cc:17-21 includes fcntl.h/unistd.h and calls
+// ::open/::write).
+uint8_t* SlotMapping(ShadowEntry* e) {
+  uint8_t* cur = e->shadow.load(std::memory_order_relaxed);
+  if (cur != nullptr) return cur;
+  int flags = MAP_PRIVATE | MAP_ANONYMOUS;
+#ifdef MAP_NORESERVE
+  flags |= MAP_NORESERVE;
+#endif
+  void* p = ::mmap(nullptr, kMaxShadowBytes, PROT_READ | PROT_WRITE, flags, -1,
+                   0);
+  if (p == MAP_FAILED) return nullptr;
+  uint8_t* region = static_cast<uint8_t*>(p);
+  e->len.store(0, std::memory_order_relaxed);
+  e->dirty.store(false, std::memory_order_relaxed);
+  // Release-publish so a reader that sees the pointer also sees len/dirty.
+  e->shadow.store(region, std::memory_order_release);
+  return region;
+}
+
+// Publish a tracked length over an already-mapped, already-zeroed region.
+// {must_zero} forces a memset because the region is being handed to a NEW
+// occupant and may still carry the previous one's tags.
+void Publish(ShadowEntry* e, size_t byte_length, bool must_zero) {
+  uint8_t* region = e->shadow.load(std::memory_order_relaxed);
+  size_t len = byte_length < kMaxShadowBytes ? byte_length : kMaxShadowBytes;
+  if (byte_length > kMaxShadowBytes) CountDrop();  // untracked tail
+  if (must_zero && len > 0) {
+    std::memset(region, 0, len);
+    e->dirty.store(false, std::memory_order_relaxed);
+  }
+  e->len.store(len, std::memory_order_release);
+}
+
+// ---------------------------------------------------------------------------
+// TAG NARROWING. A shadow byte is ONE byte (1:1 with linear memory, which is
+// what keeps a 256 MiB memory's shadow at 256 MiB instead of 1 GiB) but a
+// TaintTag is 32 bits. The eight NAMED sources (taint.h:28-39) are
+// kSrcFingerprint..kSrcWasm = bits 0..7, which fit a byte exactly. Only kSrcOther
+// (bit 31, the "folded source" escape hatch whose real identity rides in a
+// record's tag string, not in a bit) has nowhere to go, so it shares bit 7 with
+// kSrcWasm and reads back AS kSrcWasm.
+//
+// That loss is deliberate and bounded: inside linear memory both mean
+// "engine-internal, not one of the seven named capture sources", and the identity
+// kSrcOther was folding is already carried by the boundary record that created
+// it. Widening never invents a bit that was not narrowed in.
+// ---------------------------------------------------------------------------
+constexpr uint32_t kNarrowNamedMask = 0x7Fu;  // bits 0..6
+constexpr uint8_t kNarrowWasmBit = 0x80u;     // bit 7 = kSrcWasm | kSrcOther
+
+inline uint8_t NarrowTag(uint32_t tag) {
+  uint8_t b = static_cast<uint8_t>(tag & kNarrowNamedMask);
+  if ((tag & (static_cast<uint32_t>(kSrcWasm) |
+              static_cast<uint32_t>(kSrcOther))) != 0) {
+    b |= kNarrowWasmBit;
+  }
+  return b;
+}
+
+inline uint32_t WidenTag(uint8_t b) {
+  uint32_t tag = static_cast<uint32_t>(b & kNarrowNamedMask);
+  if ((b & kNarrowWasmBit) != 0) tag |= static_cast<uint32_t>(kSrcWasm);
+  return tag;
+}
+
+// Resolve (mem_id -> shadow region), clamping {offset}/{size} into the tracked
+// range. Returns nullptr for an untracked memory, which is the NORMAL case for
+// instances the layer never claimed: it is not a drop and is deliberately NOT
+// counted (counting it would turn every access of every untracked module into
+// witness noise and hide real losses).
+inline uint8_t* Resolve(void* mem_id, size_t* offset, size_t* size,
+                        size_t* len_out) {
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e == nullptr) return nullptr;
+  uint8_t* region = e->shadow.load(std::memory_order_acquire);
+  if (region == nullptr) return nullptr;  // claim still in progress
+  size_t len = e->len.load(std::memory_order_relaxed);
+  if (len == 0 || *size == 0 || *offset >= len) return nullptr;
+  if (*size > len - *offset) *size = len - *offset;
+  *len_out = len;
+  return region;
+}
+
+inline void MarkDirty(void* mem_id) {
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e != nullptr) e->dirty.store(true, std::memory_order_relaxed);
+}
+
+// OR-reduce {n} shadow bytes at {p}. {n} is already clamped by Resolve.
+inline uint32_t ReduceRange(const uint8_t* p, size_t n) {
+  uint8_t acc = 0;
+  for (size_t i = 0; i < n; ++i) acc = static_cast<uint8_t>(acc | p[i]);
+  return WidenTag(acc);
+}
+
+// ---------------------------------------------------------------------------
+// RECORD EMISSION. Every record rides kind 4 (kWasmMemory) through the existing
+// EmitSpan - the same path 0026's EmitWasmMemContent uses - so the Rust side
+// already knows how to split tag/body and blake3-join the body against every
+// other payload span (req-body, stringify-head). Tag = NUL-terminated prefix,
+// body = the ACTUAL linear-memory bytes at the affected range.
+//
+// Two kinds of event are emitted, and both matter to the fact graph:
+//   TAINT MOVED  (after != 0) - the normal capture edge;
+//   TAINT ERASED (before != 0, after == 0) - an untainted store/fill/init over
+//     bytes that WERE tainted. This is what lets the graph explain a chain that
+//     genuinely ended inside wasm instead of guessing, so `dead-end-proven`
+//     stays an honest verdict rather than a coverage hole.
+//
+// The body is read from the live linear memory, so it can tear against a
+// concurrent wasm thread mutating the same bytes. Accepted and documented -
+// exactly the trade 0026's content dumps make; stop-the-world would be
+// detectable by the antifraud this traces.
+// ---------------------------------------------------------------------------
+
+inline uint64_t Sig(uint64_t op, uint64_t a, uint64_t b, uint64_t c) {
+  uint64_t h = 1469598103934665603ull;  // FNV-1a over the 4 fields
+  const uint64_t f[4] = {op, a, b, c};
+  for (int i = 0; i < 4; ++i) {
+    for (int j = 0; j < 8; ++j) {
+      h ^= (f[i] >> (j * 8)) & 0xff;
+      h *= 1099511628211ull;
+    }
+  }
+  return h == 0 ? 1 : h;  // 0 is the "nothing yet" sentinel
+}
+
+// {base} is the linear memory base (the mem_id the callout was handed), so the
+// body is the real wasm bytes at {off}. {n} is already clamped. {base} may be
+// nullptr for a bodyless record.
+void EmitShadow(const char* tag, const void* base, size_t off, size_t n,
+                uint64_t sig) {
+  if (!EmitOn()) return;
+  if (g_shadow_emitted.load(std::memory_order_relaxed) >= kEmitCap) return;
+  if (sig == t_last_sig) return;  // same event as last time on this thread
+  t_last_sig = sig;
+  g_shadow_emitted.fetch_add(1, std::memory_order_relaxed);
+
+  uint32_t body = 0;
+  if (base != nullptr) {
+    body = n > kEmitBodyCap ? kEmitBodyCap : static_cast<uint32_t>(n);
+  }
+  if (body == 0) {
+    // EmitSpan drops len==0 spans, so a bodyless record still needs one byte.
+    static const uint8_t kNil = 0;
+    EmitSpan(kWasmMemory, NowNs(), tag, &kNil, 1);
+    return;
+  }
+  const uint8_t* p = static_cast<const uint8_t*>(base) + off;
+  EmitSpan(kWasmMemory, NowNs(), tag, p, body);
+}
+
+// The single store path shared by WasmShadowOnStore and the fill commit, so the
+// overwrite-vs-augment law is written exactly once.
+void ApplyStoreTag(void* base, uint8_t* p, size_t n, bool augment,
+                   uint32_t tag, uint32_t before, uint64_t op_id, size_t off) {
+  const uint8_t b = NarrowTag(tag);
+  if (augment) {
+    // Atomic RMW: the result combines the OLD memory value with the operand, so
+    // the old tag survives (OR). Erasing it here would drop a real source.
+    for (size_t i = 0; i < n; ++i) p[i] = static_cast<uint8_t>(p[i] | b);
+  } else {
+    // Plain store/fill REPLACES the destination bytes, so the old tag is gone
+    // and each byte takes the value's tag exactly. Without the clearing, a buffer
+    // rewritten in a loop would accumulate taint forever and every later read
+    // would report a source that is no longer in the data - a false "proven",
+    // which is worse than a missed one.
+    std::memset(p, static_cast<int>(b), n);
+  }
+  if (b != 0) MarkDirty(base);
+
+  if (tag == 0 && before == 0) return;  // nothing moved and nothing erased
+  char text[192];
+  if (op_id == kOpFill) {
+    std::snprintf(text, sizeof(text),
+                  "wasm-shadow-fill off=%llu len=%llu taint=0x%x was=0x%x"
+                  " erase=%d",
+                  static_cast<unsigned long long>(off),
+                  static_cast<unsigned long long>(n), tag, before,
+                  (tag == 0 && before != 0) ? 1 : 0);
+  } else {
+    std::snprintf(text, sizeof(text),
+                  "wasm-shadow-store off=%llu len=%llu taint=0x%x was=0x%x"
+                  " erase=%d atomic=%d",
+                  static_cast<unsigned long long>(off),
+                  static_cast<unsigned long long>(n), tag, before,
+                  (tag == 0 && before != 0) ? 1 : 0, augment ? 1 : 0);
+  }
+  EmitShadow(text, base, off, n, Sig(op_id, off, n, (static_cast<uint64_t>(tag)
+                                                          << 32) |
+                                                         before));
+}
+
+}  // namespace
+
+bool WasmShadowEnabled() { return Enabled() && ShadowEnvOn(); }
+
+bool ShadowAlloc(void* mem_id, size_t byte_length) {
+  if (!WasmShadowEnabled() || mem_id == nullptr) return false;
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e != nullptr && e->shadow.load(std::memory_order_acquire) != nullptr) {
+    // Already tracked (a re-entrant New, or a base that survived): just make sure
+    // the length covers the request.
+    if (byte_length > e->len.load(std::memory_order_relaxed)) {
+      Publish(e, byte_length, false);
+    }
+    return true;
+  }
+  e = ClaimSlot(mem_id);
+  if (e == nullptr) {
+    CountDrop();  // table full: this memory's taint is invisible - say so
+    return false;
+  }
+  // A slot handed over from a previous occupant must be scrubbed; a never-used
+  // slot's fresh mmap is already zero.
+  const bool must_zero = e->dirty.load(std::memory_order_relaxed);
+  if (SlotMapping(e) == nullptr) {
+    CountDrop();  // mmap failed (ENOMEM / address-space exhaustion)
+    e->len.store(0, std::memory_order_relaxed);
+    e->mem_id.store(nullptr, std::memory_order_release);
+    return false;
+  }
+  Publish(e, byte_length, must_zero);
+  g_shadow_live.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
+
+void ShadowGrow(void* mem_id, size_t new_byte_length) {
+  if (!WasmShadowEnabled() || mem_id == nullptr) return;
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e == nullptr) return;
+  if (e->shadow.load(std::memory_order_acquire) == nullptr) return;
+  // INPLACE grow (wasm-objects.cc:1121 shared, :1140 non-shared): the base did not
+  // move, so the key is unchanged and the region only extends. No remap, no tag
+  // copy - the mapping was reserved at kMaxShadowBytes up front. A shrink is
+  // ignored (tags past the new end simply go unread).
+  if (new_byte_length <= e->len.load(std::memory_order_relaxed)) return;
+  Publish(e, new_byte_length, false);
+}
+
+void ShadowReKey(void* old_mem_id, void* new_mem_id, size_t new_byte_length) {
+  if (!WasmShadowEnabled() || new_mem_id == nullptr) return;
+  ShadowEntry* old_e =
+      (old_mem_id != nullptr) ? FindEntry(old_mem_id) : nullptr;
+  uint8_t* old_region = nullptr;
+  size_t old_len = 0;
+  if (old_e != nullptr) {
+    old_region = old_e->shadow.load(std::memory_order_acquire);
+    old_len = old_e->len.load(std::memory_order_relaxed);
+  }
+
+  // Claim the NEW slot first. If that fails, the old tags stay readable under the
+  // now-dead old key - counted, because from the graph's point of view the taint
+  // stopped following the memory.
+  ShadowEntry* new_e = FindEntry(new_mem_id);
+  if (new_e == nullptr ||
+      new_e->shadow.load(std::memory_order_acquire) == nullptr) {
+    new_e = ClaimSlot(new_mem_id);
+    if (new_e == nullptr) {
+      CountDrop();
+      return;
+    }
+    const bool must_zero = new_e->dirty.load(std::memory_order_relaxed);
+    if (SlotMapping(new_e) == nullptr) {
+      CountDrop();
+      new_e->len.store(0, std::memory_order_relaxed);
+      new_e->mem_id.store(nullptr, std::memory_order_release);
+      return;
+    }
+    Publish(new_e, new_byte_length, must_zero);
+    g_shadow_live.fetch_add(1, std::memory_order_relaxed);
+  } else if (new_byte_length > new_e->len.load(std::memory_order_relaxed)) {
+    Publish(new_e, new_byte_length, false);
+  }
+
+  uint8_t* new_region = new_e->shadow.load(std::memory_order_acquire);
+  if (new_region == nullptr) return;
+  const size_t new_len = new_e->len.load(std::memory_order_relaxed);
+
+  // Migrate the tags. COPY grow (wasm-objects.cc:1158-1182) installs a NEW
+  // BackingStore, so buffer_start() - and the key - CHANGES. Without this copy
+  // every grow-by-copy would silently orphan the taint accumulated so far: a
+  // false dead-end on exactly the memory-hungry PoW modules this layer exists to
+  // follow.
+  size_t migrated = 0;
+  bool truncated = false;
+  if (old_region != nullptr && old_len > 0) {
+    size_t n = old_len < new_len ? old_len : new_len;
+    if (n > kMigrateCapBytes) {
+      n = kMigrateCapBytes;
+      truncated = true;
+      CountDrop();  // the tail's tags are lost - counted, never silent
+    }
+    // memmove, not memcpy: the regions are distinct slots here, but never assume
+    // it.
+    std::memmove(new_region, old_region, n);
+    migrated = n;
+    new_e->dirty.store(true, std::memory_order_relaxed);
+    old_e->dirty.store(false, std::memory_order_relaxed);
+  }
+
+  // Retire the OLD key. Tombstone, never nullptr: an open-addressed chain cannot
+  // have a hole punched in it without orphaning every entry probed past the hole.
+  if (old_e != nullptr && old_e != new_e) {
+    if (old_region != nullptr && old_len > 0) {
+      // Scrub for the slot's next occupant.
+      std::memset(old_region, 0, old_len);
+    }
+    old_e->len.store(0, std::memory_order_relaxed);
+    old_e->mem_id.store(kTombstone, std::memory_order_release);
+    g_shadow_live.fetch_sub(1, std::memory_order_relaxed);
+  }
+
+  // The rekey record is the proof that taint SURVIVED a grow-by-copy - without it
+  // a chain that crosses a grow looks broken even when it is not.
+  char tag[192];
+  std::snprintf(tag, sizeof(tag),
+                "wasm-shadow-rekey old=0x%llx new=0x%llx len=%llu migrated=%llu"
+                " truncated=%d",
+                static_cast<unsigned long long>(
+                    reinterpret_cast<uintptr_t>(old_mem_id)),
+                static_cast<unsigned long long>(
+                    reinterpret_cast<uintptr_t>(new_mem_id)),
+                static_cast<unsigned long long>(new_byte_length),
+                static_cast<unsigned long long>(migrated), truncated ? 1 : 0);
+  EmitShadow(tag, nullptr, 0, 0,
+             Sig(kOpReKey, reinterpret_cast<uintptr_t>(new_mem_id),
+                 new_byte_length, migrated));
+}
+
+// NOTE ON LIFETIME - why this never munmaps. ShadowFree retires a KEY, not a
+// mapping. A concurrent wasm thread may sit between "FindEntry matched" and "read
+// region[i]" when the JS thread frees or grow-by-copies the memory; V8 keeps the
+// OLD backing store alive for exactly that reason (wasm-objects.cc detaches the
+// old buffer only after the new one is installed), and the shadow has to be at
+// least as conservative. Unmapping here would be a use-after-free on the tracer's
+// own bookkeeping. Instead the slot keeps its mapping (kMaxTracked mappings for
+// the whole process, kMaxShadowBytes of NORESERVE address space each, physical
+// pages only where a tag was written) and is scrubbed + recycled by the next
+// ShadowAlloc. Bounded by construction.
+void ShadowFree(void* mem_id) {
+  if (mem_id == nullptr) return;
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e == nullptr) return;
+  uint8_t* region = e->shadow.load(std::memory_order_acquire);
+  size_t len = e->len.load(std::memory_order_relaxed);
+  if (region != nullptr && len > 0) std::memset(region, 0, len);
+  e->len.store(0, std::memory_order_relaxed);
+  e->dirty.store(false, std::memory_order_relaxed);
+  e->mem_id.store(kTombstone, std::memory_order_release);
+  g_shadow_live.fetch_sub(1, std::memory_order_relaxed);
+}
+
+uint8_t* ShadowGet(void* mem_id) {
+  if (mem_id == nullptr) return nullptr;
+  ShadowEntry* e = FindEntry(mem_id);
+  if (e == nullptr) return nullptr;
+  return e->shadow.load(std::memory_order_acquire);
+}
+
+void ShadowSetRange(void* mem_id, size_t offset, size_t len, uint32_t tag) {
+  if (!WasmShadowEnabled() || len == 0) return;
+  size_t size = len;
+  size_t tracked = 0;
+  uint8_t* region = Resolve(mem_id, &offset, &size, &tracked);
+  if (region == nullptr) return;
+  // AUGMENT semantics (the DTT union law, taint.h:64-67): existing bits survive,
+  // for a C++ caller adding provenance to bytes it did not overwrite. The emitted
+  // store path uses overwrite semantics instead, because there the bytes ARE
+  // replaced.
+  const uint8_t b = NarrowTag(tag);
+  if (b == 0) return;
+  uint8_t* p = region + offset;
+  for (size_t i = 0; i < size; ++i) p[i] = static_cast<uint8_t>(p[i] | b);
+  MarkDirty(mem_id);
+}
+
+uint32_t ShadowGetRange(void* mem_id, size_t offset, size_t len) {
+  if (len == 0) return 0;
+  size_t size = len;
+  size_t tracked = 0;
+  const uint8_t* region = Resolve(mem_id, &offset, &size, &tracked);
+  if (region == nullptr) return 0;
+  return ReduceRange(region + offset, size);
+}
+
+void WasmShadowOnLoad(uintptr_t mem_id, uintptr_t offset, uintptr_t size) {
+  // The runtime half of the two-level gate. The callout was already emitted (the
+  // compile-time WasmShadowEnabled() check decided that once per function), so all
+  // that is left is this table probe - and for an untracked instance it returns
+  // after one failed probe. That is the whole point of keying by the base pointer
+  // the register already holds.
+  void* base = reinterpret_cast<void*>(mem_id);
+  size_t off = static_cast<size_t>(offset);
+  size_t n = static_cast<size_t>(size);
+  size_t tracked = 0;
+  const uint8_t* region = Resolve(base, &off, &n, &tracked);
+  if (region == nullptr) return;
+
+  // LOAD: OR-reduce the range - that is the taint of the value just read.
+  const uint32_t t = ReduceRange(region + off, n);
+  // Publish for the JS boundary seam: when this load's value flows out of a wasm
+  // export, the boundary layer reads it back so an in-memory value crossing into
+  // JS still carries its sources.
+  t_load_taint = t;
+  if (t == 0) return;
+
+  char tag[160];
+  std::snprintf(tag, sizeof(tag), "wasm-shadow-load off=%llu len=%llu taint=0x%x",
+                static_cast<unsigned long long>(off),
+                static_cast<unsigned long long>(n), t);
+  EmitShadow(tag, base, off, n, Sig(kOpLoad, off, n, t));
+}
+
+void WasmShadowOnStore(uintptr_t mem_id, uintptr_t offset, uintptr_t size,
+                       uintptr_t augment) {
+  void* base = reinterpret_cast<void*>(mem_id);
+  size_t off = static_cast<size_t>(offset);
+  size_t n = static_cast<size_t>(size);
+  size_t tracked = 0;
+  uint8_t* region = Resolve(base, &off, &n, &tracked);
+  if (region == nullptr) return;
+
+  const uint32_t before = ReduceRange(region + off, n);
+  // Take the tag the interpreter/boundary layer parked when the value was pushed,
+  // and CONSUME it so a stale tag cannot leak onto the next store. This is the
+  // documented precision limit - see the header. It over-attributes (a store may
+  // pick up a tag from an earlier push on this thread) and never under-attributes.
+  const uint32_t t = t_store_taint;
+  t_store_taint = 0;
+  ApplyStoreTag(base, region + off, n, augment != 0, t, before, kOpStore, off);
+}
+
+void WasmShadowStageCopy(uintptr_t dst_mem_id, uintptr_t dst_off,
+                         uintptr_t src_mem_id, uintptr_t src_off,
+                         uintptr_t len) {
+  size_t n = static_cast<size_t>(len);
+  if (n == 0) {
+    t_staged.op = kOpNone;  // nothing to apply; a stale stage must not survive
+    return;
+  }
+  if (n > kMaxBulkBytes) {
+    n = kMaxBulkBytes;
+    CountDrop();  // truncated bulk op: the tail did not follow - counted
+  }
+  t_staged.op = kOpCopy;
+  t_staged.dst_base = reinterpret_cast<void*>(dst_mem_id);
+  t_staged.dst_off = static_cast<size_t>(dst_off);
+  t_staged.src_base = reinterpret_cast<void*>(src_mem_id);
+  t_staged.src_off = static_cast<size_t>(src_off);
+  t_staged.len = n;
+}
+
+void WasmShadowStageFill(uintptr_t mem_id, uintptr_t dst_off, uintptr_t len) {
+  size_t n = static_cast<size_t>(len);
+  if (n == 0) {
+    t_staged.op = kOpNone;
+    return;
+  }
+  if (n > kMaxBulkBytes) {
+    n = kMaxBulkBytes;
+    CountDrop();
+  }
+  t_staged.op = kOpFill;
+  t_staged.dst_base = reinterpret_cast<void*>(mem_id);
+  t_staged.dst_off = static_cast<size_t>(dst_off);
+  t_staged.src_base = nullptr;
+  t_staged.src_off = 0;
+  t_staged.len = n;
+}
+
+void WasmShadowStageInit(uintptr_t mem_id, uintptr_t dst_off, uintptr_t len) {
+  size_t n = static_cast<size_t>(len);
+  if (n == 0) {
+    t_staged.op = kOpNone;
+    return;
+  }
+  if (n > kMaxBulkBytes) {
+    n = kMaxBulkBytes;
+    CountDrop();
+  }
+  t_staged.op = kOpInit;
+  t_staged.dst_base = reinterpret_cast<void*>(mem_id);
+  t_staged.dst_off = static_cast<size_t>(dst_off);
+  t_staged.src_base = nullptr;
+  t_staged.src_off = 0;
+  t_staged.len = n;
+}
+
+void WasmShadowCommit() {
+  // Copy out and clear the stage first: the record body read below can be slow
+  // (up to 64 KiB), and leaving the stage set would let an unrelated trapped op
+  // on this thread re-commit it.
+  const StagedBulk s = t_staged;
+  t_staged.op = kOpNone;
+  if (s.op == kOpNone) return;  // trapped op, or nothing was ever staged
+
+  if (s.op == kOpInit) {
+    size_t off = s.dst_off;
+    size_t n = s.len;
+    size_t tracked = 0;
+    uint8_t* region = Resolve(s.dst_base, &off, &n, &tracked);
+    if (region == nullptr) return;
+    // memory.init copies from a DATA SEGMENT. Segment bytes are static module
+    // content - present in the .wasm blob at compile time, never tainted at
+    // runtime - so the destination is overwritten UNTAINTED and clearing here is
+    // EXACT, not an approximation. Recorded only when that clearing actually
+    // destroyed taint, which is the causally interesting case (and keeps a
+    // segment-heavy module from flooding the stream).
+    const uint32_t before = ReduceRange(region + off, n);
+    std::memset(region + off, 0, n);
+    if (before == 0) return;
+    char tag[160];
+    std::snprintf(tag, sizeof(tag),
+                  "wasm-shadow-init off=%llu len=%llu was=0x%x erase=1",
+                  static_cast<unsigned long long>(off),
+                  static_cast<unsigned long long>(n), before);
+    EmitShadow(tag, s.dst_base, off, n, Sig(kOpInit, off, n, before));
+    return;
+  }
+
+  if (s.op == kOpFill) {
+    size_t off = s.dst_off;
+    size_t n = s.len;
+    size_t tracked = 0;
+    uint8_t* region = Resolve(s.dst_base, &off, &n, &tracked);
+    if (region == nullptr) return;
+    // memory.fill writes one byte value across the range, so every byte takes
+    // that value's taint (0 clears). Same overwrite law as a plain store.
+    const uint32_t before = ReduceRange(region + off, n);
+    const uint32_t t = t_store_taint;
+    t_store_taint = 0;
+    ApplyStoreTag(s.dst_base, region + off, n, false, t, before, kOpFill, off);
+    return;
+  }
+
+  // kOpCopy: memory.copy moves bytes, and the tags must move with them - dst
+  // takes src's tag per byte (overwrite, since dst's bytes are replaced).
+  size_t d_off = s.dst_off;
+  size_t d_n = s.len;
+  size_t s_off = s.src_off;
+  size_t s_n = s.len;
+  size_t d_tracked = 0;
+  size_t s_tracked = 0;
+  uint8_t* dst_region = Resolve(s.dst_base, &d_off, &d_n, &d_tracked);
+  if (dst_region == nullptr) return;
+  const uint8_t* src_region = Resolve(s.src_base, &s_off, &s_n, &s_tracked);
+  if (src_region == nullptr) {
+    // Source untracked, so its taint is unknown. Leaving the destination alone is
+    // the conservative choice - erasing could destroy a real tag. Not counted:
+    // nothing was observed and then lost.
+    return;
+  }
+  // src and dst may be the SAME memory with overlapping ranges, so the copy must
+  // be overlap-safe.
+  const uint32_t src_tag = ReduceRange(src_region + s_off, s_n);
+  size_t m = d_n < s_n ? d_n : s_n;
+  if (m == 0) return;
+  std::memmove(dst_region + d_off, src_region + s_off, m);
+  MarkDirty(s.dst_base);
+  if (src_tag == 0) return;
+  char tag[192];
+  std::snprintf(tag, sizeof(tag),
+                "wasm-shadow-copy dst_off=%llu src_off=%llu len=%llu taint=0x%x",
+                static_cast<unsigned long long>(d_off),
+                static_cast<unsigned long long>(s_off),
+                static_cast<unsigned long long>(m), src_tag);
+  EmitShadow(tag, s.dst_base, d_off, m,
+             Sig(kOpCopy, d_off, s_off,
+                 (static_cast<uint64_t>(m) << 32) | src_tag));
+}
+
+void WasmShadowPushStoreTaint(uint32_t tag) { t_store_taint = tag; }
+
+uint32_t WasmShadowConsumeLoadTaint() {
+  uint32_t t = t_load_taint;
+  t_load_taint = 0;
+  return t;
+}
+
+uint64_t WasmShadowDropped() {
+  return g_shadow_dropped.load(std::memory_order_relaxed);
+}
+
+}  // namespace afeye
+}  // namespace v8
+
+#endif  // V8_AFEYE
