+#ifndef V8_AFEYE_WASM_SHADOW_H_
+#define V8_AFEYE_WASM_SHADOW_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef V8_AFEYE
+
+namespace v8 {
+namespace afeye {
+
+// afeye (0028): 1:1 SHADOW MEMORY for every tracked wasm linear memory.
+//
+// The boundary sieve (sink.cc) sees only values that CROSS a C++ API edge, and
+// 0026's dumps see only the CONTENT at grow / buffer-readout moments. An
+// antifraud that shuffles bytes purely INSIDE linear memory - store at 0x1000,
+// memory.copy to 0x4000, load back, feed an i32 out - crosses neither. The
+// shadow closes that hole: one tag byte per byte of linear memory, propagated
+// by the emitted code, so a fingerprint byte that entered linear memory is
+// still identified when it leaves, however many pure-wasm transforms it
+// survived.
+//
+// KEYING (corrected against the original brief; verified at rev d1fed5cd).
+// The shadow is keyed by the linear memory's BASE POINTER (buffer_start()),
+// NOT by BackingStore*. That base is the only identity already live in a
+// register at every emitted Load/Store site:
+//   wasm-objects.cc:783-790   SetInstanceMemory computes base_address =
+//                             backing_store->buffer_start() and passes it to
+//                             SetRawMemory(memory_index, base_address, len)
+//   wasm-objects.cc:1419-1435 SetRawMemory stores it at kMemory0StartOffset
+//                             (and in the bases-and-sizes array for index > 0)
+//   liftoff-assembler-inl.h:313-327 LoadMemoryStart loads exactly that field
+// So the emitted callout passes the `mem` register verbatim - no instance_data
+// indirection per access. The backing store is off-heap and does not move, so
+// the key is GC-stable: the same soundness argument taint.h:44-46 makes for
+// kKeyWasm.
+//
+// RESIZE SOUNDNESS - the failure mode that would silently kill capture:
+//   INPLACE grow (wasm-objects.cc:1121 shared, :1140 non-shared) keeps
+//                buffer_start() stable, so the key is unchanged and the region
+//                merely EXTENDS (ShadowGrow). No copy.
+//   COPY grow    (wasm-objects.cc:1158-1182) installs a NEW BackingStore, so
+//                buffer_start() - and the key - CHANGES. ShadowReKey migrates
+//                the old tags to the new key and retires the old one. Without
+//                it every grow-by-copy would orphan the taint accumulated so
+//                far: a false dead-end on exactly the memory-hungry PoW modules
+//                this layer exists to follow. The migrate copy is CAPPED
+//                (kMigrateCapBytes) and truncation is COUNTED, so a 256 MB grow
+//                cannot stall the crawl on a 256 MB memcpy and the lost tail is
+//                never silent.
+//
+// HONEST PRECISION LIMIT (documented, not papered over).
+// liftoff keeps wasm values in REGISTERS with no per-register taint side table,
+// so a value's taint cannot follow it through locals or arithmetic inside wasm.
+// What this layer IS exact about:
+//   - byte-range to byte-range flows (memory.copy / memory.fill / memory.init,
+//     and each load/store's own tag bytes) - exact, no approximation;
+//   - the tag a LOAD reads out, published for the JS boundary seam;
+//   - the tag a STORE writes, taken from a thread-local set by the
+//     interpreter/boundary layer (0027) when a tainted value was pushed.
+// The thread-local handoff means a store may CONSERVATIVELY over-attribute a tag
+// left by an earlier push on the same thread; it never under-attributes.
+// Over-attribution is the accepted trade - for capture, a plausible false link
+// beats a silent hole. Threading a real per-register taint table through every
+// liftoff handler is the follow-up this layer is staged for.
+//
+// Discipline matches sink.cc / taint.cc: no-alloc on the hot path (regions are
+// pre-mapped, the table is a fixed array), bounded (kMaxTracked instances,
+// kMaxShadowBytes per instance, kMaxBulkBytes per bulk op, kMigrateCapBytes per
+// rekey, kEmitCap records), env-gated (AFEYE_WASM_SHADOW=0 disables the layer,
+// AFEYE_TRACE_WASMSHADOW=0 disables only the records), and every refusal that
+// LOSES taint is COUNTED so a shadow gap is never read as a dead end.
+
+// ---------------------------------------------------------------------------
+// The emitted-callout ABI.
+//
+// EVERY parameter is uintptr_t and every value the emitted code passes is
+// either a Register or a VarState of kind kIntPtrKind. On a 64-bit target
+// kIntPtrKind == kI64 == 8 bytes (liftoff-assembler.h:105-106), so the VarState
+// width and the C parameter width agree by construction - including on Win64,
+// where CallC's stack-argument path stores value_kind_size(arg.kind()) bytes at
+// kSystemPointerSize stride (liftoff-assembler-x64-inl.h:5198-5227) and a
+// narrower kind would leave the parameter's high half undefined.
+//
+// Emission is therefore compiled in only when kSystemPointerSize == 8. On a
+// 32-bit target kNeedI64RegPair is true (liftoff-register.h:23), so a memory64
+// offset lives in a REGISTER PAIR and cannot be passed as one uintptr_t without
+// arch-specific pair handling. afeye is a Linux/x64 tracing build (sink.cc is
+// POSIX: fcntl.h/unistd.h), so this costs nothing real and keeps the codegen
+// free of an untestable 32-bit path.
+//
+// These are plain free functions so their addresses can be taken and passed
+// through ExternalReference::Create(Address) - the same shape the
+// FUNCTION_REFERENCE(wasm_memory_copy, wasm::memory_copy_wrapper) table entry
+// uses (external-reference.cc:427-431, 688), which liftoff already calls via
+// GenerateCCall for the bulk ops (liftoff-compiler.cc:7641-7649).
+// ---------------------------------------------------------------------------
+
+// Load hook. OR-reduces [offset, offset+size) - that is the taint of the value
+// just read - publishes it to this thread's load slot for the JS boundary seam,
+// and emits a record when it is non-zero. {mem_id} is the linear-memory base
+// (the register liftoff already holds), NOT an index.
+void WasmShadowOnLoad(uintptr_t mem_id, uintptr_t offset, uintptr_t size);
+
+// Store hook. OVERWRITES [offset, offset+size) with the tag the boundary layer
+// parked for this thread, and emits on a moved OR an erased tag.
+// {augment} != 0 ORs the tag in instead of overwriting - required for the
+// atomic read-modify-write ops (atomic.rmw / atomic.cmpxchg), whose result
+// combines the old memory value with the operand, so erasing the old tag there
+// would drop a real source. Plain stores pass 0.
+void WasmShadowOnStore(uintptr_t mem_id, uintptr_t offset, uintptr_t size,
+                       uintptr_t augment);
+
+// Bulk memory, STAGE half: records the operation into a thread-local and
+// returns WITHOUT touching the shadow. Emitted immediately BEFORE the real
+// memory.copy/fill/init runtime call.
+//
+// WHY STAGE/COMMIT AND NOT ONE CALLOUT (do not "simplify" this by moving the
+// apply before the runtime call): memory.copy/fill/init can trap out-of-bounds,
+// and Kasada-style sensors DELIBERATELY induce traps to detect a modified
+// environment. Applying the shadow first would record a taint flow that never
+// happened - a fabricated edge in the fact graph, which is worse than a missing
+// one. So the values are staged, the real operation runs, the emitted
+// out-of-bounds trap jump (liftoff-compiler.cc:7650-7653) diverts on failure,
+// and only the fall-through path reaches the COMMIT, which applies and emits.
+// An induced-trap probe therefore leaves NO wasm-shadow-copy record: that is
+// correct behaviour, not a coverage gap.
+//
+// The stage callout cannot run after the runtime call instead, because that
+// call clobbers the caller-saved registers holding the operands (popped
+// VarStates are no longer in cache_state, so SpillAllRegisters will not save
+// them) - see WasmShadowCommit for the matching half.
+void WasmShadowStageCopy(uintptr_t dst_mem_id, uintptr_t dst_off,
+                         uintptr_t src_mem_id, uintptr_t src_off,
+                         uintptr_t len);
+void WasmShadowStageFill(uintptr_t mem_id, uintptr_t dst_off, uintptr_t len);
+void WasmShadowStageInit(uintptr_t mem_id, uintptr_t dst_off, uintptr_t len);
+
+// Bulk memory, COMMIT half. Takes NO arguments - everything it needs is in the
+// staged thread-local - so it survives the runtime call's register clobbering
+// with no frame-slot or rsp assumptions (arch-generic by construction).
+// Emitted after the OOB trap jump. A staged entry left behind by a trapped op
+// is harmless: every commit is preceded by its own stage, which overwrites it.
+void WasmShadowCommit();
+
+// ---------------------------------------------------------------------------
+// Lifetime (called from WasmMemoryObject::New / ::Grow, wasm-objects.cc).
+// {mem_id} is the linear memory base pointer (buffer_start()).
+// ---------------------------------------------------------------------------
+
+// Map a shadow region for {mem_id} covering {byte_length} bytes (clamped to
+// kMaxShadowBytes). No-op if already tracked, the table is full, or the layer
+// is off. Returns true when {mem_id} is tracked afterwards.
+bool ShadowAlloc(void* mem_id, size_t byte_length);
+
+// INPLACE grow: extend the existing region to {new_byte_length}. The key is
+// unchanged, so this is a length bump - no remap, no tag copy. A shrink is
+// ignored (tags past the new end simply go unread).
+void ShadowGrow(void* mem_id, size_t new_byte_length);
+
+// COPY grow: migrate {old_mem_id}'s tags onto {new_mem_id} covering
